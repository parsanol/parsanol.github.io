## The documented edition-2 example: a Named leaf attaches to the
## non-captured `sep` reference while the captured `k` keeps its text —
## edition 2 is purely additive (v2 tree = v1 tree + Named leaves).
grammar Pair version "1.0.0" edition "v2" {
  root = k sep
  k = 1*( %x61-7A ) as k
  sep = ","
  entry main: root

  test {
    accept "abc,"
    capture "abc," { k: "abc", sep: "," }
  }
}
