## The vehicle for custom atoms: the host plugs validation semantics
## into named positions. The artifact demo carries the plain shape —
## a tag list the host would decorate.
grammar CustomAtoms version "1.0.0" edition "v2" {
  ws = %x20 / %x09
  pq = *ws
  tag = 1*( %x41-5A / %x61-7A / %x2D ) as tag
  list = pq tag *( pq tag ) pq
  top = list

  entry main: top

  test {
    accept "alpha beta"
    accept "solo"
    accept "multi-word-tag"
    reject ""
  }
}
