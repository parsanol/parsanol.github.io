## All the failure paths: the tree reporter keeps every branch's
## failure, so a rejected input shows WHERE each alternative died —
## the whole forest, not just the deepest tree.
grammar NestedErrors version "1.0.0" edition "v2" {
  ws = %x20 / %x09
  nl = %x0A
  pq = *ws
  name = 1*( %x41-5A / %x61-7A / %x5F ) as name
  value = 1*( %x30-39 / %x41-5A / %x61-7A ) as value
  setting = pq name pq "=" pq value pq nl
  section = name pq "{" nl *( setting ) pq "}" nl as section
  doc = *( section )

  entry main: doc

  test {
    accept "a {\nx=1\n}\n"
    accept "a {\nx=1\ny=2\n}\nb {\nz=3\n}\n"
    reject "a {\nx=\n}\n"
    reject "a {"
  }
}
