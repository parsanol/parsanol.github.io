 {","expect":{}}],"docs":{},"source":"## All the failure paths: the tree reporter keeps every branch's\n## failure, so a rejected input shows WHERE each alternative died —\n## the whole forest, not just the deepest tree.\ngrammar NestedErrors version \"1.0.0\" {\n  ws = %x20 / %x09\n  nl = %x0A\n  pq = *ws\n  name = 1*( %x41-5A / %x61-7A / %x5F ) as name\n  value = 1*( %x30-39 / %x41-5A / %x61-7A ) as value\n  setting = pq name pq \"=\" pq value pq nl\n  section = name pq \"{\" nl *( setting ) pq \"}\" nl as section\n  doc = *( section )\n\n  entry main: doc\n\n  test {\n    accept \"a {\\nx=1\\n}\\n\"\n    accept \"a {\\nx=1\\ny=2\\n}\\nb {\\nz=3\\n}\\n\"\n    reject \"a {\\nx=\\n}\\n\"\n    reject \"a {\"\n  }\n}\n","source_hash":"1888c94355a90885d9bde6a54c7f4757aa6abf8d8d31e1044a954b81e07b8025","unicode_tables":"onigmo (Ruby 3.4.8)","compiler_version":"1.3.111","mode":"v2","emission":2,"checksum":"sha256:ddd702ef5e80a6deda36f0ccc1cf0838b20f704810e62c3f0bd4e865f77e4ebc"}
