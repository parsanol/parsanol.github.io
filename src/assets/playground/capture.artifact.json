{"bindings":null,"version":"1.0.0","grammar":"CaptureDsl","shape":"parsanol-tree/v2","binding_version":1,"entries":{"main":{"root":"top","grammar":{"atoms":[{"Entity":{"atom":6}},{"Entity":{"atom":4}},{"Re":{"pattern":"[ ]"}},{"Re":{"pattern":"[\\x09]"}},{"Alternative":{"atoms":[2,3]}},{"Named":{"name":"ws","atom":1}},{"Repetition":{"atom":5,"min":0,"max":null,"tag":"Repetition"}},{"Entity":{"atom":21}},{"Entity":{"atom":13}},{"Re":{"pattern":"[\\x41-\\x5a]"}},{"Re":{"pattern":"[\\x61-\\x7a]"}},{"Alternative":{"atoms":[9,10]}},{"Repetition":{"atom":11,"min":1,"max":null,"tag":"Repetition"}},{"Named":{"name":"k","atom":12}},{"Entity":{"atom":6}},{"Str":{"pattern":"="}},{"Entity":{"atom":6}},{"Entity":{"atom":20}},{"Re":{"pattern":"[\\x30-\\x39]"}},{"Repetition":{"atom":18,"min":1,"max":null,"tag":"Repetition"}},{"Named":{"name":"v","atom":19}},{"Sequence":{"atoms":[8,14,15,16,17]}},{"Entity":{"atom":6}},{"Sequence":{"atoms":[0,7,22]}}],"root":23},"bindings":[]}},"preprocess":{},"tables":{},"lint":{"order_warnings":[]},"default_entry":"main","render":{},"derive":{},"tests":[{"entry":"main","kind":"accept","input":"answer=42","expect":{}},{"entry":"main","kind":"accept","input":" x = 7 ","expect":{}},{"entry":"main","kind":"reject","input":"answer=","expect":{}},{"entry":"main","kind":"reject","input":"=42","expect":{}}],"docs":{},"source":"## The capture DSL: `as` binds a name at each level, and the bound\n## hash is the parse output. One line, three bindings.\ngrammar CaptureDsl version \"1.0.0\" {\n  ws = %x20 / %x09\n  pq = *ws\n  key = 1*( %x41-5A / %x61-7A ) as k\n  value = 1*( %x30-39 ) as v\n  pair = key pq \"=\" pq value\n  top = pq pair pq\n\n  entry main: top\n\n  test {\n    accept \"answer=42\"\n    accept \" x = 7 \"\n    reject \"answer=\"\n    reject \"=42\"\n  }\n}\n","source_hash":"4aa3ed271c2cb090dc5c6244a733f691631d83fd1c8e66b0476a86a7e532bf5b","unicode_tables":"onigmo (Ruby 3.4.8)","compiler_version":"1.3.110","mode":"v2","checksum":"sha256:a796b6c