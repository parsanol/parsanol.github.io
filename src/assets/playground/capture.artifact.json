{"bindings":null,"version":"1.0.0","grammar":"CaptureDsl","shape":"parsanol-tree/v2","binding_version":1,"entries":{"main":{"root":"top","grammar":{"atoms":[{"Entity":{"atom":5}},{"Entity":{"atom":4}},{"Re":{"pattern":"[ ]"}},{"Re":{"pattern":"[\\x09]"}},{"Alternative":{"atoms":[2,3]}},{"Repetition":{"atom":1,"min":0,"max":null,"tag":"Repetition"}},{"Entity":{"atom":20}},{"Entity":{"atom":12}},{"Re":{"pattern":"[\\x41-\\x5a]"}},{"Re":{"pattern":"[\\x61-\\x7a]"}},{"Alternative":{"atoms":[8,9]}},{"Repetition":{"atom":10,"min":1,"max":null,"tag":"Repetition"}},{"Named":{"name":"k","atom":11}},{"Entity":{"atom":5}},{"Str":{"pattern":"="}},{"Entity":{"atom":5}},{"Entity":{"atom":19}},{"Re":{"pattern":"[\\x30-\\x39]"}},{"Repetition":{"atom":17,"min":1,"max":null,"tag":"Repetition"}},{"Named":{"name":"v","atom":18}},{"Sequence":{"atoms":[7,13,14,15,16]}},{"Entity":{"atom":5}},{"Sequence":{"atoms":[0,6,21]}}],"root":22},"bindings":[]}},"preprocess":{},"tables":{},"lint":{"order_warnings":[]},"default_entry":"main","render":{},"derive":{},"tests":[{"entry":"main","kind":"accept","input":"answer=42","expect":{}},{"entry":"main","kind":"accept","input":" x = 7 ","expect":{}},{"entry":"main","kind":"reject","input":"answer=","expect":{}},{"entry":"main","kind":"reject","input":"=42","expect":{}}],"docs":{},"source":"## The capture DSL: `as` binds a name at each level, and the bound\n## hash is the parse output. One line, three bindings.\ngrammar CaptureDsl version \"1.0.0\" edition \"v2\" {\n  ws = %x20 / %x09\n  pq = *ws\n  key = 1*( %x41-5A / %x61-7A ) as k\n  value = 1*( %x30-39 ) as v\n  pair = key pq \"=\" pq value\n  top = pq pair pq\n\n  entry main: top\n\n  test {\n    accept \"answer=42\"\n    accept \" x = 7 \"\n    reject \"answer=\"\n    reject \"=42\"\n  }\n}\n","source_hash":"e7e6bd9310e66f5cc7a5abc55cdfcf0fa5aa1a0ddaab13c74d40eb3c9b55903c","unicode_tables":"onigmo (Ruby 3.4.8)","compiler_version":"1.3.118","edition":2,"semantics_hash":"sha256:69ad073ff53d2125a394