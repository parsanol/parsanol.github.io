{"bindings":null,"version":"1.0.0","grammar":"Captures","shape":"parsanol-tree/v2","binding_version":1,"entries":{"main":{"root":"file","grammar":{"atoms":[{"Entity":{"atom":42}},{"Entity":{"atom":7}},{"Entity":{"atom":5}},{"Re":{"pattern":"[ ]"}},{"Re":{"pattern":"[\\x09]"}},{"Alternative":{"atoms":[3,4]}},{"Named":{"name":"ws","atom":2}},{"Repetition":{"atom":6,"min":0,"max":null,"tag":"Repetition"}},{"Str":{"pattern":"["}},{"Entity":{"atom":7}},{"Entity":{"atom":15}},{"Re":{"pattern":"(?i:INFO)"}},{"Re":{"pattern":"(?i:WARN)"}},{"Re":{"pattern":"(?i:ERROR)"}},{"Alternative":{"atoms":[11,12,13]}},{"Named":{"name":"level","atom":14}},{"Entity":{"atom":7}},{"Str":{"pattern":"]"}},{"Entity":{"atom":7}},{"Entity":{"atom":32}},{"Re":{"pattern":"[\\x41-\\x5a]"}},{"Re":{"pattern":"[\\x61-\\x7a]"}},{"Alternative":{"atoms":[20,21]}},{"Repetition":{"atom":22,"min":1,"max":null,"tag":"Repetition"}},{"Re":{"pattern":"[:]"}},{"Re":{"pattern":"[\\x41-\\x5a]"}},{"Re":{"pattern":"[\\x61-\\x7a]"}},{"Alternative":{"atoms":[25,26]}},{"Repetition":{"atom":27,"min":1,"max":null,"tag":"Repetition"}},{"Sequence":{"atoms":[24,28]}},{"Repetition":{"atom":29,"min":0,"max":null,"tag":"Repetition"}},{"Named":{"name":"module","atom":30}},{"Sequence":{"atoms":[23,31]}},{"Entity":{"atom":7}},{"Str":{"pattern":":"}},{"Entity":{"atom":7}},{"Entity":{"atom":41}},{"Re":{"pattern":"[\\x01-\\x09]"}},{"Re":{"pattern":"[\\x0b-\\u{10ffff}]"}},{"Alternative":{"atoms":[37,38]}},{"Repetition":{"atom":39,"min":0,"max":null,"tag":"Repetition"}},{"Named":{"name":"message","atom":40}},{"Sequence":{"atoms":[1,8,9,10,16,17,18,19,33,34,35,36]}},{"Entity":{"atom":44}},{"Re":{"pattern":"[\\x0a]"}},{"Named":{"name":"nl","atom":43}},{"Sequence":{"atoms":[0,45]}},{"Repetition":{"atom":46,"min":0,"max":null,"tag":"Repetition"}},{"Entity":{"atom":42}},{"Repetition":{"atom":48,"min":0,"max":1,"tag":"Maybe"}},{"Sequence":{"atoms":[47,49]}}],"root":50},"bindings":[]}},"preprocess":{},"tables":{},"lint":{"order_warnings":[]},"default_entry":"main","render":{},"derive":{},"tests":[{"entry":"main","kind":"accept","input":"[INFO] core: started","expect":{}},{"entry":"main","kind":"accept","input":"[ERROR] net:dial: timeout\n[INFO] app: retrying","expect":{}},{"entry":"main","kind":"reject","input":"INFO core: no brackets","expect":{}},{"entry":"main","kind":"reject","input":"[DEBUG] unknown level: x","expect":{}}],"docs":{},"source":"## Capture atoms: `as` names attach to any expression, like named\n## regex groups. The tree keeps what you named — the log line below\n## exposes level, module and message without any transform code.\ngrammar Captures version \"1.0.0\" edition \"v2\" {\n  ws = %x20 / %x09\n  pq = *ws\n  nl = %x0A\n  level = ( %i\"INFO\" / %i\"WARN\" / %i\"ERROR\" ) as level\n  mod = 1*( %x41-5A / %x61-7A ) *( %x3A 1*( %x41-5A / %x61-7A ) ) as module\n  rest = *( %x01-09 / %x0B-10FFFF ) as message\n  line = pq \"[\" pq level pq \"]\" pq mod pq \":\" pq rest\n  file = *( line nl ) [ line ]\n\n  entry main: file\n\n  test {\n    accept \"[INFO] core: started\"\n    accept \"[ERROR] net:dial: timeout\\n[INFO] app: retrying\"\n    reject \"INFO core: no brackets\"\n    reject \"[DEBUG] unknown level: x\"\n  }\n}\n","source_hash":"e02b927022aee06b86bae3636508d5ba37d685d903fa7631a2b9a142ffe7b2b6","unicode_tables":"onigmo (Ruby 3.4.8)","compiler_version":"1.3.112","edition":"v2","checksum":"sha256:5c2fe2ade111f374b3fddec6088d8a89c1ee851dc3ffb5fd69e6c7ed0a5da03f"}
