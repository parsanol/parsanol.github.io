main","kind":"accept","input":"[INFO] core: started","expect":{}},{"entry":"main","kind":"accept","input":"[ERROR] net:dial: timeout\n[INFO] app: retrying","expect":{}},{"entry":"main","kind":"reject","input":"INFO core: no brackets","expect":{}},{"entry":"main","kind":"reject","input":"[DEBUG] unknown level: x","expect":{}}],"docs":{},"source":"## Capture atoms: `as` names attach to any expression, like named\n## regex groups. The tree keeps what you named — the log line below\n## exposes level, module and message without any transform code.\ngrammar Captures version \"1.0.0\" edition \"v2\" {\n  ws = %x20 / %x09\n  pq = *ws\n  nl = %x0A\n  level = ( %i\"INFO\" / %i\"WARN\" / %i\"ERROR\" ) as level\n  mod = 1*( %x41-5A / %x61-7A ) *( %x3A 1*( %x41-5A / %x61-7A ) ) as module\n  rest = *( %x01-09 / %x0B-10FFFF ) as message\n  line = pq \"[\" pq level pq \"]\" pq mod pq \":\" pq rest\n  file = *( line nl ) [ line ]\n\n  entry main: file\n\n  test {\n    accept \"[INFO] core: started\"\n    accept \"[ERROR] net:dial: timeout\\n[INFO] app: retrying\"\n    reject \"INFO core: no brackets\"\n    reject \"[DEBUG] unknown level: x\"\n  }\n}\n","source_hash":"e02b927022aee06b86bae3636508d5ba37d685d903fa7631a2b9a142ffe7b2b6","unicode_tables":"onigmo (Ruby 3.4.8)","compiler_version":"1.3.114","edition":2,"checksum":"sha256:9de319f97e2ea8ef4ea6b73976f59ea29ca1b5e868762939077a2b6fa0a2e154"}
