{"bindings":null,"version":"1.0.0","grammar":"Sentence","shape":"parsanol-tree/v2","binding_version":1,"entries":{"main":{"root":"sentence","grammar":{"atoms":[{"Entity":{"atom":8}},{"Entity":{"atom":2}},{"Re":{"pattern":"[\\x41-\\x5a]"}},{"Entity":{"atom":6}},{"Re":{"pattern":"[\\x41-\\x5a]"}},{"Re":{"pattern":"[\\x61-\\x7a]"}},{"Alternative":{"atoms":[4,5]}},{"Repetition":{"atom":3,"min":0,"max":null,"tag":"Repetition"}},{"Sequence":{"atoms":[1,7]}},{"Entity":{"atom":11}},{"Re":{"pattern":"[ ]"}},{"Repetition":{"atom":10,"min":1,"max":null,"tag":"Repetition"}},{"Entity":{"atom":13}},{"Entity":{"atom":15}},{"Entity":{"atom":6}},{"Repetition":{"atom":14,"min":1,"max":null,"tag":"Repetition"}},{"Sequence":{"atoms":[9,12]}},{"Repetition":{"atom":16,"min":0,"max":null,"tag":"Repetition"}},{"Str":{"pattern":"."}},{"Sequence":{"atoms":[0,17,18]}}],"root":19},"bindings":[]}},"preprocess":{},"tables":{},"lint":{"order_warnings":[]},"default_entry":"main","render":{},"derive":{},"tests":[{"entry":"main","kind":"accept","input":"Hello world.","expect":{}},{"entry":"main","kind":"accept","input":"A.","expect":{}},{"entry":"main","kind":"accept","input":"The quick brown fox jumps.","expect":{}},{"entry":"main","kind":"reject","input":"lowercase start.","expect":{}},{"entry":"main","kind":"reject","input":"no final period","expect":{}}],"docs":{},"source":"## Sentences: capitalized words separated by spaces, ending in a\n## period. Demonstrates word repetition with whitespace threading.\ngrammar Sentence version \"1.0.0\" edition \"v1\" {\n  ws = 1*( %x20 )\n  alpha = %x41-5A / %x61-7A\n  word = 1*alpha\n  cap = %x41-5A\n  head = cap *alpha\n  tail = word\n  sentence = head *( ws tail ) \".\"\n\n  entry main: sentence\n\n  test {\n    accept \"Hello world.\"\n    accept \"A.\"\n    accept \"The quick brown fox jumps.\"\n    reject \"lowercase start.\"\n    reject \"no final period\"\n  }\n}\n","source_hash":"2d2c182b2aa535072604c24b10d033db0e4131d569d01c4034ac8d61bf91b303","uni