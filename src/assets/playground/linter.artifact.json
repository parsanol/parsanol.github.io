{"bindings":null,"version":"1.0.0","grammar":"LintConfig","shape":"parsanol-tree/v2","binding_version":1,"entries":{"main":{"root":"file","grammar":{"atoms":[{"Entity":{"atom":36}},{"Entity":{"atom":7}},{"Re":{"pattern":"[\\x41-\\x5a]"}},{"Re":{"pattern":"[\\x61-\\x7a]"}},{"Re":{"pattern":"[_]"}},{"Alternative":{"atoms":[2,3,4]}},{"Repetition":{"atom":5,"min":1,"max":null,"tag":"Repetition"}},{"Named":{"name":"rule","atom":6}},{"Entity":{"atom":14}},{"Entity":{"atom":12}},{"Re":{"pattern":"[ ]"}},{"Re":{"pattern":"[\\x09]"}},{"Alternative":{"atoms":[10,11]}},{"Named":{"name":"ws","atom":9}},{"Repetition":{"atom":13,"min":0,"max":null,"tag":"Repetition"}},{"Str":{"pattern":":"}},{"Entity":{"atom":14}},{"Entity":{"atom":22}},{"Re":{"pattern":"(?i:off)"}},{"Re":{"pattern":"(?i:warn)"}},{"Re":{"pattern":"(?i:error)"}},{"Alternative":{"atoms":[18,19,20]}},{"Named":{"name":"severity","atom":21}},{"Entity":{"atom":14}},{"Entity":{"atom":30}},{"Str":{"pattern":"#"}},{"Re":{"pattern":"[\\x01-\\x09]"}},{"Re":{"pattern":"[\\x0b-\\u{10ffff}]"}},{"Alternative":{"atoms":[26,27]}},{"Repetition":{"atom":28,"min":0,"max":null,"tag":"Repetition"}},{"Sequence":{"atoms":[25,29]}},{"Named":{"name":"comment","atom":24}},{"Repetition":{"atom":31,"min":0,"max":1,"tag":"Maybe"}},{"Entity":{"atom":34}},{"Re":{"pattern":"[\\x0a]"}},{"Named":{"name":"nl","atom":33}},{"Sequence":{"atoms":[1,8,15,16,17,23,32,35]}},{"Repetition":{"atom":0,"min":0,"max":null,"tag":"Repetition"}}],"root":37},"bindings":[]}},"preprocess":{},"tables":{},"lint":{"order_warnings":[]},"default_entry":"main","render":{},"derive":{},"tests":[{"entry":"main","kind":"accept","input":"no_unused: off\n","expect":{}},{"entry":"main","kind":"accept","input":"long_lines: warn # 100 cols\n","expect":{}},{"entry":"main","kind":"accept","input":"a: error\nb: warn\n","expect":{}},{"entry":"main","kind":"reject","input":"no_unused off\n","expect":{}},{"entry":"main","kind":"reject","input":"unknown_word: x\n","expect":{}}],"docs":{"severity":"severity is one of the three known words."},"source":"## A linter's substrate: config lines whose slices carry exact\n## positions. The grammar is deliberately simple — the point is that\n## every capture's offset/line/column ride the tree, so diagnostics\n## need no re-lexing.\ngrammar LintConfig version \"1.0.0\" {\n  nl = %x0A\n  ws = %x20 / %x09\n  pq = *ws\n  comment = \"#\" *( %x01-09 / %x0B-10FFFF )\n  name = 1*( %x41-5A / %x61-7A / %x5F ) as rule\n  ## severity is one of the three known words.\n  severity = ( %i\"off\" / %i\"warn\" / %i\"error\" ) as severity\n  setting = name pq \":\" pq severity pq [ comment ] nl\n  file = *( setting )\n\n  entry main: file\n\n  test {\n    accept \"no_unused: off\\n\"\n    accept \"long_lines: warn # 100 cols\\n\"\n    accept \"a: error\\nb: warn\\n\"\n    reject \"no_unused off\\n\"\n    reject \"unknown_word: x\\n\"\n  }\n}\n","source_hash":"7c74159480658c2a9ac739d0cd456babd6504b04e1513483973c630d6bc0b2fd","unicode_tables":"onigmo (Ruby 3.4.8)","compiler_version":"1.3.111","mode":"v2","emission":2,"checksum":"sha256:79c1e73ddff81426a700e5bd00cb072263feb5e4d4d4d037cbed4d839cb4496b"}
