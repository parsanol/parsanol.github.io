{"bindings":null,"version":"1.0.0","grammar":"LintConfig","shape":"parsanol-tree/v2","binding_version":1,"entries":{"main":{"root":"file","grammar":{"atoms":[{"Entity":{"atom":34}},{"Entity":{"atom":7}},{"Re":{"pattern":"[\\x41-\\x5a]"}},{"Re":{"pattern":"[\\x61-\\x7a]"}},{"Re":{"pattern":"[_]"}},{"Alternative":{"atoms":[2,3,4]}},{"Repetition":{"atom":5,"min":1,"max":null,"tag":"Repetition"}},{"Named":{"name":"rule","atom":6}},{"Entity":{"atom":13}},{"Entity":{"atom":12}},{"Re":{"pattern":"[ ]"}},{"Re":{"pattern":"[\\x09]"}},{"Alternative":{"atoms":[10,11]}},{"Repetition":{"atom":9,"min":0,"max":null,"tag":"Repetition"}},{"Str":{"pattern":":"}},{"Entity":{"atom":13}},{"Entity":{"atom":21}},{"Re":{"pattern":"(?i:off)"}},{"Re":{"pattern":"(?i:warn)"}},{"Re":{"pattern":"(?i:error)"}},{"Alternative":{"atoms":[17,18,19]}},{"Named":{"name":"severity","atom":20}},{"Entity":{"atom":13}},{"Entity":{"atom":29}},{"Str":{"pattern":"#"}},{"Re":{"pattern":"[\\x01-\\x09]"}},{"Re":{"pattern":"[\\x0b-\\u{10ffff}]"}},{"Alternative":{"atoms":[25,26]}},{"Repetition":{"atom":27,"min":0,"max":null,"tag":"Repetition"}},{"Sequence":{"atoms":[24,28]}},{"Named":{"name":"comment","atom":23}},{"Repetition":{"atom":30,"min":0,"max":1,"tag":"Maybe"}},{"Entity":{"atom":33}},{"Re":{"pattern":"[\\x0a]"}},{"Sequence":{"atoms":[1,8,14,15,16,22,31,32]}},{"Repetition":{"atom":0,"min":0,"max":null,"tag":"Repetition"}}],"root":35},"bindings":[]}},"preprocess":{},"tables":{},"lint":{"order_warnings":[]},"default_entry":"main","render":{},"derive":{},"tests":[{"entry":"main","kind":"accept","input":"no_unused: off\n","expect":{}},{"entry":"main","kind":"accept","input":"long_lines: warn # 100 cols\n","expect":{}},{"entry":"main","kind":"accept","input":"a: error\nb: warn\n","expect":{}},{"entry":"main","kind":"reject","input":"no_unused off\n","expect":{}},{"entry":"main","kind":"reject","input":"unknown_word: x\n","expect":{}}],"docs":{"severity":"severity is one of the three known words."},"source":"## A linter's substrate: config lines whose slices carry exact\n## positions. The grammar is deliberately simple — the point is that\n## every capture's offset/line/column ride the tree, so diagnostics\n## need no re-lexing.\ngrammar LintConfig version \"1.0.0\" edition \"v2\" {\n  nl = %x0A\n  ws = %x20 / %x09\n  pq = *ws\n  comment = \"#\" *( %x01-09 / %x0B-10FFFF )\n  name = 1*( %x41-5A / %x61-7A / %x5F ) as rule\n  ## severity is one of the three known words.\n  severity = ( %i\"off\" / %i\"warn\" / %i\"error\" ) as severity\n  setting = name pq \":\" pq severity pq [ comment ] nl\n  file = *( setting )\n\n  entry main: file\n\n  test {\n    accept \"no_unused: off\\n\"\n    accept \"long_lines: warn # 100 cols\\n\"\n    accept \"a: error\\nb: warn\\n\"\n    reject \"no_unused off\\n\"\n    reject \"unknown_word: x\\n\"\n  }\n}\n","source_hash":"4cee258b4c5f5dce96893320670fa685b34f71c397f5a603a2064fcf6e4c2f8a","unicode_tables":"onigmo (Ruby 3.4.8)","compiler_version":"1.3.114","edition":2,"checksum":"sha256:370293a500c60f86f6e168dc272a2da51786afc8c74a5fed1634e3685b17fec0"}
