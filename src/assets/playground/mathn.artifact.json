{"bindings":null,"version":"1.0.0","grammar":"Mathn","shape":"parsanol-tree/v2","binding_version":1,"entries":{"main":{"root":"top","grammar":{"atoms":[{"Entity":{"atom":5}},{"Entity":{"atom":4}},{"Re":{"pattern":"[ ]"}},{"Re":{"pattern":"[\\x09]"}},{"Alternative":{"atoms":[2,3]}},{"Repetition":{"atom":1,"min":0,"max":null,"tag":"Repetition"}},{"Entity":{"atom":42}},{"Entity":{"atom":41}},{"Entity":{"atom":40}},{"Entity":{"atom":13}},{"Entity":{"atom":11}},{"Re":{"pattern":"[\\x30-\\x39]"}},{"Repetition":{"atom":10,"min":1,"max":null,"tag":"Repetition"}},{"Named":{"name":"number","atom":12}},{"Str":{"pattern":"("}},{"Entity":{"atom":5}},{"Entity":{"atom":38}},{"Entity":{"atom":5}},{"Str":{"pattern":"+"}},{"Str":{"pattern":"-"}},{"Alternative":{"atoms":[18,19]}},{"Entity":{"atom":5}},{"Entity":{"atom":35}},{"Entity":{"atom":5}},{"Str":{"pattern":"*"}},{"Str":{"pattern":"/"}},{"Alternative":{"atoms":[24,25]}},{"Entity":{"atom":5}},{"Entity":{"atom":32}},{"Entity":{"atom":5}},{"Str":{"pattern":")"}},{"Sequence":{"atoms":[14,15,16,29,30]}},{"Alternative":{"atoms":[9,31]}},{"Sequence":{"atoms":[23,26,27,28]}},{"Repetition":{"atom":33,"min":0,"max":null,"tag":"Repetition"}},{"Sequence":{"atoms":[8,34]}},{"Sequence":{"atoms":[17,20,21,22]}},{"Repetition":{"atom":36,"min":0,"max":null,"tag":"Repetition"}},{"Sequence":{"atoms":[7,37]}},{"Sequence":{"atoms":[14,15,16,29,30]}},{"Alternative":{"atoms":[9,39]}},{"Sequence":{"atoms":[8,34]}},{"Sequence":{"atoms":[7,37]}},{"Entity":{"atom":5}},{"Sequence":{"atoms":[0,6,43]}}],"root":44},"bindings":[]}},"preprocess":{},"tables":{},"lint":{"order_warnings":[]},"default_entry":"main","render":{},"derive":{},"tests":[{"entry":"main","kind":"accept","input":"1 / 2","expect":{}},{"entry":"main","kind":"accept","input":"(1 + 2) / 3","expect":{}},{"entry":"main","kind":"accept","input":"4 * 2 - 1","expect":{}},{"entry":"main","kind":"reject","input":"/ 2","expect":{}},{"entry":"main","kind":"reject","input":"(1 + 2","expect":{}}],"docs":{},"source":"## Rational-friendly arithmetic: integer division that stays exact and\n## the operator soup around it. The tree keeps the operator captures\n## so the evaluator can pick per-operator semantics.\ngrammar Mathn version \"1.0.0\" edition \"v2\" {\n  ws = %x20 / %x09\n  pq = *ws\n  digit = %x30-39\n  number = 1*digit as number\n  primary = number / ( \"(\" pq expr pq \")\" )\n  term = primary *( pq ( \"*\" / \"/\" ) pq primary )\n  expr = term *( pq ( \"+\" / \"-\" ) pq term )\n  top = pq expr pq\n\n  entry main: top\n\n  test {\n    accept \"1 / 2\"\n    accept \"(1 + 2) / 3\"\n    accept \"4 * 2 - 1\"\n    reject \"/ 2\"\n    reject \"(1 + 2\"\n  }\n}\n","source_hash":"ce65158b7a29f841be1d0bbbe2e8f7eee48be9221c5a3a34f4913f25bc25d67f","unicode_tables":"onigmo (Ruby 3.4.8)","compiler_version":"1.3.118","edition":2,"semantics_hash":"sha256:cc844105cc207f089bb7bee7b2f30854fa31efd07f7c02cf61daa44ad52201fd","checksum":"sha256:597a2b42ed9377b2734dfe9f6c99ccf37d6ed04973def5c1a59610dab8b04a5f"}
