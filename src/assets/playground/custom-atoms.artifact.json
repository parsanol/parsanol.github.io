{"bindings":null,"version":"1.0.0","grammar":"CustomAtoms","shape":"parsanol-tree/v2","binding_version":1,"entries":{"main":{"root":"top","grammar":{"atoms":[{"Entity":{"atom":20}},{"Entity":{"atom":7}},{"Entity":{"atom":5}},{"Re":{"pattern":"[ ]"}},{"Re":{"pattern":"[\\x09]"}},{"Alternative":{"atoms":[3,4]}},{"Named":{"name":"ws","atom":2}},{"Repetition":{"atom":6,"min":0,"max":null,"tag":"Repetition"}},{"Entity":{"atom":14}},{"Re":{"pattern":"[\\x41-\\x5a]"}},{"Re":{"pattern":"[\\x61-\\x7a]"}},{"Re":{"pattern":"[\\-]"}},{"Alternative":{"atoms":[9,10,11]}},{"Repetition":{"atom":12,"min":1,"max":null,"tag":"Repetition"}},{"Named":{"name":"tag","atom":13}},{"Entity":{"atom":7}},{"Entity":{"atom":14}},{"Sequence":{"atoms":[15,16]}},{"Repetition":{"atom":17,"min":0,"max":null,"tag":"Repetition"}},{"Entity":{"atom":7}},{"Sequence":{"atoms":[1,8,18,19]}}],"root":0},"bindings":[]}},"preprocess":{},"tables":{},"lint":{"order_warnings":[]},"default_entry":"main","render":{},"derive":{},"tests":[{"entry":"main","kind":"accept","input":"alpha beta","expect":{}},{"entry":"main","kind":"accept","input":"solo","expect":{}},{"entry":"main","kind":"accept","input":"multi-word-tag","expect":{}},{"entry":"main","kind":"reject","input":"","expect":{}}],"docs":{},"source":"## The vehicle for custom atoms: the host plugs validation semantics\n## into named positions. The artifact demo carries the plain shape —\n## a tag list the host would decorate.\ngrammar CustomAtoms version \"1.0.0\" edition \"v2\" {\n  ws = %x20 / %x09\n  pq = *ws\n  tag = 1*( %x41-5A / %x61-7A / %x2D ) as tag\n  list = pq tag *( pq tag ) pq\n  top = list\n\n  entry main: top\n\n  test {\n    accept \"alpha beta\"\n    accept \"solo\"\n    accept \"multi-word-tag\"\n    reject \"\"\n  }\n}\n","source_hash":"cb564b84cf5173518ea11de9c8bc5ee0c63b82cd61fba914d188f56d5fc0c9c0","unicode_tables":"onigmo (Ruby 3.4.8)","compiler_version":"1.3.112","edition":"v2","checksum":"sha256:ccb33c7efbb69343fc87eef8eb7f555115806cfc4f