{"bindings":null,"version":"1.0.0","grammar":"PrecCalc","shape":"parsanol-tree/v2","binding_version":1,"entries":{"main":{"root":"top","grammar":{"atoms":[{"Entity":{"atom":5}},{"Entity":{"atom":4}},{"Re":{"pattern":"[ ]"}},{"Re":{"pattern":"[\\x09]"}},{"Alternative":{"atoms":[2,3]}},{"Repetition":{"atom":1,"min":0,"max":null,"tag":"Repetition"}},{"Entity":{"atom":50}},{"Entity":{"atom":49}},{"Entity":{"atom":48}},{"Entity":{"atom":13}},{"Entity":{"atom":11}},{"Re":{"pattern":"[\\x30-\\x39]"}},{"Repetition":{"atom":10,"min":1,"max":null,"tag":"Repetition"}},{"Named":{"name":"number","atom":12}},{"Str":{"pattern":"-"}},{"Entity":{"atom":45}},{"Sequence":{"atoms":[14,15]}},{"Named":{"name":"negated","atom":16}},{"Str":{"pattern":"("}},{"Entity":{"atom":5}},{"Entity":{"atom":43}},{"Entity":{"atom":5}},{"Str":{"pattern":"+"}},{"Str":{"pattern":"-"}},{"Alternative":{"atoms":[22,23]}},{"Entity":{"atom":5}},{"Entity":{"atom":40}},{"Entity":{"atom":5}},{"Str":{"pattern":"*"}},{"Str":{"pattern":"/"}},{"Str":{"pattern":"%"}},{"Alternative":{"atoms":[28,29,30]}},{"Entity":{"atom":5}},{"Entity":{"atom":37}},{"Entity":{"atom":5}},{"Str":{"pattern":")"}},{"Sequence":{"atoms":[18,19,20,34,35]}},{"Alternative":{"atoms":[9,17,36]}},{"Sequence":{"atoms":[27,31,32,33]}},{"Repetition":{"atom":38,"min":0,"max":null,"tag":"Repetition"}},{"Sequence":{"atoms":[8,39]}},{"Sequence":{"atoms":[21,24,25,26]}},{"Repetition":{"atom":41,"min":0,"max":null,"tag":"Repetition"}},{"Sequence":{"atoms":[7,42]}},{"Sequence":{"atoms":[18,19,20,34,35]}},{"Alternative":{"atoms":[9,17,44]}},{"Sequence":{"atoms":[14,15]}},{"Named":{"name":"negated","atom":46}},{"Alternative":{"atoms":[9,47,44]}},{"Sequence":{"atoms":[8,39]}},{"Sequence":{"atoms":[7,42]}},{"Entity":{"atom":5}},{"Sequence":{"atoms":[0,6,51]}}],"root":52},"bindings":[]}},"preprocess":{},"tables":{},"lint":{"order_warnings":[]},"default_entry":"main","render":{},"derive":{},"tests":[{"entry":"main","kind":"accept","input":"1 + 2 * 3","expect":{}},{"entry":"main","kind":"accept","input":"10 % 3 + 1","expect":{}},{"entry":"main","kind":"accept","input":"-(1 + 2) * 4","expect":{}},{"entry":"main","kind":"accept","input":"-5 % 2","expect":{}},{"entry":"main","kind":"accept","input":"2","expect":{}},{"entry":"main","kind":"reject","input":"+ 1","expect":{}},{"entry":"main","kind":"reject","input":"(1 + 2","expect":{}},{"entry":"main","kind":"reject","input":"(1 2)","expect":{}}],"docs":{},"source":"## Precedence, as a shape: additive over multiplicative over unary\n## minus. Each layer's repetition consumes its operator between\n## operands, so precedence falls out of the layering — no tables, no\n## rewriting. (This is the companion to expression-evaluator with the\n## modulo operator and signed primaries added.)\ngrammar PrecCalc version \"1.0.0\" edition \"v2\" {\n  ws = %x20 / %x09\n  pq = *ws\n  digit = %x30-39\n  number = 1*digit as number\n  primary = number / ( \"-\" primary ) as negated / ( \"(\" pq expr pq \")\" )\n  term = primary *( pq ( \"*\" / \"/\" / \"%\" ) pq primary )\n  expr = term *( pq ( \"+\" / \"-\" ) pq term )\n  top = pq expr pq\n\n  entry main: top\n\n  test {\n    accept \"1 + 2 * 3\"\n    accept \"10 % 3 + 1\"\n    accept \"-(1 + 2) * 4\"\n    accept \"-5 % 2\"\n    accept \"2\"\n    reject \"+ 1\"\n    reject \"(1 + 2\"\n    reject \"(1 2)\"\n  }\n}\n","source_hash":"c4645449c6c28c7e41c9257505afe986ef3ebad60cd54c12295fed3d0d3a7be1","unicode_tables":"onigmo (Ruby 3.4.8)","compiler_version":"1.3.136","edition":2,"semantics_hash":"sha256:66f5c101173b50210e2c67c729bba020dd3efc9a2f3917fbc6eddf3d55e2946a","checksum":"sha256:e43945ebb2243ce91f381586136748b7c0a43322827a6db52811b3b2137efc2f","validated":{"lint_errors":0,"lint_warnings":0,"tests_total":8,"tests_failures":0,"self_test":true},"byte_checksum":"sha256:3a83fd6a93944c2c187ac698def4a1d9124f77d9428ae252e6df38b412ffb9f9"}
