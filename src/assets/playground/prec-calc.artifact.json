{"bindings":null,"version":"1.0.0","grammar":"PrecCalc","shape":"parsanol-tree/v2","binding_version":1,"entries":{"main":{"root":"top","grammar":{"atoms":[{"Entity":{"atom":5}},{"Entity":{"atom":4}},{"Re":{"pattern":"[ ]"}},{"Re":{"pattern":"[\\x09]"}},{"Alternative":{"atoms":[2,3]}},{"Repetition":{"atom":1,"min":0,"max":null,"tag":"Repetition"}},{"Entity":{"atom":50}},{"Entity":{"atom":49}},{"Entity":{"atom":48}},{"Entity":{"atom":13}},{"Entity":{"atom":11}},{"Re":{"pattern":"[\\x30-\\x39]"}},{"Repetition":{"atom":10,"min":1,"max":null,"tag":"Repetition"}},{"Named":{"name":"number","atom":12}},{"Str":{"pattern":"-"}},{"Entity":{"atom":45}},{"Sequence":{"atoms":[14,15]}},{"Named":{"name":"negated","atom":16}},{"Str":{"pattern":"("}},{"Entity":{"atom":5}},{"Entity":{"atom":43}},{"Entity":{"atom":5}},{"Str":{"pattern":"+"}},{"Str":{"pattern":"-"}},{"Alternative":{"atoms":[22,23]}},{"Entity":{"atom":5}},{"Entity":{"atom":40}},{"Entity":{"atom":5}},{"Str":{"pattern":"*"}},{"Str":{"pattern":"/"}},{"Str":{"pattern":"%"}},{"Alternative":{"atoms":[28,29,30]}},{"Entity":{"atom":5}},{"Entity":{"atom":37}},{"Entity":{"atom":5}},{"Str":{"pattern":")"}},{"Sequence":{"atoms":[18,19,20,34,35]}},{"Alternative":{"atoms":[9,17,36]}},{"Sequence":{"atoms":[27,31,32,33]}},{"Repetition":{"atom":38,"min":0,"max":null,"tag":"Repetition"}},{"Sequence":{"atoms":[8,39]}},{"Sequence":{"atoms":[21,24,25,26]}},{"Repetition":{"atom":41,"min":0,"max":null,"tag":"Repetition"}},{"Sequence":{"atoms":[7,42]}},{"Sequence":{"atoms":[18,19,20,34,35]}},{"Alternative":{"atoms":[9,17,44]}},{"Sequence":{"atoms":[14,15]}},{"Named":{"name":"negated","atom":46}},{"Alternative":{"atoms":[9,47,44]}},{"Sequence":{"atoms":[8,39]}},{"Sequence":{"atoms":[7,42]}},{"Entity":{"atom":5}},{"Sequence":{"atoms":[0,6,51]}}],"root":52},"bindings":[]}},"preprocess":{},"tables":{},"lint":{"order_warnings":[]},"default_entry":"main","render":{},"derive":{},"tests":[{"entry":"main","kind":"accept","input":"1 + 2 * 3","expect":{}},{"entry":"main","kind":"accept","input":"10 % 3 + 1","expect":{}},{"entry":"main","kind":"accept","input":"-(1 + 2) * 4","expect":{}},{"entry":"main","kind":"accept","input":"-5 % 2","expect":{}},{"entry":"main","kind":"accept","input":"2","expect":{}},{"entry":"main","kind":"reject","input":"+ 1","expect":{}},{"entry":"main","kind":"reject","input":"(1 + 2","expect":{}},{"entry":"main","kind":"reject","input":"(1 2)","expect":{}}],"docs":{},"source":"## Precedence, as a shape: additive over multiplicative over unary\n## minus. Each layer's repetition consumes its operator between\n## operands, so precedence falls out of the layering — no tables, no\n## rewriting. (This is the companion to expression-evaluator with the\n## modulo operator and signed primaries added.)\ngrammar PrecCalc version \"1.0.0\" {\n  ws = %x20 / %x09\n  pq = *ws\n  digit = %x30-39\n  number = 1*digit as number\n  primary = number / ( \"-\" primary ) as negated / ( \"(\" pq expr pq \")\" )\n  term = primary *( pq ( \"*\" / \"/\" / \"%\" ) pq primary )\n  expr = term *( pq ( \"+\" / \"-\" ) pq term )\n  top = pq expr pq\n\n  entry main: top\n\n  test {\n    accept \"1 + 2 * 3\"\n    accept \"10 % 3 + 1\"\n    accept \"-(1 + 2) * 4\"\n    accept \"-5 % 2\"\n    accept \"2\"\n    reject \"+ 1\"\n    reject \"(1 + 2\"\n    reject \"(1 2)\"\n  }\n}\n","source_hash":"edd97e321a3569b97a4fefd5381c93212dd2b05d1d199411955d049be5b2f8cf","compiler_version":"1.3.109","checksum":"sha256:5caa2aa600443820eca65736dcce62b66b72f9429e8a43b8965cc161237d7c8d"}
