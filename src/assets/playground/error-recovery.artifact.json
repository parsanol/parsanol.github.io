{"bindings":null,"version":"1.0.0","grammar":"RecoveryDemo","shape":"parsanol-tree/v2","binding_version":1,"entries":{"main":{"root":"document","grammar":{"atoms":[{"Entity":{"atom":11}},{"Re":{"pattern":"[\\x61-\\x7a]"}},{"Re":{"pattern":"[\\x30-\\x39]"}},{"Alternative":{"atoms":[1,2]}},{"Repetition":{"atom":3,"min":1,"max":null,"tag":"Repetition"}},{"Named":{"name":"k","atom":4}},{"Str":{"pattern":"="}},{"Re":{"pattern":"[\\x30-\\x39]"}},{"Repetition":{"atom":7,"min":1,"max":null,"tag":"Repetition"}},{"Named":{"name":"v","atom":8}},{"Str":{"pattern":";"}},{"Sequence":{"atoms":[5,6,9,10]}},{"Entity":{"atom":18}},{"Entity":{"atom":16}},{"Re":{"pattern":"[ ]"}},{"Re":{"pattern":"[\\x09]"}},{"Alternative":{"atoms":[14,15]}},{"Named":{"name":"ws","atom":13}},{"Repetition":{"atom":17,"min":0,"max":null,"tag":"Repetition"}},{"Sequence":{"atoms":[0,12]}},{"Repetition":{"atom":19,"min":0,"max":null,"tag":"Repetition"}}],"root":20},"bindings":[],"resync":{"atoms":[{"Re":{"pattern":"[\\x00-\\x3a]"}},{"Re":{"pattern":"[\\x3c-\\u{10ffff}]"}},{"Alternative":{"atoms":[0,1]}},{"Repetition":{"atom":2,"min":0,"max":null,"tag":"Repetition"}},{"Str":{"pattern":";"}},{"Sequence":{"atoms":[3,4]}}],"root":5}}},"preprocess":{},"tables":{},"lint":{"order_warnings":[]},"default_entry":"main","render":{},"derive":{},"tests":[{"entry":"main","kind":"accept","input":"a=1;b=2;","expect":{}},{"entry":"main","kind":"accept","input":"a=1;","expect":{}},{"entry":"main","kind":"reject","input":"a=1","expect":{}},{"entry":"main","kind":"reject","input":"=;","expect":{}}],"docs":{},"source":"## Error recovery: key = value; pairs where corrupted lines become\n## resync junk. The `resync` declaration owns the skip — the parser\n## replays it deterministically instead of trial-scanning, so the\n## spans of every discarded byte are exact.\ngrammar RecoveryDemo version \"1.0.0\" {\n  ws = %x20 / %x09\n  pq = *ws\n  nl = %x0A\n  pair = ( 1*( %x61-7A / %x30-39 ) ) as k \"=\" ( 1*( %x30-39 ) ) as v \";\"\n  document = *( pair pq )\n  ## deterministic junk: any run of non-\";\" bytes ending at a \";\".\n  resync document = *( %x00-3A / %x3C-10FFFF ) \";\"\n\n  entry main: document\n\n  test {\n    accept \"a=1;b=2;\"\n    accept \"a=1;\"\n    reject \"a=1\"\n    reject \"=;\"\n  }\n}\n","source_hash":"3ea1c72767b0a030c1e18499bca9d3b974f35aa9a3276e40d2bbd56fd9c735e8","unicode_tables":"onigmo (Ruby 3.4.8)","compiler_version":"1.3.111","mode":"v2","emission":2,"checksum":"sha256:44d191d44c9f62dc821feadc03066165c234e1c9842f2cfe4401c8ff4f5b807e"}
