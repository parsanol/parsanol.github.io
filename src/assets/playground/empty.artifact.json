{"bindings":null,"version":"1.0.0","grammar":"EmptyStub","shape":"parsanol-tree/v2","binding_version":1,"entries":{"main":{"root":"top","grammar":{"atoms":[{"Entity":{"atom":3}},{"Entity":{"atom":2}},{"Re":{"pattern":"[ ]"}},{"Repetition":{"atom":1,"min":0,"max":null,"tag":"Repetition"}},{"Entity":{"atom":6}},{"Str":{"pattern":""}},{"Named":{"name":"marker","atom":5}},{"Entity":{"atom":3}},{"Sequence":{"atoms":[0,4,7]}}],"root":8},"bindings":[]}},"preprocess":{},"tables":{},"lint":{"order_warnings":[]},"default_entry":"main","render":{},"derive":{},"tests":[{"entry":"main","kind":"accept","input":"","expect":{}},{"entry":"main","kind":"accept","input":"   ","expect":{}}],"docs":{},"source":"## The empty-rule stub: a zero-width match is not expressible bare —\n## the compiler says so — but a CAPTURED empty literal is the marker:\n## `\"\" as name` parses nothing and binds the empty string. That is the\n## prototyping stub: a rule that compiles, matches, and awaits a body.\ngrammar EmptyStub version \"1.0.0\" edition \"v2\" {\n  ws = %x20\n  pq = *ws\n  stub = \"\" as marker\n  top = pq stub pq\n\n  entry main: top\n\n  test {\n    accept \"\"\n    accept \"   \"\n  }\n}\n","source_hash":"5e1f85cdbb4a094e4fcd98ce56d4a117d96176bdc2afb0c9252fc9fdc8b80849","unicode_tables":"onigmo (Ruby 3.4.8)","compiler_version":"1.3.134","edition":2,"semantics_hash":"sha256:2f4eec003cd1374cee5ae18f1342dadb8b59816e2918d8d39758ef3a88098589","checksum":"sha256:b8139e7af1c33cdcb1db5cc64f94319a364899a0464027e0d6ca848c8c036259","validated":{"lint_errors":0,"lint_warnings":0,"tests_total":2,"tests_failures":0,"self_test":true},"byte_checksum":"sha256:45921ed58c96d37b734edd406fee6819ea11f475c324c661b185e175ab65f422"}
