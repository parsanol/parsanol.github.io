ull,"tag":"Repetition"}},{"Sequence":{"atoms":[8,58]}},{"Sequence":{"atoms":[34,35,36,48,49]}},{"Alternative":{"atoms":[26,27,60]}},{"Sequence":{"atoms":[14,15,16]}},{"Alternative":{"atoms":[62,52]}},{"Sequence":{"atoms":[9,55]}},{"Sequence":{"atoms":[8,58]}},{"Entity":{"atom":6}},{"Sequence":{"atoms":[0,7,66]}}],"root":67},"bindings":[]}},"preprocess":{},"tables":{},"lint":{"order_warnings":["rule primary: branches 1 and 2 are order-dependent (shared first bytes; ordered choice is decisive)","rule not: branches 1 and 2 are order-dependent (shared first bytes; ordered choice is decisive)"]},"default_entry":"main","render":{},"derive":{},"tests":[{"entry":"main","kind":"accept","input":"a AND b","expect":{}},{"entry":"main","kind":"accept","input":"a OR NOT b","expect":{}},{"entry":"main","kind":"accept","input":"!(a AND b) OR TRUE","expect":{}},{"entry":"main","kind":"accept","input":"x1 AND x2 AND (x3 OR x4)","expect":{}},{"entry":"main","kind":"reject","input":"AND a","expect":{}},{"entry":"main","kind":"reject","input":"(a AND","expect":{}},{"entry":"main","kind":"reject","input":"a AND)","expect":{}}],"docs":{},"source":"## Boolean expressions: OR is the top layer, AND beneath it, NOT binds\n## tightest. Keywords are case-insensitive; variables are alphanumerics.\ngrammar Boolean version \"1.0.0\" edition \"v2\" {\n  ws = 1*( %x20 / %x09 )\n  pq = *ws\n  alpha = %x41-5A / %x61-7A\n  name = 1*( alpha / %x30-39 / %x5F ) as variable\n  primary = ( %x54 / %x46 ) 1*( alpha ) as literal / name / ( \"(\" pq or pq \")\" )\n  not = ( ( %x21 ) / %i\"NOT\" pq ) pq primary / pq primary\n  and = not *( pq ( %i\"AND\" ) pq not )\n  or = and *( pq ( %i\"OR\" ) pq and )\n  top = pq or pq\n\n  entry main: top\n\n  test {\n    accept \"a AND b\"\n    accept \"a OR NOT b\"\n    accept \"!(a AND b) OR TRUE\"\n    accept \"x1 AND x2 AND (x3 OR x4)\"\n    reject \"AND a\"\n    reject \"(a AND\"\n    reject \"a AND)\"\n  }\n}\n","source_hash":"f581fb07df5072cd301407a2f9bb1d943388d01c5