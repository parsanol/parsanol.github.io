\" mm \"-\" dd as date\n  tsep = %x54 / %x20\n  offset = ( %x5A / ( %x2B / %x2D ) two \":\" two )\n  time = hh \":\" ms [ \":\" ms [ \".\" 1*d ] ] [ offset ] as time\n  moment = date [ tsep time ]\n\n  entry main: moment\n\n  test {\n    accept \"2026-10-27\"\n    accept \"2026-10-27T13:45:00\"\n    accept \"2026-10-27 13:45:00.250+02:00\"\n    accept \"2026-01-01T00:00:00Z\"\n    reject \"2026-10-27T\"\n    reject \"26-10-27\"\n    reject \"2026-13-40\"\n  }\n}\n","source_hash":"8b48facaacddc99d7a7e3ca5181c9d72429cd0e5258ec4fb889ec802d13e62ea","unicode_tables":"onigmo (Ruby 3.4.8)","compiler_version":"1.3.130","edition":2,"semantics_hash":"sha256:61b63b08fe6e373bb4329c434d6e72b66fc80517f00c66a623b482cb16ca1058","checksum":"sha256:84b0d41667237e5b1ded92c98b2d19f9fd946e6e00fa5a3045de3b61c2697aed"}
