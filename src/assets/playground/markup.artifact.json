:{"name":"nl","atom":51}},{"Sequence":{"atoms":[1,8,50,53]}},{"Repetition":{"atom":0,"min":0,"max":null,"tag":"Repetition"}}],"root":55},"bindings":[]}},"preprocess":{},"tables":{},"lint":{"order_warnings":["rule tchar: branches 1 and 4 are order-dependent (first set not statically known)","rule tchar: branches 2 and 4 are order-dependent (first set not statically known)","rule tchar: branches 3 and 4 are order-dependent (first set not statically known)"]},"default_entry":"main","render":{},"derive":{},"tests":[{"entry":"main","kind":"accept","input":"plain text\n","expect":{}},{"entry":"main","kind":"accept","input":"this is **bold** and *italic* and `code`\n","expect":{}},{"entry":"main","kind":"accept","input":"**a *nested-looking* b**\n","expect":{}},{"entry":"main","kind":"accept","input":"no markup here\n","expect":{}}],"docs":{"tchar":"printable minus the three delimiters, per position."},"source":"## Inline markup: bold, italic and code inside plain text. The\n## alternation orders the longer delimiters first (** before *), and\n## code's body excludes backticks — so the spans split deterministically.\ngrammar Markup version \"1.0.0\" {\n  nl = %x0A\n  ## printable minus the three delimiters, per position.\n  tchar = %x01-09 / %x0B-2A / %x2C-5E / %x60-10FFFF\n  plain = *tchar\n  bold = \"**\" 1*( %x01-09 / %x0B-29 / %x2B-5E / %x60-10FFFF ) \"**\" as bold\n  italic = \"*\" 1*( %x01-09 / %x0B-29 / %x2B-5E / %x60-10FFFF ) \"*\" as italic\n  code = \"`\" 1*( %x01-09 / %x0B-5F / %x61-10FFFF ) \"`\" as code\n  inline = *( bold / italic / code / tchar )\n  ws = %x20 / %x09\n  pq = *ws\n  line = pq inline pq nl\n  doc = *( line )\n\n  entry main: doc\n\n  test {\n    accept \"plain text\\n\"\n    accept \"this is **bold** and *italic* and `code`\\n\"\n    accept \"**a *nested-looking* b**\\n\"\n    accept \"no markup here\\n\"\n  }\n}\n","source_hash":"7f9990fbf751ab8c6cd75ad0c0724f53e0c36a01d459ccc0cd1c8d04a935beb9","unicode_tables":"onigmo (Ruby 3.4.8)","compiler_version":"1.3.111","mode":"v2","emission":2,"checksum":"sha256:5f731fbfcbe9c1d9a0cd730b2f535e3b2adf01d7dc3a81f25ec8d0af2a17b4fd"}
