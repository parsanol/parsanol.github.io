{"bindings":null,"version":"1.0.0","grammar":"Iso6709","shape":"parsanol-tree/v2","binding_version":1,"entries":{"main":{"root":"point","grammar":{"atoms":[{"Entity":{"atom":12}},{"Entity":{"atom":4}},{"Re":{"pattern":"[+]"}},{"Re":{"pattern":"[\\-]"}},{"Alternative":{"atoms":[2,3]}},{"Entity":{"atom":6}},{"Re":{"pattern":"[\\x30-\\x39]"}},{"Repetition":{"atom":5,"min":2,"max":2,"tag":"Repetition"}},{"Str":{"pattern":"."}},{"Entity":{"atom":6}},{"Repetition":{"atom":9,"min":1,"max":4,"tag":"Repetition"}},{"Named":{"name":"latitude","atom":10}},{"Sequence":{"atoms":[1,7,8,11]}},{"Entity":{"atom":21}},{"Entity":{"atom":4}},{"Entity":{"atom":6}},{"Repetition":{"atom":15,"min":3,"max":3,"tag":"Repetition"}},{"Str":{"pattern":"."}},{"Entity":{"atom":6}},{"Repetition":{"atom":18,"min":1,"max":4,"tag":"Repetition"}},{"Named":{"name":"longitude","atom":19}},{"Sequence":{"atoms":[14,16,17,20]}},{"Entity":{"atom":30}},{"Entity":{"atom":4}},{"Entity":{"atom":6}},{"Repetition":{"atom":24,"min":1,"max":5,"tag":"Repetition"}},{"Str":{"pattern":"."}},{"Entity":{"atom":6}},{"Repetition":{"atom":27,"min":1,"max":2,"tag":"Repetition"}},{"Named":{"name":"height","atom":28}},{"Sequence":{"atoms":[23,25,26,29]}},{"Repetition":{"atom":22,"min":0,"max":1,"tag":"Maybe"}},{"Entity":{"atom":37}},{"Str":{"pattern":"/"}},{"Re":{"pattern":"[W]"}},{"Entity":{"atom":6}},{"Repetition":{"atom":35,"min":1,"max":3,"tag":"Repetition"}},{"Sequence":{"atoms":[33,34,36]}},{"Repetition":{"atom":32,"min":0,"max":1,"tag":"Maybe"}},{"Str":{"pattern":"/"}},{"Repetition":{"atom":39,"min":0,"max":1,"tag":"Maybe"}},{"Sequence":{"atoms":[0,13,31,38,40]}}],"root":41},"bindings":[]}},"preprocess":{},"tables":{},"lint":{"order_warnings":[]},"default_entry":"main","render":{},"derive":{},"tests":[{"entry":"main","kind":"accept","input":"+40.1234-075.5678","expect":{}},{"entry":"main","kind":"accept","input":"+27.4716-070.1234/","expect":{}},{"entry":"main","kind":"accept","input":"-33.8688+151.2093+000.00/","expect":{}},{"entry":"main","kind":"reject","input":"40.1234-075.5678","expect":{}},{"entry":"main","kind":"reject","input":"+401234-075.5678","expect":{}}],"docs":{"lat":"±DD.DDDD — degrees latitude.","lon":"±DDD.DDDD — degrees longitude.","crs":"/Wnnn — the world-geodetic code suffix."},"source":"## ISO 6709 coordinates, the decimal-degree profile: a latitude\n## (±DD.DDDD) and longitude (±DDD.DDDD), optional altitude and the\n## terminating slash. Demonstrates fixed-count repetition and signed\n## fields.\ngrammar Iso6709 version \"1.0.0\" edition \"v1\" {\n  sign = %x2B / %x2D\n  digit = %x30-39\n  ## ±DD.DDDD — degrees latitude.\n  lat = sign 2digit \".\" 1*4digit as latitude\n  ## ±DDD.DDDD — degrees longitude.\n  lon = sign 3digit \".\" 1*4digit as longitude\n  altitude = sign 1*5digit \".\" 1*2digit as height\n  ## /Wnnn — the world-geodetic code suffix.\n  crs = \"/\" %x57 1*3digit\n  point = lat lon [ altitude ] [ crs ] [ \"/\" ]\n\n  entry main: point\n\n  test {\n    accept \"+40.1234-075.5678\"\n    accept \"+27.4716-070.1234/\"\n    accept \"-33.8688+151.2093+000.00/\"\n    reject \"40.1234-075.5678\"\n    reject \"+401234-075.5678\"\n  }\n}\n","source_hash":"256cd6e52fb5956b86e2f356d758a9e8c1a2c1db0b1eda123a2669f6bbc69210","unicode_tables":"onigmo (Ruby 3.4.8)","compiler_version":"1.3.118","edition":1,"semantics_hash":"sha256:80ba06d3a1ba3c6f6114ae52de11b339c22847e6489ee84ede67f6f7d50240ed","checksum":"sha256:687d3c8cd8873a24bd2748c637ab1ec19a5746e883b5adb24c0d637a50ac7f57"}
