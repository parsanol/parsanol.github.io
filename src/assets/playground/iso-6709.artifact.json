:"main","kind":"accept","input":"+27.4716-070.1234/","expect":{}},{"entry":"main","kind":"accept","input":"-33.8688+151.2093+000.00/","expect":{}},{"entry":"main","kind":"reject","input":"40.1234-075.5678","expect":{}},{"entry":"main","kind":"reject","input":"+401234-075.5678","expect":{}}],"docs":{"lat":"±DD.DDDD — degrees latitude.","lon":"±DDD.DDDD — degrees longitude.","crs":"/Wnnn — the world-geodetic code suffix."},"source":"## ISO 6709 coordinates, the decimal-degree profile: a latitude\n## (±DD.DDDD) and longitude (±DDD.DDDD), optional altitude and the\n## terminating slash. Demonstrates fixed-count repetition and signed\n## fields.\ngrammar Iso6709 version \"1.0.0\" edition \"v2\" {\n  sign = %x2B / %x2D\n  digit = %x30-39\n  ## ±DD.DDDD — degrees latitude.\n  lat = sign 2digit \".\" 1*4digit as latitude\n  ## ±DDD.DDDD — degrees longitude.\n  lon = sign 3digit \".\" 1*4digit as longitude\n  altitude = sign 1*5digit \".\" 1*2digit as height\n  ## /Wnnn — the world-geodetic code suffix.\n  crs = \"/\" %x57 1*3digit\n  point = lat lon [ altitude ] [ crs ] [ \"/\" ]\n\n  entry main: point\n\n  test {\n    accept \"+40.1234-075.5678\"\n    accept \"+27.4716-070.1234/\"\n    accept \"-33.8688+151.2093+000.00/\"\n    reject \"40.1234-075.5678\"\n    reject \"+401234-075.5678\"\n  }\n}\n","source_hash":"57d4ee80ca4fe304462ceb1f2156f83cc7cb89432fb1500a5619bd80be8cbe99","unicode_tables":"onigmo (Ruby 3.4.8)","compiler_version":"1.3.136","edition":2,"semantics_hash":"sha256:36ae6b6f3c28a18084ae84cfae498dc5e4b14826738c24c397e24811b1b18014","checksum":"sha256:98eeb8d1b5ac7ed79baeea529b72541d87e3fbf5b8c2c081d768092994f78a16","validated":{"lint_errors":0,"lint_warnings":0,"tests_total":5,"tests_failures":0,"self_test":true},"byte_checksum":"sha256:23260433612cb3d6685fc8f21d6f6cbe4c4db69f5f86770294fede4b23d1e45a"}
