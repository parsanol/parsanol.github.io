x20 / %x09\n  nl = %x0A\n  pq = *ws\n  name = 1*( %x41-5A / %x61-7A / %x5F ) as name\n  item = pq name pq nl\n  block = name pq \"{\" nl *( item ) pq \"}\" nl as block\n  file = *( block )\n\n  entry main: file\n\n  test {\n    accept \"outer {\\n  alpha\\n  beta\\n}\\n\"\n    accept \"a {\\n  x\\n}\\nb {\\n  y\\n}\\n\"\n    accept \"empty {\\n}\\n\"\n    reject \"outer {\"\n    reject \"outer\\n}\"\n  }\n}\n","source_hash":"4b0ab7593c5d44d016e40a4c851547208ae475f071bed1f63dff64824c6c8280","unicode_tables":"onigmo (Ruby 3.4.8)","compiler_version":"1.3.110","mode":"v2","checksum":"sha256:4ebcd8614805c5a0a431d2c2c28775197486c72be9e1e2cd59d16a6b4c470437"}
