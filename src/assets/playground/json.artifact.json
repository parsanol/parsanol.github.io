y value: value\n}\n","source_hash":"1856bf7e55b1282e8393f937414abd00a2eaedcb7385cbd78aa799afb3200b4e","unicode_tables":"onigmo (Ruby 3.4.8)","compiler_version":"1.3.135","edition":2,"semantics_hash":"sha256:6d6e298e49dda0a1d0d741acbef676d899218964545294e7733249e2b529dd12","checksum":"sha256:fa2be0e772431fdbb36898524e74b3f4d572c912dc84acf81604b85100c52abc","validated":{"lint_errors":0,"lint_warnings":2,"tests_total":0,"tests_failures":0,"self_test":true},"byte_checksum":"sha256:7bbae57def16b710a52a577bd5fdb1395b6bf7db8f36390d40e989d9a15ebdff"}
