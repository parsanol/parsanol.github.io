ast every line shape.\ngrammar Toml version \"1.0.0\" edition \"v1\" {\n  nl = %x0A\n  ws = %x20 / %x09\n  pq = *ws\n  comment = \"#\" *( %x01-09 / %x0B-10FFFF )\n  nchar = %x41-5A / %x61-7A / %x30-39 / %x5F / %x2D\n  name = 1*nchar as key\n  sign = %x2B / %x2D\n  digit = %x30-39\n  int = [ sign ] 1*digit as integer\n  frac = \".\" 1*digit\n  exp = ( %x65 / %x45 ) [ sign ] 1*digit\n  float = [ sign ] 1*digit [ frac ] exp as float / [ sign ] 1*digit frac as float\n  boolean = \"true\" as flag / \"false\" as flag\n  schar = %x01-21 / %x23-5B / %x5D-10FFFF\n  str = %x22 *schar %x22 as text\n  value = float / str / int / boolean\n  pair = name pq \"=\" pq value pq [ comment ] nl\n  table = \"[\" pq name pq \"]\" pq [ comment ] nl\n  blank = pq [ comment ] nl\n  file = *( blank / table / pair ) [ table_last / pair_last ]\n  table_last = \"[\" pq name pq \"]\" pq [ comment ]\n  pair_last = name pq \"=\" pq value pq [ comment ]\n\n  entry main: file\n\n  test {\n    accept \"name = \\\"parsanol\\\"\\ncount = 3\\n\"\n    accept \"[server]\\nhost = \\\"localhost\\\"\\nport = 8080\\n\"\n    accept \"ratio = 0.5\\nflag = true\\n\"\n    accept \"sci = 1.5e10\\n\"\n    accept \"# just a comment\\nx = 1 # tail\\n\"\n    reject \"= no key\"\n    reject \"x = \"\n    reject \"[unclosed\\n\"\n  }\n}\n","source_hash":"a257a79469f29f28dbdc901be0486e1b4a5a17298bd269625d3022145cc5ec89","unicode_tables":"onigmo (Ruby 3.4.8)","compiler_version":"1.3.112","edition":"v1","checksum":"sha256:49cb40ffbfd5ff8346d850c191d9f3268e621d9af3912cd43dbcef072cd0e0f7"}
