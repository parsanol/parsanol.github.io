ds, comma-separated, newline-terminated.\n## Quoting: \"\" escapes a quote inside a quoted field.\ngrammar Csv version \"1.0.0\" mode \"v1\" {\n  quote = %x22\n  qchar = quote quote / ( %x01-21 / %x23-FF )\n  dstring = quote 1*qchar quote\n  bare = 1*( %x20-21 / %x23-2B / %x2D-FF )\n  ## One row of fields.\n  field = ( dstring / bare ) as value\n  row = field *( \",\" field ) [ %x0A ]\n  document = *( row )\n\n  cr = %x0D\n  skip = cr\n\n  entry main: document\n\n  test {\n    accept \"a,b,c\\n\"\n    accept \"\\\"x,y\\\",z\\n\"\n    accept \"1,2\\n3,4\\n\"\n    capture \"hello,csv\\n\" { value: \"hello\" }\n  }\n}\n","source_hash":"69b43d7e12509f14f5e65b2e650e605cb70b153966393697130290f5c5c3c10e","unicode_tables":"onigmo (Ruby 3.4.8)","compiler_version":"1.3.110","mode":"v1","skip":"cr","checksum":"sha256:017f3de845354268b5d75ba2df3db212056cd0fc9b23865ba6fbb7dd8b6bd000"}
