{"bindings":null,"version":"1.0.0","grammar":"Arith","shape":"parsanol-tree/v2","binding_version":1,"entries":{"main":{"root":"top","grammar":{"atoms":[{"Entity":{"atom":5}},{"Entity":{"atom":4}},{"Re":{"pattern":"[ ]"}},{"Re":{"pattern":"[\\x09]"}},{"Alternative":{"atoms":[2,3]}},{"Repetition":{"atom":1,"min":0,"max":null,"tag":"Repetition"}},{"Entity":{"atom":42}},{"Entity":{"atom":41}},{"Entity":{"atom":40}},{"Entity":{"atom":13}},{"Entity":{"atom":11}},{"Re":{"pattern":"[\\x30-\\x39]"}},{"Repetition":{"atom":10,"min":1,"max":null,"tag":"Repetition"}},{"Named":{"name":"number","atom":12}},{"Str":{"pattern":"("}},{"Entity":{"atom":5}},{"Entity":{"atom":38}},{"Entity":{"atom":5}},{"Str":{"pattern":"+"}},{"Str":{"pattern":"-"}},{"Alternative":{"atoms":[18,19]}},{"Entity":{"atom":5}},{"Entity":{"atom":35}},{"Entity":{"atom":5}},{"Str":{"pattern":"*"}},{"Str":{"pattern":"/"}},{"Alternative":{"atoms":[24,25]}},{"Entity":{"atom":5}},{"Entity":{"atom":32}},{"Entity":{"atom":5}},{"Str":{"pattern":")"}},{"Sequence":{"atoms":[14,15,16,29,30]}},{"Alternative":{"atoms":[9,31]}},{"Sequence":{"atoms":[23,26,27,28]}},{"Repetition":{"atom":33,"min":0,"max":null,"tag":"Repetition"}},{"Sequence":{"atoms":[8,34]}},{"Sequence":{"atoms":[17,20,21,22]}},{"Repetition":{"atom":36,"min":0,"max":null,"tag":"Repetition"}},{"Sequence":{"atoms":[7,37]}},{"Sequence":{"atoms":[14,15,16,29,30]}},{"Alternative":{"atoms":[9,39]}},{"Sequence":{"atoms":[8,34]}},{"Sequence":{"atoms":[7,37]}},{"Entity":{"atom":5}},{"Sequence":{"atoms":[0,6,43]}}],"root":44},"bindings":[]}},"preprocess":{},"tables":{},"lint":{"order_warnings":[]},"default_entry":"main","render":{},"derive":{},"tests":[{"entry":"main","kind":"accept","input":"1 + 2","expect":{}},{"entry":"main","kind":"accept","input":"2*3+4","expect":{}},{"entry":"main","kind":"accept","input":"(1 + 2) * (3 - 4) / 5","expect":{}},{"entry":"main","kind":"accept","input":"42","expect":{}},{"entry":"main","kind":"reject","input":"+ 1","expect":{}},{"entry":"main","kind":"reject","input":"1 +","expect":{}},{"entry":"main","kind":"reject","input":"(1 + 2","expect":{}}],"docs":{},"source":"## Arithmetic expressions with precedence encoded as LAYERS: expr\n## (additive) -> term (multiplicative) -> factor (atoms and groups).\n## Each layer's repetition consumes its operator between operands, so\n## precedence falls out of the shape — no tables, no rewriting.\ngrammar Arith version \"1.0.0\" edition \"v2\" {\n  ws = %x20 / %x09\n  pq = *ws\n  digit = %x30-39\n  number = 1*digit as number\n  factor = number / ( \"(\" pq expr pq \")\" )\n  term = factor *( pq ( \"*\" / \"/\" ) pq factor )\n  expr = term *( pq ( \"+\" / \"-\" ) pq term )\n  top = pq expr pq\n\n  entry main: top\n\n  test {\n    accept \"1 + 2\"\n    accept \"2*3+4\"\n    accept \"(1 + 2) * (3 - 4) / 5\"\n    accept \"42\"\n    reject \"+ 1\"\n    reject \"1 +\"\n    reject \"(1 + 2\"\n  }\n}\n","source_hash":"af81ddd0eb909dc751797e8f5c165b8e4af53f65debd34d9bf2be3ae5235add7","unicode_tables":"onigmo (Ruby 3.4.8)","compiler_version":"1.3.146","edition":2,"semantics_hash":"sha256:9d21007887e2b9a8f6a4db6b286abb08b45e12f546bd5b8399dc1cc9a2396dc7","checksum":"sha256:7b5f44b6881e3c7e2d8fd5cee2bc9f96cf3d686296bf159609f8742b45430a7e","validated":{"lint_errors":0,"lint_warnings":0,"tests_total":7,"tests_failures":0,"self_test":true},"byte_checksum":"sha256:8f4f6490aa428d9802d94932897209bab26cd27d950a5f6143cb874658a6a14f"}
