{"bindings":null,"version":"1.0.0","grammar":"MiniLisp","shape":"parsanol-tree/v2","binding_version":1,"entries":{"main":{"root":"top","grammar":{"atoms":[{"Entity":{"atom":6}},{"Entity":{"atom":5}},{"Re":{"pattern":"[ ]"}},{"Re":{"pattern":"[\\x09]"}},{"Re":{"pattern":"[\\x0a]"}},{"Alternative":{"atoms":[2,3,4]}},{"Repetition":{"atom":1,"min":0,"max":null,"tag":"Repetition"}},{"Entity":{"atom":50}},{"Entity":{"atom":38}},{"Entity":{"atom":16}},{"Re":{"pattern":"[\\-]"}},{"Repetition":{"atom":10,"min":0,"max":1,"tag":"Maybe"}},{"Entity":{"atom":13}},{"Re":{"pattern":"[\\x30-\\x39]"}},{"Repetition":{"atom":12,"min":1,"max":null,"tag":"Repetition"}},{"Named":{"name":"number","atom":14}},{"Sequence":{"atoms":[11,15]}},{"Entity":{"atom":28}},{"Re":{"pattern":"[\"]"}},{"Entity":{"atom":23}},{"Re":{"pattern":"[\\x01-\\x21]"}},{"Re":{"pattern":"[\\x23-\\x5b]"}},{"Re":{"pattern":"[\\x5d-\\u{10ffff}]"}},{"Alternative":{"atoms":[20,21,22]}},{"Named":{"name":"schar","atom":19}},{"Repetition":{"atom":24,"min":0,"max":null,"tag":"Repetition"}},{"Re":{"pattern":"[\"]"}},{"Named":{"name":"string","atom":26}},{"Sequence":{"atoms":[18,25,27]}},{"Entity":{"atom":37}},{"Entity":{"atom":35}},{"Re":{"pattern":"[!]"}},{"Re":{"pattern":"[\\x23-\\x27]"}},{"Re":{"pattern":"[\\x2a-\\x5b]"}},{"Re":{"pattern":"[\\x5d-\\x7e]"}},{"Alternative":{"atoms":[31,32,33,34]}},{"Repetition":{"atom":30,"min":1,"max":null,"tag":"Repetition"}},{"Named":{"name":"symbol","atom":36}},{"Alternative":{"atoms":[9,17,29]}},{"Entity":{"atom":49}},{"Str":{"pattern":"("}},{"Entity":{"atom":6}},{"Entity":{"atom":43}},{"Alternative":{"atoms":[8,39]}},{"Entity":{"atom":6}},{"Sequence":{"atoms":[42,44]}},{"Repetition":{"atom":45,"min":0,"max":null,"tag":"Repetition"}},{"Str":{"pattern":")"}},{"Named":{"name":"forms","atom":47}},{"Sequence":{"atoms":[40,41,46,48]}},{"Alternative":{"atoms":[8,39]}},{"Entity":{"atom":6}},{"Sequence":{"atoms":[0,7,51]}}],"root":52},"bindings":[]}},"preprocess":{},"tables":{},"lint":{"order_warnings":["rule schar: branches 1 and 3 are order-dependent (first set not statically known)","rule schar: branches 2 and 3 are order-dependent (first set not statically known)","rule atom: branches 1 and 3 are order-dependent (shared first bytes; ordered choice is decisive)"]},"default_entry":"main","render":{},"derive":{},"tests":[{"entry":"main","kind":"accept","input":"42","expect":{}},{"entry":"main","kind":"accept","input":"(define x 1)","expect":{}},{"entry":"main","kind":"accept","input":"(+ 1 (* 2 3))","expect":{}},{"entry":"main","kind":"accept","input":"(print \"hello\" (list a b))","expect":{}},{"entry":"main","kind":"accept","input":"(neg -5)","expect":{}},{"entry":"main","kind":"reject","input":"(unclosed","expect":{}},{"entry":"main","kind":"reject","input":"\"unterminated","expect":{}},{"entry":"main","kind":"accept","input":"()","expect":{}}],"docs":{"ychar":"printable minus space, parens, quote and semicolon."},"source":"## Mini Lisp: s-expressions with integers, strings and symbols. The\n## atom alternation is ordered number / string / symbol — same-length\n## shapes, so the order only expresses intent, and the recursion stays\n## sexp -> list -> sexp.\ngrammar MiniLisp version \"1.0.0\" edition \"v2\" {\n  ws = %x20 / %x09 / %x0A\n  pq = *ws\n  digit = %x30-39\n  number = [ %x2D ] 1*digit as number\n  schar = %x01-21 / %x23-5B / %x5D-10FFFF\n  string = %x22 *schar %x22 as string\n  ## printable minus space, parens, quote and semicolon.\n  ychar = %x21 / %x23-27 / %x2A-5B / %x5D-7E\n  symbol = 1*ychar as symbol\n  atom = number / string / symbol\n  list = \"(\" pq *( sexp pq ) \")\" as forms\n  sexp = atom / list\n  top = pq sexp pq\n\n  entry main: top\n\n  test {\n    accept \"42\"\n    accept \"(define x 1)\"\n    accept \"(+ 1 (* 2 3))\"\n    accept \"(print \\\"hello\\\" (list a b))\"\n    accept \"(neg -5)\"\n    reject \"(unclosed\"\n    reject \"\\\"unterminated\"\n    accept \"()\"   # the empty list is a value\n  }\n}\n","source_hash":"f15752ed19086bee73b91a6dbe2da69b5abf248aff53e9ba21a1f8f81df2ddae","unicode_tables":"onigmo (Ruby 3.4.8)","compiler_version":"1.3.142","edition":2,"semantics_hash":"sha256:6d0a4ad9d8f04438081a586bae6f5d3ffa7155400b06112967db345abbbe614f","checksum":"sha256:7f4aea41a265c656a434992d8911da49dec41ecd254930169d6f92513a81ade3","validated":{"lint_errors":0,"lint_warnings":3,"tests_total":8,"tests_failures":0,"self_test":true},"byte_checksum":"sha256:2d17b68ac3e6e4ca2593778780f9147af08a4f972ce5dd9666710dee9724ff53"}
