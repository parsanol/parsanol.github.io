arsanol\ncount: 3\n","expect":{}},{"entry":"main","kind":"accept","input":"server:\n  host: localhost\n  port: 8080\n","expect":{}},{"entry":"main","kind":"accept","input":"items:\n- one\n- two\n","expect":{}},{"entry":"main","kind":"accept","input":"flat: value\n","expect":{}},{"entry":"main","kind":"reject","input":"name parsanol","expect":{}},{"entry":"main","kind":"reject","input":"key: value: trailing","expect":{}}],"docs":{},"source":"## YAML, the block-mapping subset: nested keys by two-space indent,\n## scalars and block sequences. The indentation-sensitive corners of\n## real YAML are out of scope — this is the shape configuration files\n## actually use.\ngrammar YamlSubset version \"1.0.0\" edition \"v2\" {\n  nl = %x0A\n  ws = %x20\n  pq = *ws\n  indent = 2*2ws\n  key = 1*( %x41-5A / %x61-7A / %x30-39 / %x5F / %x2D ) as key\n  scalar = 1*( %x09 / %x0B-10FFFF ) as value\n  seqitem = [ indent ] \"-\" pq scalar nl\n  pair = key \":\" pq scalar nl\n  nested = key \":\" nl *( indent key \":\" pq scalar nl ) as mapping\n  doc = *( pair / seqitem / nested )\n\n  entry main: doc\n\n  test {\n    accept \"name: parsanol\\ncount: 3\\n\"\n    accept \"server:\\n  host: localhost\\n  port: 8080\\n\"\n    accept \"items:\\n- one\\n- two\\n\"\n    accept \"flat: value\\n\"\n    reject \"name parsanol\"\n    reject \"key: value: trailing\"\n  }\n}\n","source_hash":"169c22178e9215e05c884c28249fc9aefe33f0d5f0f8a298b7d205e43d8110a2","unicode_tables":"onigmo (Ruby 3.4.8)","compiler_version":"1.3.115","edition":2,"checksum":"sha256:78642be4095da209cb7758625a4fb31f1e3e72f90c938e7f46aa70b67b93eba6"}
