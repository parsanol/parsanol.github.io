{"order_warnings":[]},"default_entry":"main","render":{},"derive":{},"tests":[{"entry":"main","kind":"accept","input":"[core]\nname = parsanol\n","expect":{}},{"entry":"main","kind":"accept","input":"key = value","expect":{}},{"entry":"main","kind":"accept","input":"[a]\n\nx = 1\n[b]\ny = 2","expect":{}},{"entry":"main","kind":"reject","input":"= no key","expect":{}},{"entry":"main","kind":"reject","input":"[unclosed\n","expect":{}}],"docs":{"value":"anything but newline: the value tail.","section_last":"The final line may omit its newline, so the tail forms repeat the\nconstructs without consuming one."},"source":"## INI files: sections in brackets, key = value pairs, blank lines.\n## The grammar is line-oriented: every construct consumes its newline\n## (the last line may omit it).\ngrammar Ini version \"1.0.0\" edition \"v1\" {\n  nl = %x0A\n  ws = %x20 / %x09\n  pq = *ws\n  ident = 1*( %x41-5A / %x61-7A / %x30-39 / %x5F / %x2D )\n  ## anything but newline: the value tail.\n  value = *( %x09 / %x20-10FFFF )\n  section = \"[\" pq ident pq \"]\" pq nl\n  pair = key pq \"=\" pq value nl\n  blank = pq nl\n  key = ident\n  ## The final line may omit its newline, so the tail forms repeat the\n  ## constructs without consuming one.\n  section_last = \"[\" pq ident pq \"]\" pq\n  pair_last = key pq \"=\" pq value\n  file = *( blank / section / pair ) [ ( section_last / pair_last ) ]\n\n  entry main: file\n\n  test {\n    accept \"[core]\\nname = parsanol\\n\"\n    accept \"key = value\"\n    accept \"[a]\\n\\nx = 1\\n[b]\\ny = 2\"\n    reject \"= no key\"\n    reject \"[unclosed\\n\"\n  }\n}\n","source_hash":"24483516db6dbbb3032e2150f360eca5b592ef8e3311f7038b4669279a1169db","unicode_tables":"onigmo (Ruby 3.4.8)","compiler_version":"1.3.112","edition":"v1","checksum":"sha256:aadab79bddeaec3ebc0e1d896fb9d6208501cddd2d8eca26ce34c5ed5b1f1119"}
