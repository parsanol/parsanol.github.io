{"Alternative":{"atoms":[44,53]}},{"Repetition":{"atom":61,"min":0,"max":1,"tag":"Maybe"}},{"Sequence":{"atoms":[43,62]}}],"root":63},"bindings":[]}},"preprocess":{},"tables":{},"lint":{"order_warnings":[]},"default_entry":"main","render":{},"derive":{},"tests":[{"entry":"main","kind":"accept","input":"[core]\nname = parsanol\n","expect":{}},{"entry":"main","kind":"accept","input":"key = value","expect":{}},{"entry":"main","kind":"accept","input":"[a]\n\nx = 1\n[b]\ny = 2","expect":{}},{"entry":"main","kind":"reject","input":"= no key","expect":{}},{"entry":"main","kind":"reject","input":"[unclosed\n","expect":{}}],"docs":{"value":"anything but newline: the value tail.","section_last":"The final line may omit its newline, so the tail forms repeat the\nconstructs without consuming one."},"source":"## INI files: sections in brackets, key = value pairs, blank lines.\n## The grammar is line-oriented: every construct consumes its newline\n## (the last line may omit it).\ngrammar Ini version \"1.0.0\" edition \"v2\" {\n  nl = %x0A\n  ws = %x20 / %x09\n  pq = *ws\n  ident = 1*( %x41-5A / %x61-7A / %x30-39 / %x5F / %x2D )\n  ## anything but newline: the value tail.\n  value = *( %x09 / %x20-10FFFF )\n  section = \"[\" pq ident pq \"]\" pq nl\n  pair = key pq \"=\" pq value nl\n  blank = pq nl\n  key = ident\n  ## The final line may omit its newline, so the tail forms repeat the\n  ## constructs without consuming one.\n  section_last = \"[\" pq ident pq \"]\" pq\n  pair_last = key pq \"=\" pq value\n  file = *( blank / section / pair ) [ ( section_last / pair_last ) ]\n\n  entry main: file\n\n  test {\n    accept \"[core]\\nname = parsanol\\n\"\n    accept \"key = value\"\n    accept \"[a]\\n\\nx = 1\\n[b]\\ny = 2\"\n    reject \"= no key\"\n    reject \"[unclosed\\n\"\n  }\n}\n","source_hash":"0cc56c1f41cde03bd10cea31f1775840ce98b4355c1938667c7a0a207bdab477","unicode_tables":"onigmo (Ruby 3.4.8)","compiler_version":"1.3.136","edition":2,"semantics_hash":"sha256:80910d562930546381efdaafb799f136edd93ae889f9affc03d0c319c5e3a345","checksum":"sha256:476e7ade1cde3a569714a9d06348dc59114c09733607047f8fa5a00ff5775df3","validated":{"lint_errors":0,"lint_warnings":0,"tests_total":5,"tests_failures":0,"self_test":true},"byte_checksum":"sha256:670b136546b3409ec0b49ba63e0d4b4096e50230abad724e4b32976ad88b7151"}
