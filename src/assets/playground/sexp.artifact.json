{"bindings":null,"version":"1.0.0","grammar":"Sexp","shape":"parsanol-tree/v2","binding_version":1,"entries":{"main":{"root":"top","grammar":{"atoms":[{"Entity":{"atom":6}},{"Entity":{"atom":5}},{"Re":{"pattern":"[ ]"}},{"Re":{"pattern":"[\\x09]"}},{"Re":{"pattern":"[\\x0a]"}},{"Alternative":{"atoms":[2,3,4]}},{"Repetition":{"atom":1,"min":0,"max":null,"tag":"Repetition"}},{"Entity":{"atom":28}},{"Entity":{"atom":16}},{"Entity":{"atom":14}},{"Re":{"pattern":"[!]"}},{"Re":{"pattern":"[\\x23-\\x27]"}},{"Re":{"pattern":"[\\x2a-\\x5b]"}},{"Re":{"pattern":"[\\x5d-\\x7e]"}},{"Alternative":{"atoms":[10,11,12,13]}},{"Repetition":{"atom":9,"min":1,"max":null,"tag":"Repetition"}},{"Named":{"name":"symbol","atom":15}},{"Entity":{"atom":27}},{"Str":{"pattern":"("}},{"Entity":{"atom":6}},{"Entity":{"atom":21}},{"Alternative":{"atoms":[8,17]}},{"Entity":{"atom":6}},{"Sequence":{"atoms":[20,22]}},{"Repetition":{"atom":23,"min":0,"max":null,"tag":"Repetition"}},{"Str":{"pattern":")"}},{"Named":{"name":"forms","atom":25}},{"Sequence":{"atoms":[18,19,24,26]}},{"Alternative":{"atoms":[8,17]}},{"Entity":{"atom":6}},{"Sequence":{"atoms":[0,7,29]}}],"root":30},"bindings":[]}},"preprocess":{},"tables":{},"lint":{"order_warnings":[]},"default_entry":"main","render":{},"derive":{},"tests":[{"entry":"main","kind":"accept","input":"atom","expect":{}},{"entry":"main","kind":"accept","input":"(a b c)","expect":{}},{"entry":"main","kind":"accept","input":"(define (square x) (* x x))","expect":{}},{"entry":"main","kind":"accept","input":"(a (b (c) d) e)","expect":{}},{"entry":"main","kind":"reject","input":"(unclosed","expect":{}},{"entry":"main","kind":"reject","input":")leading","expect":{}},{"entry":"main","kind":"reject","input":"(a b","expect":{}}],"docs":{"achar":"printable minus space, parens and quote: an atom's characters."},"source":"## S-expressions: atoms and parenthesized lists, arbitrarily nested,\n## whitespace between elements. The recursion is sexp -> list -> sexp —\n## no left recursion, pure nesting.\ngrammar Sexp version \"1.0.0\" edition \"v1\" {\n  ws = %x20 / %x09 / %x0A\n  pq = *ws\n  ## printable minus space, parens and quote: an atom's characters.\n  achar = %x21 / %x23-27 / %x2A-5B / %x5D-7E\n  atom = 1*achar as symbol\n  list = \"(\" pq *( sexp pq ) \")\" as forms\n  sexp = atom / list\n  top = pq sexp pq\n\n  entry main: top\n\n  test {\n    accept \"atom\"\n    accept \"(a b c)\"\n    accept \"(define (square x) (* x x))\"\n    accept \"(a (b (c) d) e)\"\n    reject \"(unclosed\"\n    reject \")leading\"\n    reject \"(a b\"\n  }\n}\n","source_hash":"2c95d27b609a26106f4ef24677e20d46a91ce5a83daa2263bacb5ab17be34204","unicode_tables":"onigmo (Ruby 3.4.8)","compiler_version":"1.3.117","edition":1,"semantics_hash":"sha256:8aaf7c63444e8ec948770e72b991b46ac4c1a572815f4420440a84a4d2fa9f3b","checksum":"sha256:e3cacd8b534f85c3a7d1b8c1245faee45b729d08195f4ccdbf347b7a154da586"}
