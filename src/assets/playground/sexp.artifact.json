{"bindings":null,"version":"1.0.0","grammar":"Sexp","shape":"parsanol-tree/v2","binding_version":1,"entries":{"main":{"root":"top","grammar":{"atoms":[{"Entity":{"atom":6}},{"Entity":{"atom":5}},{"Re":{"pattern":"[ ]"}},{"Re":{"pattern":"[\\x09]"}},{"Re":{"pattern":"[\\x0a]"}},{"Alternative":{"atoms":[2,3,4]}},{"Repetition":{"atom":1,"min":0,"max":null,"tag":"Repetition"}},{"Entity":{"atom":28}},{"Entity":{"atom":16}},{"Entity":{"atom":14}},{"Re":{"pattern":"[!]"}},{"Re":{"pattern":"[\\x23-\\x27]"}},{"Re":{"pattern":"[\\x2a-\\x5b]"}},{"Re":{"pattern":"[\\x5d-\\x7e]"}},{"Alternative":{"atoms":[10,11,12,13]}},{"Repetition":{"atom":9,"min":1,"max":null,"tag":"Repetition"}},{"Named":{"name":"symbol","atom":15}},{"Entity":{"atom":27}},{"Str":{"pattern":"("}},{"Entity":{"atom":6}},{"Entity":{"atom":21}},{"Alternative":{"atoms":[8,17]}},{"Entity":{"atom":6}},{"Sequence":{"atoms":[20,22]}},{"Repetition":{"atom":23,"min":0,"max":null,"tag":"Repetition"}},{"Str":{"pattern":")"}},{"Named":{"name":"forms","atom":25}},{"Sequence":{"atoms":[18,19,24,26]}},{"Alternative":{"atoms":[8,17]}},{"Entity":{"atom":6}},{"Sequence":{"atoms":[0,7,29]}}],"root":30},"bindings":[]}},"preprocess":{},"tables":{},"lint":{"order_warnings":[]},"default_entry":"main","render":{},"derive":{},"tests":[{"entry":"main","kind":"accept","input":"atom","expect":{}},{"entry":"main","kind":"accept","input":"(a b c)","expect":{}},{"entry":"main","kind":"accept","input":"(define (square x) (* x x))","expect":{}},{"entry":"main","kind":"accept","input":"(a (b (c) d) e)","expect":{}},{"entry":"main","kind":"reject","input":"(unclosed","expect":{}},{"entry":"main","kind":"reject","input":")leading","expect":{}},{"entry":"main","kind":"reject","input":"(a b","expect":{}}],"docs":{"achar":"printable minus space, parens and quote: an atom's characters."},"source":"## S-expressions: atoms and parenthesized lists, arbitrarily nested,\n## whitespace between elements. The recursion is sexp -> list -> sexp —\n## no left recursion, pure nesting.\ngrammar Sexp version \"1.0.0\" edition \"v2\" {\n  ws = %x20 / %x09 / %x0A\n  pq = *ws\n  ## printable minus space, parens and quote: an atom's characters.\n  achar = %x21 / %x23-27 / %x2A-5B / %x5D-7E\n  atom = 1*achar as symbol\n  list = \"(\" pq *( sexp pq ) \")\" as forms\n  sexp = atom / list\n  top = pq sexp pq\n\n  entry main: top\n\n  test {\n    accept \"atom\"\n    accept \"(a b c)\"\n    accept \"(define (square x) (* x x))\"\n    accept \"(a (b (c) d) e)\"\n    reject \"(unclosed\"\n    reject \")leading\"\n    reject \"(a b\"\n  }\n}\n","source_hash":"9e9ab57b3bb65baefcbe45d4a5c39b63a78e41ac6fa649de25c9c9c8c1078566","unicode_tables":"onigmo (Ruby 3.4.8)","compiler_version":"1.3.145","edition":2,"semantics_hash":"sha256:cafe9a52688349c007041dd2259c58305debf42a3a0635aff348b62f3864bfa5","checksum":"sha256:7b0b50ee14e093ae6b8bfe527145ab3a2e28d30772afedb16d37cf668564fcd0","validated":{"lint_errors":0,"lint_warnings":0,"tests_total":7,"tests_failures":0,"self_test":true},"byte_checksum":"sha256:e847016d04821e9047159135d334e78003459545c7caadc6c5cd04cbea413e20"}
