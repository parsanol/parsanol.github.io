{"bindings":null,"version":"1.0.0","grammar":"Sectioned","shape":"parsanol-tree/v2","binding_version":1,"entries":{"main":{"root":"doc","grammar":{"atoms":[{"Entity":{"atom":33}},{"Str":{"pattern":"["}},{"Entity":{"atom":8}},{"Entity":{"atom":6}},{"Re":{"pattern":"[ ]"}},{"Re":{"pattern":"[\\x09]"}},{"Alternative":{"atoms":[4,5]}},{"Named":{"name":"ws","atom":3}},{"Repetition":{"atom":7,"min":0,"max":null,"tag":"Repetition"}},{"Entity":{"atom":16}},{"Re":{"pattern":"[\\x41-\\x5a]"}},{"Re":{"pattern":"[\\x61-\\x7a]"}},{"Re":{"pattern":"[\\x30-\\x39]"}},{"Re":{"pattern":"[\\-]"}},{"Alternative":{"atoms":[10,11,12,13]}},{"Repetition":{"atom":14,"min":1,"max":null,"tag":"Repetition"}},{"Named":{"name":"section","atom":15}},{"Entity":{"atom":8}},{"Str":{"pattern":"]"}},{"Entity":{"atom":20}},{"Re":{"pattern":"[\\x0a]"}},{"Named":{"name":"nl","atom":19}},{"Entity":{"atom":31}},{"Entity":{"atom":8}},{"Re":{"pattern":"[\\x01-\\x09]"}},{"Re":{"pattern":"[\\x0b-\\u{10ffff}]"}},{"Alternative":{"atoms":[24,25]}},{"Repetition":{"atom":26,"min":0,"max":null,"tag":"Repetition"}},{"Entity":{"atom":8}},{"Entity":{"atom":20}},{"Named":{"name":"nl","atom":29}},{"Sequence":{"atoms":[23,27,28,30]}},{"Repetition":{"atom":22,"min":0,"max":null,"tag":"Repetition"}},{"Sequence":{"atoms":[1,2,9,17,18,21,32]}},{"Repetition":{"atom":0,"min":0,"max":null,"tag":"Repetition"}}],"root":34},"bindings":[]}},"preprocess":{},"tables":{},"lint":{"order_warnings":[]},"default_entry":"main","render":{},"derive":{},"tests":[{"entry":"main","kind":"accept","input":"[alpha]\ntext here\n","expect":{}},{"entry":"main","kind":"accept","input":"[alpha]\na\n[beta]\nb\n","expect":{}},{"entry":"main","kind":"accept","input":"[a-1]\n\n\n","expect":{}},{"entry":"main","kind":"reject","input":"alpha]\n","expect":{}},{"entry":"main","kind":"reject","input":"[unclosed\n","expect":{}}],"docs":{},"source":"## Incremental fuel: sectioned documents — the shape an editor\n## re-parses region-by-region after an edit. Sections are\n## self-delimiting, so a change inside one never invalidates the\n## parse of its siblings.\ngrammar Sectioned version \"1.0.0\" {\n  nl = %x0A\n  ws = %x20 / %x09\n  pq = *ws\n  name = 1*( %x41-5A / %x61-7A / %x30-39 / %x2D ) as section\n  line = pq *( %x01-09 / %x0B-10FFFF ) pq nl\n  block = \"[\" pq name pq \"]\" nl *( line )\n  doc = *( block )\n\n  entry main: doc\n\n  test {\n    accept \"[alpha]\\ntext here\\n\"\n    accept \"[alpha]\\na\\n[beta]\\nb\\n\"\n    accept \"[a-1]\\n\\n\\n\"\n    reject \"alpha]\\n\"\n    reject \"[unclosed\\n\"\n  }\n}\n","source_hash":"5094d17fb75539bc97d42e37ae6d9fc59563301eab4cc6ee3c69fb5df35cde45","unicode_tables":"onigmo (Ruby 3.4.8)","compiler_version":"1.3.111","mode":"v2","emission":2,"checksum":"sha256:3e783d971ea09711e7fbf9f2e13f3d0343daf9f15445bee779d26b5f3a82bd86"}
