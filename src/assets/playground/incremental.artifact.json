s the\n## parse of its siblings.\ngrammar Sectioned version \"1.0.0\" edition \"v2\" {\n  nl = %x0A\n  ws = %x20 / %x09\n  pq = *ws\n  name = 1*( %x41-5A / %x61-7A / %x30-39 / %x2D ) as section\n  line = pq *( %x01-09 / %x0B-10FFFF ) pq nl\n  block = \"[\" pq name pq \"]\" nl *( line )\n  doc = *( block )\n\n  entry main: doc\n\n  test {\n    accept \"[alpha]\\ntext here\\n\"\n    accept \"[alpha]\\na\\n[beta]\\nb\\n\"\n    accept \"[a-1]\\n\\n\\n\"\n    reject \"alpha]\\n\"\n    reject \"[unclosed\\n\"\n  }\n}\n","source_hash":"597cfd76a2ea7286d2c2693fe1f42661a5f5d896bebbf40c511ab3071f0e5fb7","unicode_tables":"onigmo (Ruby 3.4.8)","compiler_version":"1.3.114","edition":2,"checksum":"sha256:fffae9d25ce409d4be8e53e0a296bf8a0c7055d7f54887f162e5d3c78f047177"}
