s":[52,53,54,55,56]}},{"Sequence":{"atoms":[8,39,49,50,51]}},{"Alternative":{"atoms":[40,41]}},{"Repetition":{"atom":59,"min":0,"max":null,"tag":"Repetition"}},{"Sequence":{"atoms":[8,39,60,50,51]}},{"Entity":{"atom":6}},{"Sequence":{"atoms":[0,7,62]}}],"root":63},"bindings":[]}},"preprocess":{},"tables":{},"lint":{"order_warnings":["rule aqchar: branches 1 and 2 are order-dependent (first set not statically known)","rule tchar: branches 1 and 2 are order-dependent (first set not statically known)"]},"default_entry":"main","render":{},"derive":{},"tests":[{"entry":"main","kind":"accept","input":"<a>text</a>","expect":{}},{"entry":"main","kind":"accept","input":"<a href=\"x\">link</a>","expect":{}},{"entry":"main","kind":"accept","input":"<outer><inner a=\"1\">deep</inner></outer>","expect":{}},{"entry":"main","kind":"accept","input":"<list><item>1</item><item>2</item></list>","expect":{}},{"entry":"main","kind":"reject","input":"<a>unclosed","expect":{}},{"entry":"main","kind":"reject","input":"plain text","expect":{}},{"entry":"main","kind":"reject","input":"</a>leading-close","expect":{}}],"docs":{"tchar":"anything but \"<\": element text."},"source":"## Simplified XML: nested elements with attributes and text. The shape\n## guarantees well-formedness (every open has a close); matching tag\n## NAMES are a semantic check the AST layer adds.\ngrammar SimpleXml version \"1.0.0\" edition \"v2\" {\n  ws = %x20 / %x09 / %x0A\n  pq = *ws\n  nchar = %x41-5A / %x61-7A / %x30-39 / %x5F / %x2D\n  name = 1*nchar as tag\n  aqchar = %x01-21 / %x23-10FFFF\n  attr = pq name pq \"=\" pq %x22 *aqchar %x22\n  open = \"<\" name *attr pq \">\"\n  close = \"</\" pq name pq \">\"\n  ## anything but \"<\": element text.\n  tchar = %x01-3B / %x3D-10FFFF\n  text = 1*tchar as text\n  elem = open pq *( elem / text ) pq close\n  doc = pq elem pq\n\n  entry main: doc\n\n  test {\n    accept \"<a>text</a>\"\n    accept \"<a href=\\\"x\\\">link</a>\"\n    accept \"<outer><inner a=\\\"1\\\">deep</inner></outer>\"\n    accept \"<list><item>1</item><item>2</item></list>\"\n    reject \"<a>unclosed\"\n    reject \"plain text\"\n    reject \"</a>leading-close\"\n  }\n}\n","source_hash":"0d051bfa5677649ad20441caaf191783714e90568308e01aec8b6e6dd61b0905","unicode_tables":"onigmo (Ruby 3.4.8)","compiler_version":"1.3.128","edition":2,"semantics_hash":"sha256:2549fc701bd651518fab55244ff9086ee1caec44a0017d60901a8535ee1d8702","checksum":"sha256:888c9d3bda069d48243fb444a1e0a69ff37c39f0eabb0a2c84b123b7fae4fe58"}
