{"bindings":null,"version":"1.0.0","grammar":"Seasons","shape":"parsanol-tree/v2","binding_version":1,"entries":{"main":{"root":"year","grammar":{"atoms":[{"Entity":{"atom":36}},{"Entity":{"atom":6}},{"Entity":{"atom":5}},{"Re":{"pattern":"[ ]"}},{"Re":{"pattern":"[\\x09]"}},{"Alternative":{"atoms":[3,4]}},{"Repetition":{"atom":2,"min":0,"max":null,"tag":"Repetition"}},{"Entity":{"atom":13}},{"Re":{"pattern":"(?i:spring)"}},{"Re":{"pattern":"(?i:summer)"}},{"Re":{"pattern":"(?i:autumn)"}},{"Re":{"pattern":"(?i:winter)"}},{"Alternative":{"atoms":[8,9,10,11]}},{"Named":{"name":"season","atom":12}},{"Entity":{"atom":6}},{"Str":{"pattern":":"}},{"Entity":{"atom":6}},{"Entity":{"atom":23}},{"Entity":{"atom":21}},{"Re":{"pattern":"[\\x41-\\x5a]"}},{"Re":{"pattern":"[\\x61-\\x7a]"}},{"Alternative":{"atoms":[19,20]}},{"Repetition":{"atom":18,"min":1,"max":null,"tag":"Repetition"}},{"Named":{"name":"month","atom":22}},{"Entity":{"atom":6}},{"Str":{"pattern":","}},{"Entity":{"atom":6}},{"Sequence":{"atoms":[24,25,26]}},{"Entity":{"atom":6}},{"Alternative":{"atoms":[27,28]}},{"Entity":{"atom":23}},{"Sequence":{"atoms":[29,30]}},{"Repetition":{"atom":31,"min":0,"max":null,"tag":"Repetition"}},{"Entity":{"atom":6}},{"Entity":{"atom":35}},{"Re":{"pattern":"[\\x0a]"}},{"Sequence":{"atoms":[1,7,14,15,16,17,32,33,34]}},{"Repetition":{"atom":0,"min":0,"max":null,"tag":"Repetition"}}],"root":37},"bindings":[]}},"preprocess":{},"tables":{},"lint":{"order_warnings":[]},"default_entry":"main","render":{},"derive":{},"tests":[{"entry":"main","kind":"accept","input":"spring: March April May\n","expect":{}},{"entry":"main","kind":"accept","input":"winter: December\n","expect":{}},{"entry":"main","kind":"accept","input":"autumn: September, October, November\n","expect":{}},{"entry":"main","kind":"reject","input":"sprint: March\n","expect":{}},{"entry":"main","kind":"reject","input":"spring March\n","expect":{}}],"docs":{"line":"comma-or-space separated: the comma form leads the choice."},"source":"## Transform fuel: season names with their months, shaped so a tree\n## transform has real structure to walk — a season captures its name\n## and each month capture sits inside it.\ngrammar Seasons version \"1.0.0\" edition \"v2\" {\n  ws = %x20 / %x09\n  pq = *ws\n  nl = %x0A\n  alpha = %x41-5A / %x61-7A\n  season = ( %i\"spring\" / %i\"summer\" / %i\"autumn\" / %i\"winter\" ) as season\n  month = 1*alpha as month\n  ## comma-or-space separated: the comma form leads the choice.\n  line = pq season pq \":\" pq month *( ( pq \",\" pq / pq ) month ) pq nl\n  year = *( line )\n\n  entry main: year\n\n  test {\n    accept \"spring: March April May\\n\"\n    accept \"winter: December\\n\"\n    accept \"autumn: September, October, November\\n\"\n    reject \"sprint: March\\n\"\n    reject \"spring March\\n\"\n  }\n}\n","source_hash":"137d5327c6ed530decd860df468c8ca3a1aba755dce8266183cf80bec49838bd","unicode_tables":"onigmo (Ruby 3.4.8)","compiler_version":"1.3.115","edition":2,"checksum":"sha256:31f680f369cd347523ad9f57cb2fe1f389d2874a0c5c7066157653578ee9140c"}
