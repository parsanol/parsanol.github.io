{"bindings":null,"version":"1.0.0","grammar":"Seasons","shape":"parsanol-tree/v2","binding_version":1,"entries":{"main":{"root":"year","grammar":{"atoms":[{"Entity":{"atom":38}},{"Entity":{"atom":7}},{"Entity":{"atom":5}},{"Re":{"pattern":"[ ]"}},{"Re":{"pattern":"[\\x09]"}},{"Alternative":{"atoms":[3,4]}},{"Named":{"name":"ws","atom":2}},{"Repetition":{"atom":6,"min":0,"max":null,"tag":"Repetition"}},{"Entity":{"atom":14}},{"Re":{"pattern":"(?i:spring)"}},{"Re":{"pattern":"(?i:summer)"}},{"Re":{"pattern":"(?i:autumn)"}},{"Re":{"pattern":"(?i:winter)"}},{"Alternative":{"atoms":[9,10,11,12]}},{"Named":{"name":"season","atom":13}},{"Entity":{"atom":7}},{"Str":{"pattern":":"}},{"Entity":{"atom":7}},{"Entity":{"atom":24}},{"Entity":{"atom":22}},{"Re":{"pattern":"[\\x41-\\x5a]"}},{"Re":{"pattern":"[\\x61-\\x7a]"}},{"Alternative":{"atoms":[20,21]}},{"Repetition":{"atom":19,"min":1,"max":null,"tag":"Repetition"}},{"Named":{"name":"month","atom":23}},{"Entity":{"atom":7}},{"Str":{"pattern":","}},{"Entity":{"atom":7}},{"Sequence":{"atoms":[25,26,27]}},{"Entity":{"atom":7}},{"Alternative":{"atoms":[28,29]}},{"Entity":{"atom":24}},{"Sequence":{"atoms":[30,31]}},{"Repetition":{"atom":32,"min":0,"max":null,"tag":"Repetition"}},{"Entity":{"atom":7}},{"Entity":{"atom":36}},{"Re":{"pattern":"[\\x0a]"}},{"Named":{"name":"nl","atom":35}},{"Sequence":{"atoms":[1,8,15,16,17,18,33,34,37]}},{"Repetition":{"atom":0,"min":0,"max":null,"tag":"Repetition"}}],"root":39},"bindings":[]}},"preprocess":{},"tables":{},"lint":{"order_warnings":[]},"default_entry":"main","render":{},"derive":{},"tests":[{"entry":"main","kind":"accept","input":"spring: March April May\n","expect":{}},{"entry":"main","kind":"accept","input":"winter: December\n","expect":{}},{"entry":"main","kind":"accept","input":"autumn: September, October, November\n","expect":{}},{"entry":"main","kind":"reject","input":"sprint: March\n","expect":{}},{"entry":"main","kind":"reject","input":"spring March\n","expect":{}}],"docs":{"line":"comma-or-space separated: the comma form leads the choice."},"source":"## Transform fuel: season names with their months, shaped so a tree\n## transform has real structure to walk — a season captures its name\n## and each month capture sits inside it.\ngrammar Seasons version \"1.0.0\" edition \"v2\" {\n  ws = %x20 / %x09\n  pq = *ws\n  nl = %x0A\n  alpha = %x41-5A / %x61-7A\n  season = ( %i\"spring\" / %i\"summer\" / %i\"autumn\" / %i\"winter\" ) as season\n  month = 1*alpha as month\n  ## comma-or-space separated: the comma form leads the choice.\n  line = pq season pq \":\" pq month *( ( pq \",\" pq / pq ) month ) pq nl\n  year = *( line )\n\n  entry main: year\n\n  test {\n    accept \"spring: March April May\\n\"\n    accept \"winter: December\\n\"\n    accept \"autumn: September, October, November\\n\"\n    reject \"sprint: March\\n\"\n    reject \"spring March\\n\"\n  }\n}\n","source_hash":"137d5327c6ed530decd860df468c8ca3a1aba755dce8266183cf80bec49838bd","unicode_tables":"onigmo (Ruby 3.4.8)","compiler_version":"1.3.112","edition":"v2","checksum":"sha256:bbda0b435a27b8303d17dda9e6ac29949ceccafd3d7ed918ad829d9a9c535778"}
