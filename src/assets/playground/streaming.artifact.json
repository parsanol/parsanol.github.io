{"bindings":null,"version":"1.0.0","grammar":"StreamedLog","shape":"parsanol-tree/v2","binding_version":1,"entries":{"main":{"root":"file","grammar":{"atoms":[{"Entity":{"atom":42}},{"Entity":{"atom":6}},{"Entity":{"atom":5}},{"Re":{"pattern":"[ ]"}},{"Re":{"pattern":"[\\x09]"}},{"Alternative":{"atoms":[3,4]}},{"Repetition":{"atom":2,"min":0,"max":null,"tag":"Repetition"}},{"Entity":{"atom":27}},{"Entity":{"atom":17}},{"Re":{"pattern":"[01]"}},{"Entity":{"atom":11}},{"Re":{"pattern":"[\\x30-\\x39]"}},{"Named":{"name":"digit","atom":10}},{"Sequence":{"atoms":[9,12]}},{"Str":{"pattern":"2"}},{"Re":{"pattern":"[\\x30-\\x33]"}},{"Sequence":{"atoms":[14,15]}},{"Alternative":{"atoms":[13,16]}},{"Str":{"pattern":":"}},{"Entity":{"atom":23}},{"Re":{"pattern":"[\\x30-\\x35]"}},{"Entity":{"atom":11}},{"Named":{"name":"digit","atom":21}},{"Sequence":{"atoms":[20,22]}},{"Str":{"pattern":":"}},{"Entity":{"atom":23}},{"Named":{"name":"timestamp","atom":25}},{"Sequence":{"atoms":[8,18,19,24,26]}},{"Entity":{"atom":6}},{"Entity":{"atom":34}},{"Re":{"pattern":"(?i:IN)"}},{"Re":{"pattern":"(?i:OUT)"}},{"Re":{"pattern":"(?i:ERR)"}},{"Alternative":{"atoms":[30,31,32]}},{"Named":{"name":"direction","atom":33}},{"Entity":{"atom":6}},{"Entity":{"atom":41}},{"Re":{"pattern":"[\\x01-\\x09]"}},{"Re":{"pattern":"[\\x0b-\\u{10ffff}]"}},{"Alternative":{"atoms":[37,38]}},{"Repetition":{"atom":39,"min":0,"max":null,"tag":"Repetition"}},{"Named":{"name":"payload","atom":40}},{"Sequence":{"atoms":[1,7,28,29,35,36]}},{"Entity":{"atom":44}},{"Re":{"pattern":"[\\x0a]"}},{"Sequence":{"atoms":[0,43]}},{"Repetition":{"atom":45,"min":0,"max":null,"tag":"Repetition"}},{"Entity":{"atom":42}},{"Repetition":{"atom":47,"min":0,"max":1,"tag":"Maybe"}},{"Sequence":{"atoms":[46,48]}}],"root":49},"bindings":[]}},"preprocess":{},"tables":{},"lint":{"order_warnings":[]},"default_entry":"main","render":{},"derive":{},"tests":[{"entry":"main","kind":"accept","input":"12:00:01 IN connect 1\n12:00:02 OUT ok","expect":{}},{"entry":"main","kind":"accept","input":"00:00:00 ERR start","expect":{}},{"entry":"main","kind":"reject","input":"12:00 IN x","expect":{}},{"entry":"main","kind":"reject","input":"24:00:00 IN impossible hour","expect":{}}],"docs":{"hh":"clock bounds by shape: hour 00-23, minute/second 00-59."},"source":"## Streaming: line-oriented records — the shape a chunked reader\n## replays record-at-a-time without holding the file. Each record is\n## a timestamped event; the grammar never needs more than one line.\ngrammar StreamedLog version \"1.0.0\" edition \"v2\" {\n  nl = %x0A\n  ws = %x20 / %x09\n  pq = *ws\n  digit = %x30-39\n  ## clock bounds by shape: hour 00-23, minute/second 00-59.\n  hh = %x30-31 digit / \"2\" %x30-33\n  ms = %x30-35 digit\n  ts = hh \":\" ms \":\" ms as timestamp\n  tag = ( %i\"IN\" / %i\"OUT\" / %i\"ERR\" ) as direction\n  body = *( %x01-09 / %x0B-10FFFF ) as payload\n  record = pq ts pq tag pq body\n  file = *( record nl ) [ record ]\n\n  entry main: file\n\n  test {\n    accept \"12:00:01 IN connect 1\\n12:00:02 OUT ok\"\n    accept \"00:00:00 ERR start\"\n    reject \"12:00 IN x\"\n    reject \"24:00:00 IN impossible hour\"\n  }\n}\n","source_hash":"b32b00104bb5e03e07bb610e3693bb60460ce19940d3dcb6fd473a02b26c2278","unicode_tables":"onigmo (Ruby 3.4.8)","compiler_version":"1.3.114","edition":2,"checksum":"sha256:683c6ab44d32e6b9fa82e915b8808f243eea95ca9b9a6b246c35bc03e9211f8a"}
