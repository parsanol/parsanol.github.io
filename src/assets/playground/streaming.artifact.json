{"bindings":null,"version":"1.0.0","grammar":"StreamedLog","shape":"parsanol-tree/v2","binding_version":1,"entries":{"main":{"root":"file","grammar":{"atoms":[{"Entity":{"atom":43}},{"Entity":{"atom":7}},{"Entity":{"atom":5}},{"Re":{"pattern":"[ ]"}},{"Re":{"pattern":"[\\x09]"}},{"Alternative":{"atoms":[3,4]}},{"Named":{"name":"ws","atom":2}},{"Repetition":{"atom":6,"min":0,"max":null,"tag":"Repetition"}},{"Entity":{"atom":28}},{"Entity":{"atom":18}},{"Re":{"pattern":"[01]"}},{"Entity":{"atom":12}},{"Re":{"pattern":"[\\x30-\\x39]"}},{"Named":{"name":"digit","atom":11}},{"Sequence":{"atoms":[10,13]}},{"Str":{"pattern":"2"}},{"Re":{"pattern":"[\\x30-\\x33]"}},{"Sequence":{"atoms":[15,16]}},{"Alternative":{"atoms":[14,17]}},{"Str":{"pattern":":"}},{"Entity":{"atom":24}},{"Re":{"pattern":"[\\x30-\\x35]"}},{"Entity":{"atom":12}},{"Named":{"name":"digit","atom":22}},{"Sequence":{"atoms":[21,23]}},{"Str":{"pattern":":"}},{"Entity":{"atom":24}},{"Named":{"name":"timestamp","atom":26}},{"Sequence":{"atoms":[9,19,20,25,27]}},{"Entity":{"atom":7}},{"Entity":{"atom":35}},{"Re":{"pattern":"(?i:IN)"}},{"Re":{"pattern":"(?i:OUT)"}},{"Re":{"pattern":"(?i:ERR)"}},{"Alternative":{"atoms":[31,32,33]}},{"Named":{"name":"direction","atom":34}},{"Entity":{"atom":7}},{"Entity":{"atom":42}},{"Re":{"pattern":"[\\x01-\\x09]"}},{"Re":{"pattern":"[\\x0b-\\u{10ffff}]"}},{"Alternative":{"atoms":[38,39]}},{"Repetition":{"atom":40,"min":0,"max":null,"tag":"Repetition"}},{"Named":{"name":"payload","atom":41}},{"Sequence":{"atoms":[1,8,29,30,36,37]}},{"Entity":{"atom":45}},{"Re":{"pattern":"[\\x0a]"}},{"Named":{"name":"nl","atom":44}},{"Sequence":{"atoms":[0,46]}},{"Repetition":{"atom":47,"min":0,"max":null,"tag":"Repetition"}},{"Entity":{"atom":43}},{"Repetition":{"atom":49,"min":0,"max":1,"tag":"Maybe"}},{"Sequence":{"atoms":[48,50]}}],"root":51},"bindings":[]}},"preprocess":{},"tables":{},"lint":{"order_warnings":[]},"default_entry":"main","render":{},"derive":{},"tests":[{"entry":"main","kind":"accept","input":"12:00:01 IN connect 1\n12:00:02 OUT ok","expect":{}},{"entry":"main","kind":"accept","input":"00:00:00 ERR start","expect":{}},{"entry":"main","kind":"reject","input":"12:00 IN x","expect":{}},{"entry":"main","kind":"reject","input":"24:00:00 IN impossible hour","expect":{}}],"docs":{"hh":"clock bounds by shape: hour 00-23, minute/second 00-59."},"source":"## Streaming: line-oriented records — the shape a chunked reader\n## replays record-at-a-time without holding the file. Each record is\n## a timestamped event; the grammar never needs more than one line.\ngrammar StreamedLog version \"1.0.0\" {\n  nl = %x0A\n  ws = %x20 / %x09\n  pq = *ws\n  digit = %x30-39\n  ## clock bounds by shape: hour 00-23, minute/second 00-59.\n  hh = %x30-31 digit / \"2\" %x30-33\n  ms = %x30-35 digit\n  ts = hh \":\" ms \":\" ms as timestamp\n  tag = ( %i\"IN\" / %i\"OUT\" / %i\"ERR\" ) as direction\n  body = *( %x01-09 / %x0B-10FFFF ) as payload\n  record = pq ts pq tag pq body\n  file = *( record nl ) [ record ]\n\n  entry main: file\n\n  test {\n    accept \"12:00:01 IN connect 1\\n12:00:02 OUT ok\"\n    accept \"00:00:00 ERR start\"\n    reject \"12:00 IN x\"\n    reject \"24:00:00 IN impossible hour\"\n  }\n}\n","source_hash":"bca5eb2f17c762fff5d0d36de490418609ee055ff946bdac5bc75bb214e3e7b7","unicode_tables":"onigmo (Ruby 3.4.8)","compiler_version":"1.3.110","mode":"v2","checksum":"sha256:e13b172e6350369291a0bf545eae22241bda22a9a497088672ac360d7f8d43a1"}
