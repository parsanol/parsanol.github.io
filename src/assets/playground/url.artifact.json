{"bindings":null,"version":"1.0.0","grammar":"Url","shape":"parsanol-tree/v2","binding_version":1,"entries":{"main":{"root":"url","grammar":{"atoms":[{"Entity":{"atom":13}},{"Entity":{"atom":4}},{"Re":{"pattern":"[\\x41-\\x5a]"}},{"Re":{"pattern":"[\\x61-\\x7a]"}},{"Alternative":{"atoms":[2,3]}},{"Entity":{"atom":4}},{"Entity":{"atom":7}},{"Re":{"pattern":"[\\x30-\\x39]"}},{"Re":{"pattern":"[+]"}},{"Re":{"pattern":"[\\-]"}},{"Re":{"pattern":"[.]"}},{"Alternative":{"atoms":[5,6,8,9,10]}},{"Repetition":{"atom":11,"min":0,"max":null,"tag":"Repetition"}},{"Sequence":{"atoms":[1,12]}},{"Named":{"name":"scheme","atom":0}},{"Str":{"pattern":"://"}},{"Entity":{"atom":23}},{"Entity":{"atom":22}},{"Entity":{"atom":4}},{"Entity":{"atom":7}},{"Re":{"pattern":"[\\-]"}},{"Re":{"pattern":"[.]"}},{"Alternative":{"atoms":[18,19,20,21]}},{"Repetition":{"atom":17,"min":1,"max":null,"tag":"Repetition"}},{"Named":{"name":"host","atom":16}},{"Str":{"pattern":":"}},{"Entity":{"atom":28}},{"Entity":{"atom":7}},{"Repetition":{"atom":27,"min":1,"max":null,"tag":"Repetition"}},{"Named":{"name":"port","atom":26}},{"Sequence":{"atoms":[25,29]}},{"Repetition":{"atom":30,"min":0,"max":1,"tag":"Maybe"}},{"Str":{"pattern":"/"}},{"Entity":{"atom":38}},{"Entity":{"atom":37}},{"Re":{"pattern":"[\\x21-\\x3e]"}},{"Re":{"pattern":"[\\x40-\\u{10ffff}]"}},{"Alternative":{"atoms":[35,36]}},{"Repetition":{"atom":34,"min":0,"max":null,"tag":"Repetition"}},{"Sequence":{"atoms":[32,33]}},{"Repetition":{"atom":39,"min":0,"max":1,"tag":"Maybe"}},{"Str":{"pattern":"?"}},{"Entity":{"atom":44}},{"Re":{"pattern":"[\\x21-\\u{10ffff}]"}},{"Repetition":{"atom":43,"min":0,"max":null,"tag":"Repetition"}},{"Named":{"name":"query","atom":42}},{"Sequence":{"atoms":[41,45]}},{"Repetition":{"atom":46,"min":0,"max":1,"tag":"Maybe"}},{"Sequence":{"atoms":[14,15,24,31,40,47]}}],"root":48},"bindings":[]}},"preprocess":{},"tables":{},"lint":{"order_warnings":["rule pchar: branches 1 and 2 are order-dependent (first set not statically known)"]},"default_entry":"main","render":{},"derive":{},"tests":[{"entry":"main","kind":"accept","input":"https://parsanol.org","expect":{}},{"entry":"main","kind":"accept","input":"http://localhost:4321/examples/csv","expect":{}},{"entry":"main","kind":"accept","input":"https://a.b.c/search?q=parg&page=2","expect":{}},{"entry":"main","kind":"accept","input":"ftp://files.example.org/pub/readme.txt","expect":{}},{"entry":"main","kind":"reject","input":"parsanol.org","expect":{}},{"entry":"main","kind":"reject","input":"https:///no-host","expect":{}}],"docs":{"pchar":"printable, no '?' (0x3F): the path segment."},"source":"## URLs, the common shape: scheme://host[:port][/path][?query]. The\n## classes keep each segment's terminators out of the next, so the\n## segments split deterministically.\ngrammar Url version \"1.0.0\" {\n  alpha = %x41-5A / %x61-7A\n  digit = %x30-39\n  scheme = alpha *( alpha / digit / %x2B / %x2D / %x2E )\n  hchar = alpha / digit / %x2D / %x2E\n  host = 1*hchar\n  port = 1*digit\n  ## printable, no '?' (0x3F): the path segment.\n  pchar = %x21-3E / %x40-10FFFF\n  path = *pchar\n  query = *( %x21-10FFFF )\n  url = scheme as scheme \"://\" host as host [ \":\" port as port ] [ \"/\" path ] [ \"?\" query as query ]\n\n  entry main: url\n\n  test {\n    accept \"https://parsanol.org\"\n    accept \"http://localhost:4321/examples/csv\"\n    accept \"https://a.b.c/search?q=parg&page=2\"\n    accept \"ftp://files.example.org/pub/readme.txt\"\n    reject \"parsanol.org\"\n    reject \"https:///no-host\"\n  }\n}\n","source_hash":"6cc04390dd2f15241a1de7e920dd420ef73a968fca5f1ced40e4c714eef39054","compiler_version":"1.3.109","checksum":"sha256:871a63495a7fb7ea138b171ad2d9094d902777797f997fe6a326c8967b21a605"}
