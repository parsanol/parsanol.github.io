{"bindings":null,"version":"1.0.0","grammar":"Comments","shape":"parsanol-tree/v2","binding_version":1,"entries":{"main":{"root":"line","grammar":{"atoms":[{"Entity":{"atom":17}},{"Entity":{"atom":4}},{"Re":{"pattern":"[!\"]"}},{"Re":{"pattern":"[\\x24-\\x7e]"}},{"Alternative":{"atoms":[2,3]}},{"Named":{"name":"text_char","atom":1}},{"Repetition":{"atom":5,"min":1,"max":null,"tag":"Repetition"}},{"Entity":{"atom":10}},{"Re":{"pattern":"[ ]"}},{"Re":{"pattern":"[\\x09]"}},{"Alternative":{"atoms":[8,9]}},{"Repetition":{"atom":7,"min":1,"max":null,"tag":"Repetition"}},{"Entity":{"atom":4}},{"Named":{"name":"text_char","atom":12}},{"Repetition":{"atom":13,"min":1,"max":null,"tag":"Repetition"}},{"Sequence":{"atoms":[11,14]}},{"Repetition":{"atom":15,"min":0,"max":null,"tag":"Repetition"}},{"Sequence":{"atoms":[6,16]}},{"Entity":{"atom":20}},{"Entity":{"atom":10}},{"Repetition":{"atom":19,"min":0,"max":null,"tag":"Repetition"}},{"Entity":{"atom":29}},{"Str":{"pattern":"#"}},{"Entity":{"atom":26}},{"Re":{"pattern":"[\\x01-\\x09]"}},{"Re":{"pattern":"[\\x0b-\\u{10ffff}]"}},{"Alternative":{"atoms":[24,25]}},{"Named":{"name":"nonl","atom":23}},{"Repetition":{"atom":27,"min":0,"max":null,"tag":"Repetition"}},{"Sequence":{"atoms":[22,28]}},{"Repetition":{"atom":21,"min":0,"max":1,"tag":"Maybe"}},{"Sequence":{"atoms":[0,18,30]}}],"root":31},"bindings":[]}},"preprocess":{},"tables":{},"lint":{"order_warnings":["rule nonl: branches 1 and 2 are order-dependent (first set not statically known)"]},"default_entry":"main","render":{},"derive":{},"tests":[{"entry":"main","kind":"accept","input":"hello world","expect":{}},{"entry":"main","kind":"accept","input":"x = 1 # trailing note","expect":{}},{"entry":"main","kind":"accept","input":"a#not-a-comment-boundary","expect":{}},{"entry":"main","kind":"reject","input":"","expect":{}},{"entry":"main","kind":"reject","input":"# comment-only is not text","expect":{}}],"docs":{"nonl":"any non-newline byte: the comment's body.","text_char":"printable, no space, no '#': text atoms."},"source":"## Comments: a line of text with an optional trailing '#' comment. The\n## text part is printable runs without '#'; the comment runs to end of\n## line. Demonstrates exclusion classes and optionality.\ngrammar Comments version \"1.0.0\" edition \"v2\" {\n  ws = %x20 / %x09\n  pq = *ws\n  nl = %x0A\n  ## any non-newline byte: the comment's body.\n  nonl = %x01-09 / %x0B-10FFFF\n  comment = \"#\" *nonl\n  ## printable, no space, no '#': text atoms.\n  text_char = %x21-22 / %x24-7E\n  text = 1*text_char *( 1*ws 1*text_char )\n  line = text pq [comment]\n\n  entry main: line\n\n  test {\n    accept \"hello world\"\n    accept \"x = 1 # trailing note\"\n    accept \"a#not-a-comment-boundary\"\n    reject \"\"\n    reject \"# comment-only is not text\"\n  }\n}\n","source_hash":"c7d781492364926e9fee6d1a3b5d394c00f657c1d4c3127f0ac9491d4296a855","unicode_tables":"onigmo (Ruby 3.4.8)","compiler_version":"1.3.140","edition":2,"semantics_hash":"sha256:a1928387ed0ec1213ccfa63c3738a769481e641b230928f27b2717ff9d747bab","checksum":"sha256:71ae73df78b291d9fc11acba96cfdc2a98d70f2e3353a447bc477887f89c6d34","validated":{"lint_errors":0,"lint_warnings":1,"tests_total":5,"tests_failures":0,"self_test":true},"byte_checksum":"sha256:a3ef519b942568e4c98eef2388eb662f161267b252d1f5a0b1fd5d53918a3b39"}
