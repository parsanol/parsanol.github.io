ERR start\n23:59:59 OUT done","expect":{}},{"entry":"main","kind":"reject","input":"12:00:61 IN x","expect":{}},{"entry":"main","kind":"reject","input":"IN x","expect":{}}],"docs":{},"source":"## Streaming with captures: the record grammar from the streaming\n## example, with `as` bindings — chunked readers get typed fields per\n## record without buffering the file.\ngrammar StreamedFields version \"1.0.0\" edition \"v2\" {\n  nl = %x0A\n  ws = %x20 / %x09\n  pq = *ws\n  digit = %x30-39\n  hh = %x30-31 digit / \"2\" %x30-33\n  ms = %x30-35 digit\n  ts = hh \":\" ms \":\" ms as timestamp\n  tag = ( %i\"IN\" / %i\"OUT\" / %i\"ERR\" ) as direction\n  body = *( %x01-09 / %x0B-10FFFF ) as payload\n  record = pq ts pq tag pq body\n  file = *( record nl ) [ record ]\n\n  entry main: file\n\n  test {\n    accept \"12:00:01 IN connect 1\\n\"\n    accept \"00:00:00 ERR start\\n23:59:59 OUT done\"\n    reject \"12:00:61 IN x\"\n    reject \"IN x\"\n  }\n}\n","source_hash":"5a7b3cc6ed647e82c261663460e0a3469070c86d0d2919b0799377b8bb95e56c","unicode_tables":"onigmo (Ruby 3.4.8)","compiler_version":"1.3.146","edition":2,"semantics_hash":"sha256:75d4c6cf3a727472065d379114b4234167c289778470c7ab93b07d1e5e3d1802","checksum":"sha256:a3934d28d2c135826cb110731a11c25fdb577ab133294f21a2f95424a8bb26b0","validated":{"lint_errors":0,"lint_warnings":0,"tests_total":4,"tests_failures":0,"self_test":true},"byte_checksum":"sha256:aafab3199acf37d9a18819e2b3da5500c4e9c14715359e658d1ddc6355101794"}
