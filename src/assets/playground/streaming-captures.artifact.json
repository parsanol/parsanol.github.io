{"bindings":null,"version":"1.0.0","grammar":"StreamedFields","shape":"parsanol-tree/v2","binding_version":1,"entries":{"main":{"root":"file","grammar":{"atoms":[{"Entity":{"atom":43}},{"Entity":{"atom":7}},{"Entity":{"atom":5}},{"Re":{"pattern":"[ ]"}},{"Re":{"pattern":"[\\x09]"}},{"Alternative":{"atoms":[3,4]}},{"Named":{"name":"ws","atom":2}},{"Repetition":{"atom":6,"min":0,"max":null,"tag":"Repetition"}},{"Entity":{"atom":28}},{"Entity":{"atom":18}},{"Re":{"pattern":"[01]"}},{"Entity":{"atom":12}},{"Re":{"pattern":"[\\x30-\\x39]"}},{"Named":{"name":"digit","atom":11}},{"Sequence":{"atoms":[10,13]}},{"Str":{"pattern":"2"}},{"Re":{"pattern":"[\\x30-\\x33]"}},{"Sequence":{"atoms":[15,16]}},{"Alternative":{"atoms":[14,17]}},{"Str":{"pattern":":"}},{"Entity":{"atom":24}},{"Re":{"pattern":"[\\x30-\\x35]"}},{"Entity":{"atom":12}},{"Named":{"name":"digit","atom":22}},{"Sequence":{"atoms":[21,23]}},{"Str":{"pattern":":"}},{"Entity":{"atom":24}},{"Named":{"name":"timestamp","atom":26}},{"Sequence":{"atoms":[9,19,20,25,27]}},{"Entity":{"atom":7}},{"Entity":{"atom":35}},{"Re":{"pattern":"(?i:IN)"}},{"Re":{"pattern":"(?i:OUT)"}},{"Re":{"pattern":"(?i:ERR)"}},{"Alternative":{"atoms":[31,32,33]}},{"Named":{"name":"direction","atom":34}},{"Entity":{"atom":7}},{"Entity":{"atom":42}},{"Re":{"pattern":"[\\x01-\\x09]"}},{"Re":{"pattern":"[\\x0b-\\u{10ffff}]"}},{"Alternative":{"atoms":[38,39]}},{"Repetition":{"atom":40,"min":0,"max":null,"tag":"Repetition"}},{"Named":{"name":"payload","atom":41}},{"Sequence":{"atoms":[1,8,29,30,36,37]}},{"Entity":{"atom":45}},{"Re":{"pattern":"[\\x0a]"}},{"Named":{"name":"nl","atom":44}},{"Sequence":{"atoms":[0,46]}},{"Repetition":{"atom":47,"min":0,"max":null,"tag":"Repetition"}},{"Entity":{"atom":43}},{"Repetition":{"atom":49,"min":0,"max":1,"tag":"Maybe"}},{"Sequence":{"atoms":[48,50]}}],"root":51},"bindings":[]}},"preprocess":{},"tables":{},"lint":{"order_warnings":[]},"default_entry":"main","render":{},"derive":{},"tests":[{"entry":"main","kind":"accept","input":"12:00:01 IN connect 1\n","expect":{}},{"entry":"main","kind":"accept","input":"00:00:00 ERR start\n23:59:59 OUT done","expect":{}},{"entry":"main","kind":"reject","input":"12:00:61 IN x","expect":{}},{"entry":"main","kind":"reject","input":"IN x","expect":{}}],"docs":{},"source":"## Streaming with captures: the record grammar from the streaming\n## example, with `as` bindings — chunked readers get typed fields per\n## record without buffering the file.\ngrammar StreamedFields version \"1.0.0\" {\n  nl = %x0A\n  ws = %x20 / %x09\n  pq = *ws\n  digit = %x30-39\n  hh = %x30-31 digit / \"2\" %x30-33\n  ms = %x30-35 digit\n  ts = hh \":\" ms \":\" ms as timestamp\n  tag = ( %i\"IN\" / %i\"OUT\" / %i\"ERR\" ) as direction\n  body = *( %x01-09 / %x0B-10FFFF ) as payload\n  record = pq ts pq tag pq body\n  file = *( record nl ) [ record ]\n\n  entry main: file\n\n  test {\n    accept \"12:00:01 IN connect 1\\n\"\n    accept \"00:00:00 ERR start\\n23:59:59 OUT done\"\n    reject \"12:00:61 IN x\"\n    reject \"IN x\"\n  }\n}\n","source_hash":"3a10891f9eb696438db06b53d7987e655229408e616c344b92f1060a2e71ebd0","unicode_tables":"onigmo (Ruby 3.4.8)","compiler_version":"1.3.110","mode":"v2","checksum":"sha256:769e4c6dd011ee9b569f4b6198e4552d9f7d438a3908741aae1b88f345c6f7fd"}
