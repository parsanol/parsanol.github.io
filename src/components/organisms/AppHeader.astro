---
import Icon from '../atoms/Icon.astro'

interface NavLink {
  to: string
  label: string
}

const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/'

const isActive = (to: string) => pathname === to || pathname.startsWith(to + '/')

const docsLinks: NavLink[] = [
  { to: '/introduction', label: 'Introduction' },
  { to: '/installation', label: 'Installation' },
  { to: '/first-parser', label: 'Your First Parser' },
  { to: '/parsers', label: 'Parsers' },
  { to: '/transforms', label: 'Transforms' },
  { to: '/errors', label: 'Error Handling' },
  { to: '/captures-guide', label: 'Captures & Scopes' },
  { to: '/examples', label: 'Examples' },
  { to: '/api', label: 'API Reference' },
  { to: '/architecture', label: 'Architecture' },
  { to: '/backends', label: 'Parsing Backends' },
  { to: '/feature-comparison', label: 'Feature Comparison' },
  { to: '/tutorial', label: 'Tutorial' },
]

const pargLinks: NavLink[] = [
  { to: '/parg', label: 'What is PARG?' },
  { to: '/parg/language', label: 'Language Tour' },
]

const rustLinks: NavLink[] = [
  { to: '/backends', label: 'Parsing Backends' },
  { to: '/feature-comparison', label: 'Engine Comparison' },
  { to: '/playground', label: 'Playground (WebAssembly)' },
]

const rubyLinks: NavLink[] = [
  { to: '/ruby-bindings', label: 'Ruby Bindings' },
  { to: '/tutorial', label: 'Tutorial' },
]

const simpleLinks: NavLink[] = [
  { to: '/about', label: 'About' },
]

const pargActive = pargLinks.some((l) => isActive(l.to))

const docsActive = docsLinks.some((l) => isActive(l.to))
const rustActive = rustLinks.some((l) => isActive(l.to))
const rubyActive = rubyLinks.some((l) => isActive(l.to))
---
<header id="site-header" class="sticky top-0 z-50 bg-white/80 dark:bg-gray-900/80 backdrop-blur-md border-b border-gray-200 dark:border-gray-700">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <a href="/" class="flex items-center space-x-2">
        <img src="/logo.svg" alt="Parsanol" class="header-logo" />
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden md:flex items-center space-x-1">
        <a href="/getting-started" class:list={['nav-link', { active: isActive('/getting-started') }]}>
          Get Started
        </a>

        <a href="/news" class:list={['nav-link', { active: isActive('/news') }]}>
          News
        </a>

        <!-- PARG Dropdown -->
        <div class="relative dd-wrap" data-dd>
          <button
            type="button"
            aria-haspopup="true"
            aria-expanded="false"
            class:list={['nav-link flex items-center gap-1', { active: pargActive }]}
          >
            PARG
            <Icon name="chevron-down" class="w-3 h-3 transition-transform dd-chevron" />
          </button>
          <div class="dd-panel">
            {pargLinks.map((link) => (
              <a
                href={link.to}
                class:list={[
                  'block px-4 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700',
                  { 'bg-primary-50 dark:bg-primary-900/20 text-primary-600 dark:text-primary-400': isActive(link.to) },
                ]}
              >
                {link.label}
              </a>
            ))}
          </div>
        </div>

        <!-- Learn Dropdown -->
        <div class="relative dd-wrap" data-dd>
          <button
            type="button"
            aria-haspopup="true"
            aria-expanded="false"
            class:list={['nav-link flex items-center gap-1', { active: docsActive }]}
          >
            Learn
            <Icon name="chevron-down" class="w-3 h-3 transition-transform dd-chevron" />
          </button>
          <div class="dd-panel">
            {docsLinks.map((link) => (
              <a
                href={link.to}
                class="block px-4 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700"
                class:list={[
                  'block px-4 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700',
                  { 'bg-primary-50 dark:bg-primary-900/20 text-primary-600 dark:text-primary-400': isActive(link.to) },
                ]}
              >
                {link.label}
              </a>
            ))}
          </div>
        </div>

        <!-- Rust Dropdown -->
        <div class="relative dd-wrap" data-dd>
          <button
            type="button"
            aria-haspopup="true"
            aria-expanded="false"
            class:list={['nav-link flex items-center gap-1', { active: rustActive }]}
          >
            Rust
            <Icon name="chevron-down" class="w-3 h-3 transition-transform dd-chevron" />
          </button>
          <div class="dd-panel">
            {rustLinks.map((link) => (
              <a
                href={link.to}
                class:list={[
                  'block px-4 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700',
                  { 'bg-primary-50 dark:bg-primary-900/20 text-primary-600 dark:text-primary-400': isActive(link.to) },
                ]}
              >
                {link.label}
              </a>
            ))}
          </div>
        </div>

        <!-- Ruby Dropdown -->
        <div class="relative dd-wrap" data-dd>
          <button
            type="button"
            aria-haspopup="true"
            aria-expanded="false"
            class:list={['nav-link flex items-center gap-1', { active: rubyActive }]}
          >
            Ruby
            <Icon name="chevron-down" class="w-3 h-3 transition-transform dd-chevron" />
          </button>
          <div class="dd-panel">
            {rubyLinks.map((link) => (
              <a
                href={link.to}
                class:list={[
                  'block px-4 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700',
                  { 'bg-primary-50 dark:bg-primary-900/20 text-primary-600 dark:text-primary-400': isActive(link.to) },
                ]}
              >
                {link.label}
              </a>
            ))}
          </div>
        </div>

        <!-- Simple Links -->
        {simpleLinks.map((link) => (
          <a href={link.to} class:list={['nav-link', { active: isActive(link.to) }]}>
            {link.label}
          </a>
        ))}
      </nav>

      <!-- Actions -->
      <div class="flex items-center space-x-2">
        <a
          href="https://github.com/parsanol/parsanol-rs"
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 text-gray-500 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white transition-colors"
        >
          <Icon name="github" />
        </a>
        <button
          id="theme-toggle"
          type="button"
          class="p-2 text-gray-500 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white transition-colors"
          aria-label="Toggle dark mode"
        >
          <span id="theme-icon-sun" class="hidden"><Icon name="sun" /></span>
          <span id="theme-icon-moon" class="hidden"><Icon name="moon" /></span>
        </button>

        <!-- Mobile Menu Button -->
        <button
          id="mobile-menu-button"
          type="button"
          class="md:hidden p-2 text-gray-500 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <span id="icon-menu"><Icon name="menu" /></span>
          <span id="icon-close" class="hidden"><Icon name="close" /></span>
        </button>
      </div>
    </div>

    <!-- Mobile Navigation -->
    <nav id="mobile-menu" class="hidden md:hidden py-4 border-t border-gray-200 dark:border-gray-700">
      <a href="/getting-started" class="block nav-link">
        Get Started
      </a>

      <div class="px-4 py-2 text-xs font-semibold text-gray-400 uppercase tracking-wider">PARG</div>
      {pargLinks.map((link) => (
        <a href={link.to} class="block nav-link">
          {link.label}
        </a>
      ))}

      <div class="px-4 py-2 mt-2 text-xs font-semibold text-gray-400 uppercase tracking-wider">Learn</div>
      {docsLinks.map((link) => (
        <a href={link.to} class="block nav-link">
          {link.label}
        </a>
      ))}

      <div class="px-4 py-2 mt-2 text-xs font-semibold text-gray-400 uppercase tracking-wider">Rust</div>
      {rustLinks.map((link) => (
        <a href={link.to} class="block nav-link">
          {link.label}
        </a>
      ))}

      <div class="px-4 py-2 mt-2 text-xs font-semibold text-gray-400 uppercase tracking-wider">Ruby</div>
      {rubyLinks.map((link) => (
        <a href={link.to} class="block nav-link">
          {link.label}
        </a>
      ))}

      <div class="border-t border-gray-200 dark:border-gray-700 mt-2 pt-2">
        {simpleLinks.map((link) => (
          <a href={link.to} class="block nav-link">
            {link.label}
          </a>
        ))}
      </div>
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById('site-header')

  const dropdowns = header
    ? (Array.from(header.querySelectorAll<HTMLElement>('[data-dd]')) as HTMLElement[])
    : []

  function closeAllDropdowns(except?: HTMLElement) {
    dropdowns.forEach((dd) => {
      if (dd !== except) dd.removeAttribute('data-open')
    })
  }

  dropdowns.forEach((dd) => {
    const button = dd.querySelector('button')!
    const open = () => {
      closeAllDropdowns(dd)
      dd.setAttribute('data-open', '')
      button.setAttribute('aria-expanded', 'true')
    }
    const close = () => {
      dd.removeAttribute('data-open')
      button.setAttribute('aria-expanded', 'false')
    }
    button.addEventListener('click', () => {
      if (dd.hasAttribute('data-open')) close()
      else open()
    })
    dd.addEventListener('mouseenter', open)
    dd.addEventListener('mouseleave', close)
  })

  document.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest('[data-dd]')) closeAllDropdowns()
  })

  const mobileButton = document.getElementById('mobile-menu-button')
  const mobileMenu = document.getElementById('mobile-menu')
  const iconMenu = document.getElementById('icon-menu')
  const iconClose = document.getElementById('icon-close')

  mobileButton?.addEventListener('click', () => {
    if (!mobileMenu) return
    const isOpen = !mobileMenu.classList.toggle('hidden')
    iconMenu?.classList.toggle('hidden', isOpen)
    iconClose?.classList.toggle('hidden', !isOpen)
    mobileButton.setAttribute('aria-expanded', String(isOpen))
  })

  const themeToggle = document.getElementById('theme-toggle')
  const themeIconSun = document.getElementById('theme-icon-sun')
  const themeIconMoon = document.getElementById('theme-icon-moon')

  function updateThemeIcon() {
    const isDark = document.documentElement.classList.contains('dark')
    themeIconSun?.classList.toggle('hidden', !isDark)
    themeIconMoon?.classList.toggle('hidden', isDark)
  }
  updateThemeIcon()

  themeToggle?.addEventListener('click', () => {
    document.documentElement.classList.toggle('dark')
    localStorage.setItem(
      'theme',
      document.documentElement.classList.contains('dark') ? 'dark' : 'light'
    )
    updateThemeIcon()
  })
</script>
