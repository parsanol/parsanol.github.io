---
import Button from '../atoms/Button.astro'
import Icon from '../atoms/Icon.astro'
import CodeTabs from '../molecules/CodeTabs.astro'

const demoParg = `# demo.parg
grammar Demo version "1.0.0" {
  digit = %x30-39
  number = 1*digit
  space = " "
  publisher = %i"iso" / %i"ieee"

  iso_identifier = publisher as publisher space number as number
}

entry identifier: iso_identifier`

const demoRuby = `require "parsanol"

document = Parsanol::PARG::Parser.new(File.read("demo.parg")).parse
result   = Parsanol::PARG::Compiler.compile(document)
File.write("demo.artifact.json", JSON.generate(result.envelope))

artifact = Parsanol::PARG::Artifact.load("demo.artifact.json")
artifact.parse_and_bind("identifier", "iso 12345")
# => { publisher: "iso", number: 12345 }`
---
<section class="relative overflow-hidden bg-gradient-to-b from-gray-50 to-white dark:from-gray-900 dark:to-gray-800">
  <!-- Background Pattern -->
  <div class="absolute inset-0 opacity-30 dark:opacity-10">
    <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
          <path d="M 40 0 L 0 0 0 40" fill="none" stroke="currentColor" stroke-width="0.5" class="text-gray-300 dark:text-gray-700"></path>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#grid)"></rect>
    </svg>
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 lg:py-32">
    <div class="text-center">
      <!-- Badge -->
      <div class="inline-flex items-center px-4 py-2 rounded-full bg-primary-100 dark:bg-primary-900/30 text-primary-700 dark:text-primary-300 text-sm font-medium mb-8">
        <Icon name="lightning" class="w-4 h-4 mr-2" />
        PARG: one grammar, every runtime
        <span class="mx-2 text-primary-300 dark:text-primary-700">|</span>
        <span class="text-primary-600 dark:text-primary-400 font-semibold">O(n) Guaranteed</span>
      </div>

      <!-- Headline -->
      <h1 class="text-4xl md:text-6xl font-bold text-gray-900 dark:text-white mb-6 tracking-tight">
        Build Parsers with{' '}
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary-500 via-blue-600 to-primary-600">
          Confidence
        </span>
      </h1>

      <!-- Subheadline -->
      <p class="text-lg md:text-xl text-gray-600 dark:text-gray-400 max-w-2xl mx-auto mb-10">
        Write a grammar once. Compile it to a verified, checksummed artifact. Get byte-identical
        trees and IDE-grade error recovery on every engine.
      </p>

      <!-- CTA Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-16">
        <Button href="/getting-started" variant="primary" size="lg">
          Get Started
          <Icon name="chevron-right" class="ml-2" />
        </Button>
        <Button href="/parg" variant="secondary" size="lg">
          <Icon name="book" class="mr-2" />
          Meet PARG
        </Button>
      </div>

      <!-- Quick Code Example -->
      <div class="max-w-2xl mx-auto">
        <CodeTabs
          tabs={[
            { name: 'parg', label: 'demo.parg', lang: 'parg', code: demoParg },
            { name: 'ruby', label: 'Ruby', lang: 'ruby', badge: 'ruby', code: demoRuby },
          ]}
        />
      </div>
    </div>
  </div>
</section>
