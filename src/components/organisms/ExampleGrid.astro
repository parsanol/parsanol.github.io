---
import ExampleCard from '../molecules/ExampleCard.astro'

// examples-manifest.json is generated by scripts/generate-examples.cjs from the
// parsanol-rs checkout; optional at build time (empty grid when absent).
interface ExampleItem {
  path: string
  title: string
  description?: string
  difficulty?: string
  concepts?: string[]
  tags?: string[]
  hasRust: boolean
  hasRuby: boolean
  parsletCompatible?: boolean
  category?: string
}

const manifestModules = import.meta.glob<any>('../../data/examples-manifest.json', {
  eager: true,
  import: 'default',
})
const manifest = (Object.values(manifestModules)[0] ?? []) as ExampleItem[]
const totalCount = manifest.length

const difficultyToNumber = (difficulty?: string): 1 | 2 | 3 => {
  switch (difficulty) {
    case 'beginner': return 1
    case 'advanced': return 3
    default: return 2
  }
}

const categoryLabels: Record<string, string> = {
  'expression-parsers': 'Expression Parsers',
  'data-formats': 'Data Formats',
  'urls-network': 'URLs & Network',
  'code-template': 'Code & Templates',
  'text-processing': 'Text Processing',
  'error-handling': 'Error Handling',
  'conceptual': 'Conceptual Examples',
}

const categoryDescriptions: Record<string, string> = {
  'expression-parsers': 'Parse and evaluate mathematical and logical expressions',
  'data-formats': 'Parse structured data formats like JSON, CSV, XML',
  'urls-network': 'Parse URLs, email addresses, IP addresses',
  'code-template': 'Parse programming languages and template syntax',
  'text-processing': 'Parse natural language and text structures',
  'error-handling': 'Rich error reporting and debugging techniques',
  'conceptual': 'Demonstrate specific parser concepts and patterns',
}

const categoryOrder = [
  'expression-parsers',
  'data-formats',
  'urls-network',
  'code-template',
  'text-processing',
  'error-handling',
  'conceptual',
]

const categoryColors: Record<string, [string, string]> = {
  'expression-parsers': ['bg-blue-100 dark:bg-blue-900', 'text-blue-600 dark:text-blue-400'],
  'data-formats': ['bg-green-100 dark:bg-green-900', 'text-green-600 dark:text-green-400'],
  'urls-network': ['bg-purple-100 dark:bg-purple-900', 'text-purple-600 dark:text-purple-400'],
  'code-template': ['bg-orange-100 dark:bg-orange-900', 'text-orange-600 dark:text-orange-400'],
  'text-processing': ['bg-teal-100 dark:bg-teal-900', 'text-teal-600 dark:text-teal-400'],
  'error-handling': ['bg-red-100 dark:bg-red-900', 'text-red-600 dark:text-red-400'],
  'conceptual': ['bg-yellow-100 dark:bg-yellow-900', 'text-yellow-600 dark:text-yellow-400'],
}

const categoryIcons: Record<string, string> = {
  'expression-parsers': 'M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z',
  'data-formats': 'M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4',
  'urls-network': 'M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9',
  'code-template': 'M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4',
  'text-processing': 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z',
  'error-handling': 'M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z',
  'conceptual': 'M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z',
}

const groups = categoryOrder
  .map((category) => ({
    category,
    examples: manifest
      .filter((e) => (e.category || 'conceptual') === category)
      .sort((a, b) => a.title.localeCompare(b.title)),
  }))
  .filter((g) => g.examples.length > 0)
---
<div data-example-grid data-total={totalCount}>
  <!-- Language filter -->
  <div class="flex flex-wrap items-center gap-4 mb-6">
    <span class="text-sm text-gray-500 dark:text-gray-400">Filter:</span>
    <div class="flex flex-wrap gap-2">
      <button type="button" data-filter="rust" data-filter-btn data-on class="filter-btn">
        <span class="filter-dot"></span>
        Rust
      </button>
      <button type="button" data-filter="ruby" data-filter-btn data-on class="filter-btn">
        <span class="filter-dot"></span>
        Ruby
      </button>
      <button
        type="button"
        data-filter="parslet"
        data-filter-btn
        class="filter-btn"
        title="Show only examples ported from original Parslet repository"
      >
        <span class="filter-dot"></span>
        From Parslet
      </button>
    </div>
    <span class="text-xs text-gray-400 dark:text-gray-500" data-filter-count>
      Showing {totalCount} of {totalCount} examples
    </span>
  </div>

  {groups.map(({ category, examples }) => (
    <section data-category={category} class="mb-12">
      <div class="flex items-center gap-3 mb-6">
        <div class:list={['w-10 h-10 rounded-lg flex items-center justify-center', categoryColors[category]?.[0] ?? 'bg-gray-100 dark:bg-gray-900']}>
          <svg
            class:list={['w-5 h-5', categoryColors[category]?.[1] ?? 'text-gray-600 dark:text-gray-400']}
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={categoryIcons[category] ?? 'M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z'} />
          </svg>
        </div>
        <div>
          <h2 class="text-xl font-semibold text-gray-900 dark:text-white">{categoryLabels[category] ?? category}</h2>
          <p class="text-sm text-gray-500 dark:text-gray-400">{categoryDescriptions[category] ?? 'Parser examples'}</p>
        </div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {examples.map((example) => (
          <div
            data-example-card
            data-has-rust={example.hasRust}
            data-has-ruby={example.hasRuby}
            data-parslet={String(example.parsletCompatible === true)}
          >
            <ExampleCard
              title={example.title}
              description={example.description ?? `Example demonstrating ${example.title.toLowerCase()}.`}
              difficulty={difficultyToNumber(example.difficulty)}
              concepts={example.concepts ?? example.tags}
              languages={example.hasRust && example.hasRuby ? ['rust', 'ruby'] : example.hasRuby ? ['ruby'] : ['rust']}
              to={example.path}
            />
          </div>
        ))}
      </div>
    </section>
  ))}
</div>

<script>
  const grid = document.querySelector('[data-example-grid]')

  if (grid) {
    const count = grid.querySelector<HTMLElement>('[data-filter-count]')!
    const total = Number(grid.getAttribute('data-total'))

    const state = { rust: true, ruby: true, parslet: false }
    const saved = (key: string) => localStorage.getItem(key)
    if (saved('parsanol-filter-rust') !== null) state.rust = saved('parsanol-filter-rust') === 'true'
    if (saved('parsanol-filter-ruby') !== null) state.ruby = saved('parsanol-filter-ruby') === 'true'
    if (saved('parsanol-filter-parslet') !== null) state.parslet = saved('parsanol-filter-parslet') === 'true'

    const buttons = Array.from(grid.querySelectorAll<HTMLButtonElement>('[data-filter-btn]'))

    function renderButtons() {
      buttons.forEach((btn) => {
        const key = btn.dataset.filter as keyof typeof state
        if (state[key]) btn.setAttribute('data-on', '')
        else btn.removeAttribute('data-on')
      })
    }

    function applyFilter() {
      let shown = 0
      grid!.querySelectorAll<HTMLElement>('section[data-category]').forEach((section) => {
        let sectionShown = 0
        section.querySelectorAll<HTMLElement>('[data-example-card]').forEach((card) => {
          const hasRust = card.dataset.hasRust === 'true'
          const hasRuby = card.dataset.hasRuby === 'true'
          const compat = card.dataset.parslet === 'true'
          const ok = ((state.rust && hasRust) || (state.ruby && hasRuby)) && (!state.parslet || compat)
          card.classList.toggle('hidden', !ok)
          if (ok) sectionShown++
        })
        section.classList.toggle('hidden', sectionShown === 0)
        shown += sectionShown
      })
      count.textContent = `Showing ${shown} of ${total} examples`
    }

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = btn.dataset.filter as keyof typeof state
        state[key] = !state[key]
        localStorage.setItem(`parsanol-filter-${key}`, String(state[key]))
        renderButtons()
        applyFilter()
      })
    })

    renderButtons()
    applyFilter()
  }
</script>
