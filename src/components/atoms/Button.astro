---
interface Props {
  variant?: 'primary' | 'secondary'
  size?: 'sm' | 'md' | 'lg'
  href?: string
  type?: 'button' | 'submit'
  disabled?: boolean
  class?: string
}

const {
  variant = 'primary',
  size = 'md',
  href,
  type = 'button',
  disabled = false,
  class: className,
} = Astro.props

const variantClasses = variant === 'secondary' ? 'btn-secondary' : 'btn-primary'
const sizeClasses =
  size === 'sm' ? 'text-sm px-3 py-1.5' : size === 'lg' ? 'text-lg px-6 py-3' : ''

const classes = ['btn', variantClasses, sizeClasses, disabled ? 'opacity-50 cursor-not-allowed' : '', className]
---
{href ? (
  <a href={href} class:list={classes} aria-disabled={disabled || undefined}>
    <slot />
  </a>
) : (
  <button type={type} disabled={disabled} class:list={classes}>
    <slot />
  </button>
)}
