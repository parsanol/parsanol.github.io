---
interface Tab {
  id: string
  label: string
}

interface Props {
  tabs: Tab[]
  active: string
  class?: string
}

const { tabs, active, class: className } = Astro.props
---
<div class:list={['tab-container', className]}>
  {tabs.map((tab) => (
    <button type="button" class:list={['tab-btn', { active: active === tab.id }]} data-tab={tab.id}>
      {tab.label}
    </button>
  ))}
</div>
