---
interface Props {
  variant?: 'default' | 'rust' | 'ruby' | 'python' | 'js' | 'neutral' | 'green' | 'yellow' | 'red' | 'purple'
  class?: string
}

const { variant = 'default', class: className } = Astro.props

const variantClasses: Record<string, string> = {
  rust: 'badge-rust',
  ruby: 'badge-ruby',
  python: 'badge-python',
  js: 'badge-js',
  neutral: 'badge-neutral',
  green: 'badge-green',
  yellow: 'badge-yellow',
  red: 'badge-red',
  purple: 'badge-purple',
  default: 'badge-neutral',
}
---
<span class:list={['badge', variantClasses[variant], className]}>
  <slot />
</span>
