---
interface Heading {
  level: 2 | 3
  id: string
  text: string
}

interface Props {
  headings: Heading[]
}

const { headings } = Astro.props
---

{
  headings.length >= 3 && (
    <nav class="hidden xl:block w-60 flex-shrink-0" aria-label="On this page">
      <div class="sticky top-20 max-h-[calc(100vh-6rem)] overflow-y-auto py-2">
        <h4 class="text-xs font-semibold text-gray-900 dark:text-white uppercase tracking-wider mb-3">
          On this page
        </h4>
        <ul class="space-y-0.5">
          {headings.map((h) => (
            <li>
              <a
                href={`#${h.id}`}
                data-toc-link
                class:list={[
                  'block text-sm text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-100 border-l-2 border-gray-200 dark:border-gray-700 pl-3 py-1',
                  h.level === 3 && 'pl-6 text-xs',
                ]}
              >
                {h.text}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </nav>
  )
}

<script>
  const setup = () => {
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'))
    if (!links.length) return
    const byId = new Map(links.map((l) => [decodeURIComponent(l.hash.slice(1)), l]))

    const activate = (id: string) => {
      links.forEach((l) => l.classList.remove('toc-link-active'))
      const link = byId.get(id)
      if (link) {
        link.classList.add('toc-link-active')
        link.scrollIntoView({ block: 'nearest' })
      }
    }

    const obs = new IntersectionObserver(
      (entries) => {
        const visible = entries.filter((e) => e.isIntersecting)
        if (visible.length) activate(visible[0].target.id)
      },
      { rootMargin: '-80px 0px -70% 0px' }
    )
    byId.forEach((_, id) => {
      const el = document.getElementById(id)
      if (el) obs.observe(el)
    })
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setup)
  } else {
    setup()
  }
</script>
