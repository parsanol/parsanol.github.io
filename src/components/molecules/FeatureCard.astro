---
import Icon from '../atoms/Icon.astro'

interface Link {
  href: string
  label: string
}

interface Props {
  title: string
  description: string
  icon: string
  links?: Link[]
}

const { title, description, icon, links } = Astro.props
---
<div class="feature-card flex flex-col">
  <div class="w-12 h-12 rounded-lg bg-primary-100 dark:bg-primary-900/30 flex items-center justify-center mb-4">
    <Icon name={icon} size="lg" class="text-primary-600 dark:text-primary-400" />
  </div>
  <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">
    {title}
  </h3>
  <p class="text-gray-600 dark:text-gray-400">
    {description}
  </p>
  {links && links.length > 0 && (
    <div class="mt-auto pt-4 flex flex-wrap gap-x-4 gap-y-1 text-sm">
      {links.map((link) => (
        <a href={link.href} class="text-primary-600 dark:text-primary-400 hover:underline">
          {link.label} →
        </a>
      ))}
    </div>
  )}
</div>
