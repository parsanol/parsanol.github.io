---
import CodeBlock from '../atoms/CodeBlock.astro'
import Badge from '../atoms/Badge.astro'

interface TabDef {
  name: string
  label: string
  code: string
  badge?: 'rust' | 'ruby' | 'python' | 'js'
  lang?: string
}

interface Props {
  rust?: string
  ruby?: string
  python?: string
  javascript?: string
  tabs?: TabDef[]
}

const { rust, ruby, python, javascript, tabs } = Astro.props

const tabList: TabDef[] = []
if (rust) tabList.push({ name: 'rust', label: 'Rust', code: rust, badge: 'rust' })
if (ruby) tabList.push({ name: 'ruby', label: 'Ruby', code: ruby, badge: 'ruby' })
if (python) tabList.push({ name: 'python', label: 'Python', code: python, badge: 'python' })
if (javascript) tabList.push({ name: 'javascript', label: 'JavaScript', code: javascript, badge: 'js' })
if (tabs) tabList.push(...tabs)
---
<div class="code-tabs" data-code-tabs>
  <div class="tabs">
    {tabList.map((tab, i) => (
      <button type="button" class:list={['tab-btn', { active: i === 0 }]} data-tab-name={tab.name}>
        {tab.label}
        {tab.badge && <Badge variant={tab.badge} class="ml-2">{tab.badge}</Badge>}
      </button>
    ))}
  </div>
  <div class="code-content">
    {tabList.map((tab, i) => (
      <div data-panel-name={tab.name} style={i === 0 ? undefined : 'display:none'}>
        <CodeBlock lang={tab.lang ?? tab.name} code={tab.code} />
      </div>
    ))}
  </div>
</div>

<script>
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-code-tabs] .tab-btn')
    if (!btn) return
    const root = btn.closest('[data-code-tabs]')!
    const name = btn.dataset.tabName
    root.querySelectorAll('.tab-btn').forEach((b) => b.classList.toggle('active', b === btn))
    root.querySelectorAll<HTMLElement>('[data-panel-name]').forEach((p) => {
      p.style.display = p.dataset.panelName === name ? '' : 'none'
    })
  })
</script>
