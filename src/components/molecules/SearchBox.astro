---
import Icon from '../atoms/Icon.astro'

interface Props {
  placeholder?: string
  name?: string
  value?: string
  class?: string
}

const { placeholder = 'Search documentation...', name, value, class: className } = Astro.props
---
<div class:list={['relative', className]}>
  <Icon
    name="search"
    class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"
    size="sm"
  />
  <input
    type="text"
    name={name}
    value={value}
    placeholder={placeholder}
    class="w-full pl-10 pr-4 py-2 bg-gray-100 dark:bg-gray-800 border border-transparent focus:border-primary-500 rounded-lg text-gray-900 dark:text-white placeholder-gray-500 outline-none transition-colors"
  />
</div>
