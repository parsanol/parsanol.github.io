---
import Layout from '../layouts/Layout.astro'
import DocsNav from '../components/organisms/DocsNav.astro'
import content from '../data/views/parsers.html?raw'
---
<Layout title="Parsers — Parsanol" description="The Parsanol parser combinator reference: str, re, any, sequences, alternatives, repetition, captures, lookaheads, and infix expressions.">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="flex gap-12">
      <DocsNav showSections={['parsers']} />
      <div class="flex-1 min-w-0 prose max-w-none">
        <Fragment set:html={content} />
      </div>
    </div>
  </div>
</Layout>
