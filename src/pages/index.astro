---
import Layout from '../layouts/Layout.astro'
import Hero from '../components/organisms/Hero.astro'
import FeatureCard from '../components/molecules/FeatureCard.astro'
import news from '../data/news-manifest.json'
const recent = news.slice(0, 3)

const abilities = [
  {
    icon: 'target',
    title: 'The mission: replace ABNF and ANTLR',
    body: 'Parsanol is the modern grammar language — beyond parslet, beyond SOTA. One grammar replaces ABNF for specification and ANTLR for parser generation: importable from both (:abnf, :antlr), compiled to one checksummed artifact, byte-identical trees on every engine, typed bindings as the listener/visitor replacement, PEG predictability by construction. The parslet wire shape is a migration contract, not the ceiling.',
    links: [
      { href: '/parg', label: 'Meet PARG' },
      { href: '/parg/language', label: 'Language tour' },
    ],
  },
  {
    icon: 'exclamation',
    title: 'Error recovery, by design',
    body: 'A failed parse returns the deepest real-content position, the expected set, the best partial tree — and when the grammar declares a resync policy, the exact spans consumed so parsing resumed. Deterministic across engines.',
    links: [
      { href: '/playground', label: 'Try it in the playground' },
      { href: '/errors', label: 'Diagnostics guide' },
    ],
  },
  {
    icon: 'layers',
    title: 'One grammar, every runtime',
    body: 'PARG is the grammar language: write once, compile to a checksummed parsanol-tree/v2 artifact; Ruby, Rust, WebAssembly, and the TypeScript runtime consume the same bytes and build the same tree.',
    links: [
      { href: '/parg', label: 'Meet PARG' },
      { href: '/architecture', label: 'Architecture' },
    ],
  },
  {
    icon: 'check',
    title: 'Verified identical, every day',
    body: 'A 32-artifact conformance corpus, a nightly five-engine differential fuzz — including a reference walker with every optimization switched off — and shipped-artifact audits keep "identical everywhere" an enforced property.',
    links: [{ href: '/feature-comparison', label: 'Engine comparison' }],
  },
  {
    icon: 'lightning',
    title: 'Fast where it counts',
    body: 'Packrat parsing with O(n) guarantees. On real documents the native engine parses the same grammar roughly 3.6× faster than parslet, with a bytecode VM and incremental sessions for editor-scale reparse.',
    links: [{ href: '/backends', label: 'Backends & benchmarks' }],
  },
  {
    icon: 'puzzle',
    title: 'Real-world grammar features',
    body: 'Skip/trivia injection with comment capture, atomic rules, compile-time left-recursion rewriting with precedence tiers, lookbehind guards, and runtime state atoms — the things real formats actually need.',
    links: [{ href: '/parg/language', label: 'Language tour' }],
  },
  {
    icon: 'code',
    title: 'Tooling that meets you where you are',
    body: 'A language server, a browser playground running the shipped wasm binary, and Ruby-DSL / PARG frontends feeding the same portable core. Next milestone: the compiler itself as wasm — live grammar compilation in the browser (parsanol-rs#298).',
    links: [{ href: '/playground', label: 'Open the playground' }],
  },
]
---
<Layout title="Parsanol">
  <Hero />
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <section class="mb-16">
      <h2 class="text-2xl font-semibold mb-6">SOTA, with receipts</h2>
      <div class="card p-6 mb-4">
        <p class="text-gray-600 dark:text-gray-300 mb-4">
          One grammar compiles once into a checksummed artifact that five runtimes parse
          byte-identically — enforced by a conformance corpus, nightly differentials, and a fuzzing
          gate that found a real panic on its first run. Every performance claim ships as a dated,
          reproducible receipt, and the losses publish with the same prominence as the wins.
        </p>
        <div class="grid sm:grid-cols-3 gap-4 text-sm not-prose">
          <a href="/performance" class="card hover:border-primary-400 transition block">
            <div class="font-semibold mb-1">Performance</div>
            <p class="text-gray-600 dark:text-gray-300">1.7× over ANTLR on the shared JSON corpus; the tightest diagnostics in the recovery receipt; tree-sitter's 37× throughput win published right next to it.</p>
          </a>
          <a href="/architecture" class="card hover:border-primary-400 transition block">
            <div class="font-semibold mb-1">Architecture</div>
            <p class="text-gray-600 dark:text-gray-300">The compile pipeline, the envelope anatomy (two checksums, a bake receipt, a behavior fingerprint), and the proof layer that keeps claims checkable.</p>
          </a>
          <a href="/feature-comparison" class="card hover:border-primary-400 transition block">
            <div class="font-semibold mb-1">Architecture comparison</div>
            <p class="text-gray-600 dark:text-gray-300">The 2026 matrix against tree-sitter, ANTLR 4, pest, Lark, and Lezer — with the honest column and the decision rules.</p>
          </a>
        </div>
      </div>
    </section>

    <section class="mb-16">
      <h2 class="text-2xl font-semibold mb-6">What Parsanol does today</h2>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
        {abilities.map((ability) => (
          <FeatureCard
            title={ability.title}
            description={ability.body}
            icon={ability.icon}
            links={ability.links}
          />
        ))}
      </div>
    </section>

    <section>
      <h2 class="text-2xl font-semibold mb-4">Recent News</h2>
      <div class="grid md:grid-cols-3 gap-4">
        {recent.map((p: any) => (
          <a href={`/news/${p.id}`} class="card hover:border-primary-400 transition">
            <time class="text-xs text-gray-500 mb-1" datetime={p.date}>{p.date?.slice(0, 10)}</time>
            <div class="font-semibold mb-1">{p.title}</div>
            <div class="text-sm text-gray-600 dark:text-gray-300">{p.summary}</div>
          </a>
        ))}
      </div>
    </section>
  </div>
</Layout>
