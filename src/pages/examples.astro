---
import Layout from '../layouts/Layout.astro'
import DocsNav from '../components/organisms/DocsNav.astro'
import ExampleGrid from '../components/organisms/ExampleGrid.astro'

// examples-manifest.json is generated by scripts/generate-examples.cjs from the
// parsanol-rs checkout; CI generates it before building. Optional at build time
// so a fresh clone without it still builds.
const manifestModules = import.meta.glob<any>('../data/examples-manifest.json', {
  eager: true,
  import: 'default',
})
const examplesManifest: any[] = Object.values(manifestModules)[0] ?? []
---
<Layout title="Examples — Parsanol">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="flex gap-12">
      <DocsNav showSections={['introduction']} />
      <div class="flex-1 min-w-0">
        <h1 class="text-4xl font-bold text-gray-900 dark:text-white mb-4">Examples</h1>
        <p class="text-lg text-gray-600 dark:text-gray-400 mb-8">
          Explore {examplesManifest.length} complete parser examples to learn how to use Parsanol effectively.
          Each example includes architecture diagrams, code in both Rust and Ruby, and explanations.
        </p>
        <ExampleGrid />
      </div>
    </div>
  </div>
</Layout>
