---
import Layout from '../../layouts/Layout.astro'
import news from '../../data/news-manifest.json'
import { marked } from 'marked'

export function getStaticPaths() {
  return news.map((p: any) => ({ params: { id: p.id }, props: { post: p } }))
}
const { post } = Astro.props
const html = marked.parse(post.body_md ?? '', { async: false }) as string
---
<Layout title={`${post.title} — Parsanol`} description={post.summary} active="news">
  <article class="prose max-w-none">
    <div class="text-sm text-gray-500 mb-2">{post.date?.slice(0, 10)}</div>
    <h1>{post.title}</h1>
    <p>{post.summary}</p>
    <Fragment set:html={html} />
  </article>
</Layout>
