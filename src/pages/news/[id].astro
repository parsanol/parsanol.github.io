---
import Layout from '../../layouts/Layout.astro'
import CodeBlock from '../../components/atoms/CodeBlock.astro'
import news from '../../data/news-manifest.json'
import { marked } from 'marked'

export function getStaticPaths() {
  return news.map((p: any) => ({ params: { id: p.id }, props: { post: p } }))
}
const { post } = Astro.props

// The manifest carries typed content blocks; inline markdown inside them
// (bold, code, links) is rendered with marked.
const inline = (text: string) => marked.parseInline(text ?? '', { async: false }) as string
const blocks: any[] = post.content ?? []
const sorted = news.slice().sort((a: any, b: any) => (a.date < b.date ? 1 : -1))
const idx = sorted.findIndex((n: any) => n.id === post.id)
const newer = idx > 0 ? sorted[idx - 1] : null
const older = idx >= 0 && idx < sorted.length - 1 ? sorted[idx + 1] : null
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: post.title,
  description: post.summary,
  datePublished: post.date,
}
---
<Layout title={`${post.title} — Parsanol`} description={post.summary}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <a href="/news" class="text-primary-600 dark:text-primary-400 hover:text-primary-700 text-sm inline-flex items-center gap-1 mb-6">
      ← Back to News
    </a>

    <article class="prose max-w-none">
      <time class="text-sm text-gray-500 mb-2" datetime={post.date}>{post.date?.slice(0, 10)}</time>
      <h1>{post.title}</h1>
      <p>{post.summary}</p>
      {blocks.map((block) => {
        if (block.type === 'paragraph') {
          return <Fragment set:html={marked.parse(block.text, { async: false })} />
        }
        if (block.type === 'heading') {
          return <h2 set:html={inline(block.text)} />
        }
        if (block.type === 'list') {
          return (
            <ul>
              {block.items.map((item: string) => (
                <li set:html={inline(item)} />
              ))}
            </ul>
          )
        }
        if (block.type === 'code') {
          return <CodeBlock lang={block.language || 'text'} code={block.text} />
        }
        if (block.type === 'table') {
          return (
            <table>
              <thead>
                <tr>
                  {block.headers.map((h: string) => (
                    <th set:html={inline(h)} />
                  ))}
                </tr>
              </thead>
              <tbody>
                {block.rows.map((row: string[]) => (
                  <tr>
                    {row.map((cell: string) => (
                      <td set:html={inline(cell)} />
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          )
        }
        return null
      })}
    </article>
  </div>
  {(newer || older) && (
    <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-12 text-sm">
      <div class="border-t border-gray-200 dark:border-gray-700 pt-6 flex flex-col sm:flex-row justify-between gap-4">
        {newer ? (
          <a href={`/news/${newer.id}`} class="group">
            <span class="block text-gray-500 dark:text-gray-400 mb-0.5">← Newer post</span>
            <span class="font-medium text-primary-600 dark:text-primary-400 group-hover:underline">{newer.title}</span>
          </a>
        ) : (
          <span />
        )}
        {older ? (
          <a href={`/news/${older.id}`} class="group sm:text-right">
            <span class="block text-gray-500 dark:text-gray-400 mb-0.5">Older post →</span>
            <span class="font-medium text-primary-600 dark:text-primary-400 group-hover:underline">{older.title}</span>
          </a>
        ) : (
          <span />
        )}
      </div>
    </nav>
  )}
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</Layout>
