---
import Layout from '../../layouts/Layout.astro'
import ProseWithToc from '../../components/ProseWithToc.astro'

const skeleton = `grammar Demo version "1.0.0" {
  # rules, one per line — a rule body ends at the newline
  digit = %x30-39
  number = 1*digit
}

# edition "v2" — the only edition (edition 1 was removed)
grammar Named version "1.0.0" edition "v2" {
  digit = %x30-39
  number = 1*digit
}

entry identifier: number`

const terminals = `"abc"      exact literal (case-sensitive)
%i"abc"    case-insensitive literal
%x41       one byte 0x41
%x41-5A    one byte in the range 0x41-5A
%x0D.0A    a byte sequence: 0x0D then 0x0A`

const operators = `a b        sequence (juxtaposition)
a / b      ordered choice — first match wins
[ x ]      optional (maybe)
( x )      grouping
*x         zero or more          1*x   one or more
2*4x       two to four           4x    exactly four
!x         negative lookahead    &x    positive lookahead
!<x        negative behind-guard &<x   positive behind-guard
x as name  capture — names the parse result`

const captureExample = `dash number as part    # captures "number" only
*( item ) as items     # captures the whole repeated run
*( ( item ) as each )  # names each iteration's item`

const behindExample = `emph = ( !< ALPHA "*" 1*( !star ANY ) "*" ) as emph`

const skipExample = `grammar Lml version "2.0.0" {
  skip = trivia
  trivia = 1*( ( 1*" " ) / line_comment / block_comment )
  comment = "(*" *( comment / ( !"*)" ANY ) ) "*)"
  ...
}`

const capturedTrivia = `skip = trivia capture: comments
trivia = 1*( ( 1*" " ) / line_comment / block_comment )`

const atomicExample = `atomic word = ( 1*( ALPHA ) )`

const leftRecursion = `expr = expr "*" expr
     / expr "+" expr
     / number`

const resyncParg = `grammar RecoveryResync version "1.0.0" {
  pair = ( 1*( %x61-7A / %x30-39 ) ) as k "=" ( 1*( %x30-39 ) ) as v ";"
  document = 1*( pair )

  # recovery policy: junk is any run of non-";" bytes ending at a ";"
  resync document = 1*( %x00-3A / %x3C-FF ) ";"
  entry main: document
}`

const braceExample = `## Publisher code: case-insensitive tag; raw input is captured.
publisher = {
  %i"iso" / %i"ieee"
}

## ISO-style identifier: publisher, one space, a number.
iso_identifier = { publisher as publisher space number as number }`

const coreRulesExample = `# RFC 5234 core rules are predeclared — no boilerplate:
octet_number = 2*DIGIT "." 3*DIGIT      # DIGIT, ALPHA, DQUOTE, WSP, ...
local_win = LWSP / CRLF                 # LWSP and CRLF inject as real rules
digit7 = "7"                            # a local DIGIT shadows the core rule`

const pinExamples = `accept "iso 12345"                      # the input parses
reject "iso"                            # the input does not parse
capture "ieee 42" { publisher: "ieee", number: "42" }
example "iso 12345" { publisher: "iso", number: 12345 }
shape "a b" [ { w: "a" }, { w: "b" } ]`

const styleGuide = `# short named rules; the brace form for anything that wraps
iso_identifier = { publisher space number }

# tests beside the grammar they pin
test identifier {
  accept "iso 12345"
  reject "iso"
}

# bindings beside the captures they consume
bindings iso_identifier {
  publisher -> publisher (string)
}

## doc comments ride the artifact as LSP hovers
## Serial number: digits only, no separators.
serial = 1*DIGIT`

const testsExample = `test main {
  accept "AB2020"
  reject "AB20"
  capture "AB2020" { pub: "AB" }
  shape "aab" [ { x: "a" }, { x: "a" }, { y: "b" } ]
}`

const bindingsExample = `bindings iso_identifier {
  publisher -> publisher (string)
  year -> year (integer, 0..1)
  stage -> stage (string) preprocess: stage_code
  supplement_no -> supplements[].number (integer, 0..*)
}

preprocess stage_code {
  table_lookup stages abbr -> code
  const_map "WD" -> "working-draft"
  rename sub -> supplement
}

stage_abbr = alt from_table "stages" column "abbr"`

const editionHeaders = `grammar Demo version "1.0.0" edition "v2" { ... }  # the only edition
grammar Demo version "1.0.0" edition "v1" { ... }  # ERROR: edition 1 was removed`

const editionGrammar = `grammar Pair version "1.0.0" {
  root = k sep
  k = 1*( %x61-7A ) as k
  sep = ","
  entry main: root
}`

const editionTrees = `v2  { k: "abc", sep: "," }   # sep arrives as a Named leaf`

const useExample = `# helper.parg — an import helper (no compiled artifact of its own)
grammar Helper version "1.0.0" {
  digit = %x30-39
}

# main.parg
use helper

grammar Main version "1.0.0" {
  number = 1*helper.digit as num
  entry main: number
}`

const exportExample = `$ parg export demo.artifact.json --target xgrammar
identifier_entry ::= ( ( " " ) )* ( ( ( [Ii][Ss][Oo] | [Ii][Ee][Ee][Ee] ) ) ) ...

$ parg export demo.artifact.json --target llguidance
start: identifier_entry
identifier_entry: ( ( " " ) )* ( ( ( [Ii][Ss][Oo] | [Ii][Ee][Ee][Ee] ) ) ) ...`

const renderExample = `render default {
  field stage
  literal "-"
  field code
}

derive urn "urn:{stage}:{code}"

# on the artifact, after parse_and_bind:
artifact.render("identifier", bound)        # => "ISO-42"
artifact.derive("urn", bound)               # => "urn:ISO:42"`

const sections = [
  { id: 'skeleton', label: 'Grammar skeleton' },
  { id: 'brace-form', label: 'Brace form & core rules' },
  { id: 'terminals', label: 'Terminals' },
  { id: 'operators', label: 'Operators' },
  { id: 'captures', label: 'Captures' },
  { id: 'editions', label: 'Editions' },
  { id: 'behind-guards', label: 'Behind-guards' },
  { id: 'classes', label: 'Character classes' },
  { id: 'skip', label: 'Skip & trivia' },
  { id: 'left-recursion', label: 'Left recursion' },
  { id: 'resync', label: 'Resync (recovery)' },
  { id: 'tests', label: 'In-file tests' },
  { id: 'use', label: 'Composition: use' },
  { id: 'bindings', label: 'Bindings & tables' },
  { id: 'export', label: 'Export: LLM structured output' },
  { id: 'render', label: 'Render & derive: the string side' },
  { id: 'style', label: 'Style guide' },
  { id: 'lint', label: 'The lint' },
]
---
<Layout
  title="PARG language tour — Parsanol"
  description="The PARG syntax on one page: terminals, operators, captures, skip and trivia, atomic rules, left recursion, declared resync, in-file tests, bindings and tables."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
  <div class="flex gap-12">
    <aside class="w-64 flex-shrink-0 hidden lg:block">
      <div class="sticky top-20 text-sm space-y-1">
        <a href="/parg" class="block px-3 py-1.5 rounded text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800">What is PARG?</a>
        {sections.map((section) => (
          <a href={`#` + section.id} data-toc-link class="block px-3 py-1.5 rounded text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800">{section.label}</a>
        ))}
      </div>
    </aside>

    <ProseWithToc rail={false}>
      <h1>PARG language tour</h1>
      <p class="text-lg">
        The syntax on one page, with real examples. The friendly reference is the
        <a href="https://github.com/parsanol/parsanol-ruby/blob/main/docs/parg-language-guide.md">language guide</a>;
        the <a href="https://github.com/parsanol/parsanol-ruby/blob/main/docs/parg-semantics.md">normative semantics</a>
        win where any summary disagrees.
      </p>

      <h2 id="skeleton">Grammar skeleton</h2>
      <pre class="text-sm"><code>{skeleton}</code></pre>
      <ul>
        <li><code>#</code> starts a comment to end of line; <code>##</code> is a <strong>doc comment</strong> that attaches to the following rule and ships in the artifact (LSP hovers). One rule per line (newlines are significant) — except in brace bodies, where newlines are whitespace.</li>
        <li>A case-insensitive literal (<code>%i"iso"</code>) captures the <strong>raw input form</strong>: <code>IEEE 42</code> captures <code>"IEEE"</code>, not <code>"ieee"</code>.</li>
        <li><code>grammar NAME version "X.Y.Z" {"{"}</code> wraps the rules — <code>edition "v2"</code> goes before the brace and is the only edition; <code>entry NAME: rule</code> declares an artifact entry point — multiple entries share one rule set.</li>
        <li>Keywords (<code>grammar version as bindings preprocess entry table_lookup from_table column</code>) cannot name or reference rules.</li>
      </ul>

      <h2 id="terminals">Terminals</h2>
      <pre class="text-sm"><code>{terminals}</code></pre>
      <p>String escapes: <code>\"</code>, <code>\\</code>, <code>\n</code>, <code>\t</code>, <code>\r</code>.</p>

      <h2 id="operators">Operators</h2>
      <pre class="text-sm"><code>{operators}</code></pre>
      <p>
        PEG semantics throughout: choice is <strong>ordered</strong>, repetition is greedy.
        A repetition prefix binds one primary — <code>3*(a b)</code> is three-to-four
        repetitions of the group; parenthesize composites.
      </p>

      <h2 id="captures">Captures</h2>
      <pre class="text-sm"><code>{captureExample}</code></pre>
      <p>
        Flattening follows parslet's <code>CanFlatten</code> exactly (including its
        data-loss rules for mixed repetitions) — verified byte-for-byte against parslet
        2.0.0. The stable idiom: capture every structural rule so each iteration yields one
        hash. The normative laws are V0–V4 in the semantics document.
      </p>

      <h2 id="editions">Editions</h2>
      <p>
        The grammar header declares an <strong>edition</strong> — the shape of the tree the
        compiler bakes into the artifact. Edition 2 ("named trees + spans") is
        <strong>the only edition</strong>: edition 1 was removed (parsanol-ruby 1.3.128,
        parsanol-rs 0.20.1), and a grammar requesting it fails the parse with the fix named —
        write <code>edition "v2"</code> in all grammars.
      </p>
      <pre class="text-sm"><code>{editionHeaders}</code></pre>
      <p>
        Omitting the header compiles as edition 2 as well. The pre-1.3.113 <code>mode</code>
        header keyword had already been removed (parsanol 1.3.119): a grammar using it fails
        the parse with the fix named — write <code>edition</code> in all grammars.
      </p>
      <p>
        Edition 2 is a <strong>tree-shape edition, not a syntax edition</strong>: the grammar
        text is the same apart from the header. At compile time, every rule reference that
        produces no capture is wrapped in <code>Named(rule_name)</code>, so consumers read a
        fully named tree. Rules that can only match whitespace — literal-only bodies whose
        literals all strip to empty ("glue") — are exempt and stay unnamed. Captured
        structure is untouched: capture-reachable rules compile unwrapped, so capture trees
        and values are exactly what earlier editions produced.
      </p>
      <p>With this grammar and the input <code>abc,</code>:</p>
      <pre class="text-sm"><code>{editionGrammar}</code></pre>
      <pre class="text-sm"><code>{editionTrees}</code></pre>
      <p>
        <code>k</code> was captured by <code>as k</code>; the <code>sep</code> reference
        produced no capture, so edition 2 names it as a <code>Named</code> leaf. The
        CLI prints the same leaves with their source offsets (<code>"abc"@0</code>).
      </p>
      <p>
        The compiled envelope carries <code>"edition": 2</code>. The loaders accept only the
        edition-2 spellings — the integer <code>2</code>, the quoted <code>"v2"</code> (kept
        for artifacts baked before the numeric surface), and a missing field (pre-1.3.109
        artifacts load as edition 2). An edition-1 artifact is rejected at load with the
        recompile instruction — <code>recompile the grammar with edition "v2"</code> — before
        the checksum is verified, so old artifacts fail loudly rather than parse with the
        wrong tree shape (parsanol-ruby 1.3.128, parsanol-rs 0.20.1; unknown-edition
        rejection since parsanol-ruby 1.3.115, parsanol-rs 0.19.12).
        Since parsanol 1.3.117 the envelope also carries a
        <code>semantics_hash</code> — computed over everything except producer metadata
        (<code>checksum</code>, <code>compiler_version</code>, <code>unicode_tables</code>)
        and the two digests/receipt below, so it is stable across re-bakes by a newer
        compiler and gates can compare behavior instead of bytes.
      </p>
      <p>
        Since parsanol 1.3.131 the envelope adds two checksum-covered members, both outside
        the canonical payload. <code>byte_checksum</code> stamps a SHA-256 over the exact
        file bytes (the digest's own 64-hex region zeroed), so a load can take one
        O(bytes) hash pass with no parse or canonicalization — a flipped bit, wrong file,
        or hand edit is rejected before any parse work; loaders that only see a parsed
        envelope fall back to the canonical tier unchanged. And <code>validated</code> is
        the bake receipt — <code>lint_errors</code> (always 0; the compiler refuses to emit
        with lint errors), <code>lint_warnings</code>, <code>tests_total</code> /
        <code>tests_failures</code> (the embedded tests replayed green at bake), and
        <code>self_test</code> — so "is this grammar validated" is an inspectable envelope
        field covered by both digests, not an out-of-band claim. Since parsanol 1.3.133,
        <code>parg compile --model-bindings FILE</code> embeds a versioned
        rule-to-model sidecar as additive <code>model_bindings</code> metadata
        (<code>parg bindings ARTIFACT</code> dumps it as JSON — no grammar source or class
        loading needed); artifacts compiled without a sidecar are byte-identical.
      </p>
      <p>
        Text captures are unaffected by the wrapping (ruby#400): a capture spans the rules
        it references, so a text capture over a rule assembled from lexical references —
        digits built from a digit rule — still yields the matched text. Edition 2 is purely
        additive: its tree is the capture tree plus <code>Named</code> leaves for
        non-captured references, so recompiling an edition-1 grammar changes checksums and
        requires a re-release, but capture expectations hold unchanged.
      </p>

      <h2 id="behind-guards">Behind-guards</h2>
      <pre class="text-sm"><code>{behindExample}</code></pre>
      <p>
        <code>!&lt;x</code> / <code>&amp;&lt;x</code> inspect the text <em>behind</em> the
        position and consume nothing. A character-class body (or builtin class reference)
        compiles to an end-anchored flanking match; a case-sensitive literal to a fixed
        byte window; anything else is a compile error — an arbitrary rule has no bounded
        behind-window.
      </p>

      <h2 id="brace-form">Rule bodies: the brace form</h2>
      <pre class="text-sm"><code>{braceExample}</code></pre>
      <p>
        A rule body is normally newline-terminated — one line, one rule. The <strong>brace
        form</strong> makes it self-delimiting: the body extends to the matching
        <code>&#125;</code>, and inside the braces newlines and comments are whitespace. Both
        forms compile to the same atom stream — engines never see the difference. Prefer
        the brace form for anything that wraps; the opening brace may also sit on the
        next line after the equals sign.
      </p>
      <pre class="text-sm"><code>{coreRulesExample}</code></pre>
      <p>
        The RFC 5234 core rules are predeclared in every grammar —
        <code>ALPHA BIT CHAR CR CRLF CTL DIGIT DQUOTE HEXDIG HTAB LF OCTET SP VCHAR WSP</code>
        — so grammars imported from ABNF keep their vocabulary. A local rule of the same
        name deliberately shadows the core rule (the lint flags it as style guidance).
      </p>

      <h2 id="classes">Character classes</h2>
      <p>
        A class is a hex range — <code>%x5f</code>, <code>%x21-2f</code> — or an
        alternation of ranges:
        <code>(%x21-2f / %x3a-40 / %x5b-60 / %x7b-7e)</code>.
        <code>[ … ]</code> is <strong>not</strong> a class — it is the optional form, and
        brackets whose elements are all classes fail compilation with the alternation
        spelling in the message.
      </p>

      <h2 id="skip">Skip &amp; trivia</h2>
      <pre class="text-sm"><code>{skipExample}</code></pre>
      <p>
        One declaration per grammar: an optional match of the skip rule is injected before
        every terminal, and entries take leading and trailing skips. Trivia is
        capture-free, and failures inside injected trivia never surface — deepest-failure
        positions point at real content. The skip rule must be non-nullable and may only
        reference rules; those rules (and everything they reference) build without
        injection, so recursive trivia like nested block comments work.
      </p>
      <pre class="text-sm"><code>{capturedTrivia}</code></pre>
      <p>
        <code>capture: comments</code> attaches comment-shaped trivia to the capture it
        precedes under <code>comments:</code> — comments become data without dedicated
        capture rules. Whitespace is never recorded; trailing trivia attaches to the
        enclosing entry capture.
      </p>
      <pre class="text-sm"><code>{atomicExample}</code></pre>
      <p>
        Injection happens inside repetition runs too, so <code>word = 1*( ALPHA )</code>
        under a whitespace skip matches <code>"a b"</code> as one word. Token-shaped rules
        opt out with <code>atomic</code>: the body builds without injection and matches
        contiguously.
      </p>

      <h2 id="left-recursion">Left recursion</h2>
      <pre class="text-sm"><code>{leftRecursion}</code></pre>
      <p>
        Direct left recursion is rewritten at compile time (the ANTLR 4 model) into
        left-folding precedence tiers: alternatives in source order bind tightest-first,
        non-recursive alternatives are the primary. The artifact carries ordinary atoms,
        so every engine folds identically. Indirect left recursion is a compile error.
      </p>

      <h2 id="resync">Resync (recovery)</h2>
      <pre class="text-sm"><code>{resyncParg}</code></pre>
      <p>
        A <code>resync</code> declaration is a recovery policy, not part of the match
        relation: at a failure point under <code>document</code>, the engine consumes each
        pattern match as one annotated error span and resumes iterations after it. On
        <code>parse_recovering</code> the answer carries the deepest position, the partial
        tree, and the exact spans — byte-identically on every engine. See it live in the
        <a href="/playground">playground's error-recovery grammar</a>.
      </p>

      <h2 id="tests">In-file tests</h2>
      <pre class="text-sm"><code>{pinExamples}</code></pre>
      <ul>
        <li><code>accept</code> / <code>reject</code> pin parseability.</li>
        <li><code>capture</code> pins the raw capture tree (strings compare by text).</li>
        <li><code>example</code> pins the bound attribute hash — bindings applied.</li>
        <li><code>shape</code> pins the canonical whole tree — the only phase that can observe repetition flattening and sequence merge laws.</li>
      </ul>
      <pre class="text-sm"><code>{testsExample}</code></pre>
      <p>
        Tests run at compile time (a failing test fails the build) and ride the artifact,
        so every engine replays them.
      </p>

      <h2 id="use">Composition: <code>use</code></h2>
      <pre class="text-sm"><code>{useExample}</code></pre>
      <p>
        <code>use name</code> at the top of a source file loads <code>name.parg</code>
        from the import directories and merges it at <strong>compile time</strong>: every
        imported rule is renamed <code>name.rule</code>, references inside imported rules
        are rewritten to match, and capture names are preserved. Entries, bindings,
        preprocess steps, tests, and docs merge under the same prefix
        (<code>name.entry</code>).
      </p>
      <p>
        Imports are recursive; a cycle or a missing file fails the compile. The artifact
        bakes the expansion — consumers never resolve imports, so an imported grammar's
        behavior is exactly the merged grammar's behavior. A <code>.parg</code> with no
        compiled sibling artifact is an <strong>import helper</strong>: its only contract
        is what importing grammars observe. (Semantics law I1; the conformance corpus pins
        <code>helper</code> and <code>imports</code>.)
      </p>

      <h2 id="bindings">Bindings &amp; tables</h2>
      <pre class="text-sm"><code>{bindingsExample}</code></pre>
      <p>
        Bindings map captures to typed model fields (<code>string</code>,
        <code>integer</code>, <code>float</code>, <code>boolean</code>; cardinalities
        <code>1</code>, <code>0..1</code>, <code>1..*</code>, <code>0..*</code>) with one
        array-grouping level. Preprocess steps are declarative data operations:
        <code>table_lookup</code> (v1) plus the v1.1 vocabulary — <code>const_map</code>
        (a closed mapping carried in the step itself), <code>default_when_absent</code>
        (fill a top-level nil or nil hash members), and <code>rename</code>
        (capture-name alignment, key order preserved). Using any post-v1 op stamps the
        artifact <code>binding_version: 2</code> — engines accept 1 and 2 and refuse
        higher, so a step an old engine doesn't know can never be silently mis-executed.
        <code>alt from_table</code> expands a table
        column into literal alternatives, sorted longest-first.
      </p>

      <h2 id="export">Export: LLM structured output</h2>
      <pre class="text-sm"><code>{exportExample}</code></pre>
      <p>
        <code>parg export ARTIFACT --target xgrammar</code> lowers the compiled artifact
        to a decoder-facing grammar for LLM structured output;
        <code>--target llguidance</code> emits the Lark-subset dialect. The export reads
        the <strong>artifact</strong> — the checksummed envelope, not the source — so
        every runtime lowers the same grammar to the same backend format. Constructs that
        don't map to constrained decoding are rejected loudly at export time, never
        silently dropped; the same artifact-first contract as the tree format, applied to
        a new consumer class.
      </p>

      <h2 id="render">Render &amp; derive: the string side</h2>
      <pre class="text-sm"><code>{renderExample}</code></pre>
      <p>
        Parsing has a reverse: <code>render</code> sections compose the bound map back
        into a string, and <code>derive</code> specs are named
        <code>{'{field}'}</code>-interpolation templates. Both are top-level sections
        (outside the grammar block), travel the artifact checksummed, and run through
        generic per-tier renderers — byte-identical output by construction. Fields read
        the <strong>bound</strong> map, so a <code>bindings</code> section supplies them;
        missing fields render empty. The artifact exposes
        <code>render(entry, bound)</code>, <code>render_string(entry, input)</code>,
        <code>derive(name, bound)</code>, and <code>derive_string(entry, input, name)</code>.
        (F6; verified end-to-end on parsanol 1.3.147.)
      </p>

      <h2 id="style">Style guide</h2>
      <pre class="text-sm"><code>{styleGuide}</code></pre>
      <ul>
        <li>Short named rules; the brace form for anything that wraps.</li>
        <li>Tests live beside the grammar they pin; bindings beside the captures they consume.</li>
        <li><code>##</code> doc comments on every entry-reachable rule — the artifact ships them.</li>
        <li>Grammar-wide: one rule style per file; the lints flag heavy mixing.</li>
        <li><code>parg fmt FILE</code> applies this style canonically (stdout, or in place with <code>-i</code>) — write it any way you like, ship it formatted.</li>
      </ul>

      <h2 id="lint">The lint</h2>
      <p>
        Under PEG semantics order is decisive, so the compiler runs first-set analysis on
        every alternative: shadowed branches (<code>"iso" / "iso/iec"</code>), empty
        shadowing, duplicates, and left recursion are <strong>build failures</strong>;
        order-dependent branch pairs are warnings recorded in the artifact for consumer
        CI. Foreign grammars can come in as PARG text:
        <code>Parsanol::PARG::Import.import(:abnf | :antlr | :ebnf | :pest, text)</code> — ABNF and ANTLR grammars import into PARG text, with everything the scoped importers cannot express rejected with position instead of dropped.
      </p>

      <div class="not-prose mt-10 bg-primary-50 dark:bg-primary-900/20 border border-primary-100 dark:border-primary-900/40 rounded-xl p-5">
        <p class="text-primary-900 dark:text-primary-200 font-medium">
          Next: break an input on purpose in the
          <a href="/playground" class="underline">playground</a>, or read the
          <a href="https://github.com/parsanol/parsanol-ruby/blob/main/docs/parg-semantics.md" class="underline">normative semantics</a>.
        </p>
      </div>
    </ProseWithToc>
  </div>
  </div>
</Layout>
