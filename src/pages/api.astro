---
import Layout from '../layouts/Layout.astro'
import PrevNext from '../components/PrevNext.astro'
import DocsNav from '../components/organisms/DocsNav.astro'
import content from '../data/views/api.html?raw'
---
<Layout title="API — Parsanol" description="The Parsanol API reference: atoms, combinators, transforms, errors, and the PARG artifact interfaces on every runtime.">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="flex gap-12">
      <DocsNav showSections={['docs']} />
      <div class="flex-1 min-w-0 prose max-w-none">
        <Fragment set:html={content} />
      </div>
    </div>
  </div>
  <PrevNext />
</Layout>
