---
import Layout from '../layouts/Layout.astro'
import DocsNav from '../components/organisms/DocsNav.astro'
import content from '../data/views/introduction.html?raw'
---
<Layout title="Introduction — Parsanol" description="What is Parsanol? Write a grammar once, compile it to a verified artifact, and parse identically on Ruby, Rust, WebAssembly, and TypeScript.">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="flex gap-12">
      <DocsNav showSections={['introduction']} />
      <div class="flex-1 min-w-0 prose max-w-none">
        <Fragment set:html={content} />
      </div>
    </div>
  </div>
</Layout>
