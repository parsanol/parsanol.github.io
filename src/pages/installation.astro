---
import Layout from '../layouts/Layout.astro'
import DocsNav from '../components/organisms/DocsNav.astro'
import content from '../data/views/installation.html?raw'
---
<Layout title="Installation — Parsanol" description="Install Parsanol: the Ruby gem, the parsanol-rs crate, and the @parsanol/wasm browser build, with verification steps for each.">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="flex gap-12">
      <DocsNav showSections={['introduction']} />
      <div class="flex-1 min-w-0 prose max-w-none">
        <Fragment set:html={content} />
      </div>
    </div>
  </div>
</Layout>
