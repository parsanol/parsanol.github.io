---
import Layout from '../layouts/Layout.astro'
import DocsNav from '../components/organisms/DocsNav.astro'
import content from '../data/views/transforms.html?raw'
---
<Layout title="Transforms — Parsanol" description="Transform parse trees in Parsanol: pattern matching, leaf and sequence transforms, recursive rewrites, and reusable transformers.">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="flex gap-12">
      <DocsNav showSections={['transforms']} />
      <div class="flex-1 min-w-0 prose max-w-none">
        <Fragment set:html={content} />
      </div>
    </div>
  </div>
</Layout>
