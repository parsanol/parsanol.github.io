---
import '../styles/global.css'
import AppHeader from '../components/organisms/AppHeader.astro'
import AppFooter from '../components/organisms/AppFooter.astro'

interface Props {
  title?: string
  description?: string
}
const {
  title = 'Parsanol',
  description = 'Parsanol: write one grammar, compile it to a verified artifact, and parse identically on Ruby, Rust, WebAssembly, and TypeScript.',
} = Astro.props

const canonical = new URL(Astro.url.pathname, Astro.site)
const ogImage = new URL('/web-app-manifest-512x512.png', Astro.site)
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Parsanol',
  url: Astro.site,
}
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="manifest" href="/site.webmanifest" />
  <meta property="og:site_name" content="Parsanol" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary" />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <script is:inline>
    if (localStorage.getItem('theme') === 'dark' || (!localStorage.getItem('theme') && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
      document.documentElement.classList.add('dark')
    }
  </script>
</head>
<body class="min-h-screen flex flex-col bg-gray-50 dark:bg-gray-900 text-gray-900 dark:text-gray-100 antialiased">
  <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:z-[100] focus:top-2 focus:left-2 focus:bg-white dark:focus:bg-gray-900 focus:text-primary-700 dark:focus:text-primary-300 focus:px-4 focus:py-2 focus:rounded-lg focus:shadow-lg">Skip to content</a>
  <AppHeader />
  <main id="main" class="flex-1">
    <slot />
  </main>
  <AppFooter />
</body>
</html>
